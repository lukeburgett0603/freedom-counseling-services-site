---
import { LEAD_SOURCES, REFERRAL_LEAD_SOURCES } from '../lib/leadSource';
import { EXPORT_FORM_ACTION, STATIC_EXPORT } from '../lib/exportMode';
import { getBusiness } from '../lib/pages';

interface Counselor {
  id: string;
  title: string;
}

interface Props {
  slug: string;
  heading?: string;
  collectWebsiteUrl?: boolean;
  responseTimeNote?: string | null;
  // Renders as a card (div, no full-width section/py-14) instead of a
  // standalone page section — meant to sit inside a Hero's aside slot,
  // for pages that also have the full-section form elsewhere. Never
  // remove the full-fields version entirely from a page; an embedded
  // card is a second entry point, not a replacement.
  embedded?: boolean;
  // Field set: fewer fields (no phone/message), a lower-friction ask.
  // Defaults to whatever `embedded` is, matching this component's
  // original behavior (an embedded card always used the leaner field
  // set) — pass compact explicitly to decouple the two, e.g. an
  // embedded card that still shows every field (the Hero overlay
  // style's frosted form; see CLAUDE.md's "Hero overlay style" section).
  compact?: boolean;
  // A translucent, backdrop-blurred card instead of solid white — for
  // sitting on top of a photo (the Hero overlay style). Only meaningful
  // when `embedded` is true; a full-width section wrapper (the default,
  // bottom-of-page form) isn't a "card" in the first place.
  frosted?: boolean;
  submitText?: string;
  // Multi-provider lead routing — opt-in via business.collect_counselor_preference.
  // `counselors` is derived by the caller from allPages (page_type ===
  // 'Counselor Profile'), never hand-curated here or on `business` —
  // see 0023_counselor_preference.sql.
  collectCounselorPreference?: boolean;
  counselors?: Counselor[];
  // Pre-selects this counselor instead of defaulting to "Help me choose" —
  // used on a Counselor Profile page itself, where the visitor has
  // already picked who they want by being on that page.
  defaultCounselorId?: string;
  // "Preferred Session Format" (In-Person / Telehealth) radio group —
  // opt-in via business.collect_session_format_preference, same pattern
  // as collectCounselorPreference. Neither option is pre-selected;
  // leaving both unchecked is a normal, expected "no preference" answer,
  // not a missing one — see 0039_session_format_preference.sql.
  collectSessionFormat?: boolean;
  // Cloudflare Turnstile (bot-defense widget) — opt-in via
  // business.cloudflare_turnstile_site_key, same "unset means skip it"
  // pattern as every other optional business flag threaded through this
  // component. See 0043_turnstile_site_key.sql and submit-lead's own
  // server-side verification, which is the real enforcement — this only
  // controls whether the client-side widget renders.
  turnstileSiteKey?: string | null;
  // "How did you hear about us?" — opt-in via business.collect_lead_source,
  // same pattern as collectSessionFormat. Optional to answer; "Who
  // referred you?" appears only for referral answers. Hidden on the
  // compact field set, which exists to keep friction low. See
  // 0067_lead_source_and_response_time.sql.
  collectLeadSource?: boolean;
}

const {
  slug,
  // A generic-agency leftover ("Let's talk about your project"/"Send")
  // sat here as the default for a long time — every template is supposed
  // to pass the page's own real `cta_button_text` instead (see
  // page-templates.md's "CTA heading/button text come from page data,
  // never hardcoded" rule), but a template that forgets still needs a
  // default that doesn't read as obviously wrong for any client this
  // template serves. 'Get Started' is genuinely generic in a way the old
  // default wasn't.
  heading = 'Get Started',
  collectWebsiteUrl = false,
  responseTimeNote,
  embedded = false,
  compact = embedded,
  frosted = false,
  submitText = 'Get Started',
  collectCounselorPreference = false,
  counselors = [],
  defaultCounselorId,
  collectSessionFormat = false,
  turnstileSiteKey,
  collectLeadSource = false,
} = Astro.props;

const Wrapper = embedded ? 'div' : 'section';

// Static exit export only (see src/lib/exportMode.ts): the normal form
// posts to CMC's submit-lead function, which won't exist once the practice
// has left. With a form endpoint the practice set up, render a plain HTML
// form posting there; otherwise show their phone and email instead.
const exportBusiness = STATIC_EXPORT && !EXPORT_FORM_ACTION ? await getBusiness() : null;
---

<Wrapper
  id={embedded ? undefined : 'lead-generator'}
  class:list={[
    embedded
      ? [
          'rounded-lg p-6',
          frosted ? 'border border-white/30 bg-white/70 shadow-lg backdrop-blur-md' : 'border border-black/5 bg-white shadow-md',
        ]
      : 'bg-white py-14',
  ]}
>
  <div class:list={[embedded ? '' : 'mx-auto max-w-xl px-6']}>
    <h2
      class:list={[
        'mb-4 text-center font-[family-name:var(--font-heading)] font-extrabold tracking-tight text-brand-ink',
        embedded ? 'text-lg' : 'mb-6 text-2xl',
      ]}
    >
      {heading}
    </h2>
    {!STATIC_EXPORT && (
    <form
      class="lead-form space-y-3"
      data-source-page={slug}
      data-collect-website={collectWebsiteUrl ? 'true' : 'false'}
    >
      {/*
        Honeypot: invisible to a real visitor (off-screen + aria-hidden, so
        neither a sighted user nor a screen reader ever encounters it), but
        present in the DOM for an unsophisticated bot that fills in every
        input it finds. The real enforcement is server-side in submit-lead
        (a bot calling the Edge Function directly, bypassing this form
        entirely, wouldn't be stopped by a client-only check) — this field
        just gives that check something to catch.
      */}
      <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
        <input type="text" name="hp_website" tabindex="-1" autocomplete="off" />
      </div>
      <input
        name="name"
        type="text"
        placeholder="Name"
        required
        class="w-full rounded-md border border-slate-300 px-4 py-2"
      />
      <input
        name="email"
        type="email"
        placeholder="Email"
        required
        class="w-full rounded-md border border-slate-300 px-4 py-2"
      />
      {!compact && (
        <input
          name="phone"
          type="tel"
          placeholder="Phone (optional)"
          class="w-full rounded-md border border-slate-300 px-4 py-2"
        />
      )}
      {collectWebsiteUrl && (
        <input
          name="existing_website_url"
          type="url"
          placeholder="Current website (optional — skip if you don't have one yet)"
          class="w-full rounded-md border border-slate-300 px-4 py-2"
        />
      )}
      {collectCounselorPreference && counselors.length > 0 && (
        <select
          name="preferred_counselor_page_id"
          aria-label="Select a Counselor"
          class="w-full rounded-md border border-slate-300 px-4 py-2 text-slate-700"
        >
          <option value="" selected={!defaultCounselorId}>Help me choose</option>
          {counselors.map((counselor) => (
            <option value={counselor.id} selected={counselor.id === defaultCounselorId}>
              {counselor.title}
            </option>
          ))}
        </select>
      )}
      {collectSessionFormat && (
        <div class="space-y-1.5">
          <p class="text-sm font-medium text-slate-700">Preferred session format (optional)</p>
          <div class="grid grid-cols-2 gap-2">
            <label class="flex items-center justify-center gap-2 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">
              <input type="radio" name="preferred_session_format" value="in_person" />
              In-Person
            </label>
            <label class="flex items-center justify-center gap-2 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:bg-slate-50">
              <input type="radio" name="preferred_session_format" value="telehealth" />
              Telehealth
            </label>
          </div>
        </div>
      )}
      {collectLeadSource && !compact && (
        <div class="space-y-2">
          <select
            name="lead_source"
            aria-label="How did you hear about us? (optional)"
            class="lead-source-select w-full rounded-md border border-slate-300 px-4 py-2 text-slate-700"
            data-referral-values={REFERRAL_LEAD_SOURCES.join(',')}
          >
            <option value="" selected>How did you hear about us? (optional)</option>
            {LEAD_SOURCES.map((source) => (
              <option value={source.value}>{source.label}</option>
            ))}
          </select>
          <input
            name="lead_source_detail"
            type="text"
            placeholder="Who referred you? (optional)"
            maxlength="120"
            class="lead-source-detail hidden w-full rounded-md border border-slate-300 px-4 py-2"
          />
        </div>
      )}
      {!compact && (
        <textarea
          name="message"
          placeholder="How can we help?"
          rows="4"
          class="w-full rounded-md border border-slate-300 px-4 py-2"></textarea>
      )}
      {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
      <button
        type="submit"
        class="w-full rounded-md bg-brand-accent px-6 py-3 font-semibold text-white transition hover:opacity-90 hover:shadow-md"
      >
        {submitText}
      </button>
      {responseTimeNote && <p class="text-center text-xs text-slate-500">{responseTimeNote}</p>}
      <p class="lead-form-status text-center text-sm" role="status"></p>
    </form>
    )}
    {STATIC_EXPORT && EXPORT_FORM_ACTION && (
      <form class="space-y-3" method="POST" action={EXPORT_FORM_ACTION}>
        <input name="name" type="text" placeholder="Name" required class="w-full rounded-md border border-slate-300 px-4 py-2" />
        <input name="email" type="email" placeholder="Email" required class="w-full rounded-md border border-slate-300 px-4 py-2" />
        {!compact && <input name="phone" type="tel" placeholder="Phone (optional)" class="w-full rounded-md border border-slate-300 px-4 py-2" />}
        {!compact && <textarea name="message" placeholder="How can we help?" rows="4" class="w-full rounded-md border border-slate-300 px-4 py-2"></textarea>}
        <button type="submit" class="w-full rounded-md bg-brand-accent px-6 py-3 font-semibold text-white transition hover:opacity-90 hover:shadow-md">{submitText}</button>
        {responseTimeNote && <p class="text-center text-xs text-slate-500">{responseTimeNote}</p>}
      </form>
    )}
    {exportBusiness && (
      <div class="space-y-2 text-center">
        {exportBusiness.telephone && (
          <a href={`tel:${exportBusiness.telephone}`} class="block w-full rounded-md bg-brand-accent px-6 py-3 font-semibold text-white transition hover:opacity-90">
            Call {exportBusiness.telephone}
          </a>
        )}
        {exportBusiness.email && (
          <a href={`mailto:${exportBusiness.email}`} class="block w-full rounded-md border border-slate-300 px-6 py-3 font-semibold text-brand-ink hover:bg-slate-50">
            Email {exportBusiness.email}
          </a>
        )}
        {responseTimeNote && <p class="text-xs text-slate-500">{responseTimeNote}</p>}
      </div>
    )}
  </div>
</Wrapper>

{!STATIC_EXPORT && (
<script>
  // A direct REST call instead of importing @supabase/supabase-js here:
  // the full SDK adds ~200KB of JS to every single page (this component can
  // appear more than once per page now), which drags down Core Web Vitals
  // sitewide for what's still just a one-line insert per submit.
  //
  // Class-based, not id-based: a page can have more than one LeadGenerator
  // (e.g. a compact one in the Hero plus the full one further down) — using
  // getElementById would only ever wire up the first form on the page.
  import { readStoredAttribution } from '../lib/adAttribution';

  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  // Cloudflare Turnstile's script does implicit auto-rendering of every
  // .cf-turnstile element on the page once loaded, so it only needs
  // loading once even though this component (and its .cf-turnstile div)
  // can appear more than once per page — guarded here rather than in the
  // markup so a page with two LeadGenerator instances doesn't inject the
  // script twice, which would otherwise try to double-render each widget.
  if (document.querySelector('.cf-turnstile') && !document.querySelector('script[src*="challenges.cloudflare.com/turnstile"]')) {
    const turnstileScript = document.createElement('script');
    turnstileScript.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    turnstileScript.async = true;
    turnstileScript.defer = true;
    document.head.appendChild(turnstileScript);
  }

  document.querySelectorAll<HTMLFormElement>('.lead-form').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.lead-form-status');

    // Show "Who referred you?" only for referral answers.
    const sourceSelect = form.querySelector<HTMLSelectElement>('.lead-source-select');
    const sourceDetail = form.querySelector<HTMLInputElement>('.lead-source-detail');
    if (sourceSelect && sourceDetail) {
      const referralValues = (sourceSelect.dataset.referralValues ?? '').split(',');
      sourceSelect.addEventListener('change', () => {
        const isReferral = referralValues.includes(sourceSelect.value);
        sourceDetail.classList.toggle('hidden', !isReferral);
        if (!isReferral) sourceDetail.value = '';
      });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status) return;
      const formData = new FormData(form);
      status.textContent = 'Sending...';

      const payload: Record<string, unknown> = {
        name: formData.get('name'),
        email: formData.get('email'),
        phone: formData.get('phone') || null,
        message: formData.get('message') || null,
        source_page: form.dataset.sourcePage,
        // Honeypot — empty for a real visitor (the field is invisible to
        // them), filled in by an unsophisticated bot. submit-lead is what
        // actually acts on this; see the field's own comment in the
        // markup above for why enforcement can't live only here.
        hp_website: formData.get('hp_website') || '',
        // Present only when this instance rendered the Turnstile widget
        // (Cloudflare's script inserts this hidden input itself inside
        // the .cf-turnstile div) — null when Turnstile isn't configured
        // for this client, which submit-lead treats as "skip the check."
        turnstile_token: formData.get('cf-turnstile-response') || null,
      };
      if (form.dataset.collectWebsite === 'true') {
        payload.existing_website_url = formData.get('existing_website_url') || null;
      }
      if (form.querySelector('[name="preferred_counselor_page_id"]')) {
        payload.preferred_counselor_page_id = formData.get('preferred_counselor_page_id') || null;
      }
      if (form.querySelector('[name="preferred_session_format"]')) {
        payload.preferred_session_format = formData.get('preferred_session_format') || null;
      }
      // Google Ads click ID / UTM tags remembered from the visitor's landing
      // URL (AdAttributionCapture in BaseLayout). First-party only.
      const attribution = readStoredAttribution();
      if (attribution) payload.attribution = attribution;
      if (sourceSelect) {
        payload.lead_source = formData.get('lead_source') || null;
        payload.lead_source_detail = formData.get('lead_source_detail') || null;
      }

      const response = await fetch(`${SUPABASE_URL}/functions/v1/submit-lead`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          apikey: SUPABASE_ANON_KEY,
          Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
        },
        body: JSON.stringify(payload),
      });

      status.textContent = response.ok
        ? 'Thanks! We’ll be in touch soon.'
        : 'Something went wrong. Please try again.';
      if (response.ok) {
        form.reset();
        sourceDetail?.classList.add('hidden');
      }
    });
  });
</script>
)}
