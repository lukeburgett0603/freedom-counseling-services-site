---
import { withBase } from '../lib/url';

interface Props {
  heading: string;
  // Optional short paragraph between the heading and the button — e.g.
  // Homepage's closing CTA uses this to carry a brief "why it's worth
  // acting now" reminder now that storybrand_failure no longer renders
  // as its own standalone section. Omitted by every other existing call
  // site, which keeps their current no-subheading appearance unchanged.
  subheading?: string | null;
  buttonText?: string;
  href?: string;
  // Optional — when set, a click on the button logs a best-effort,
  // fire-and-forget row to page_cta_clicks for the admin blog analytics
  // screen (see CLAUDE.md's "Blog analytics" section). Currently only
  // threaded through from BlogPost.astro, where a post's own performance
  // is actually being measured — every other template simply omits this
  // and the button behaves exactly as it always has, untracked.
  pageId?: string;
  // 'band' (default) is the full-bleed section used at the bottom of
  // every page. 'sidebar' is a compact card for BlogPost.astro's sticky
  // sidebar (see CLAUDE.md's "Blog sidebar CTA" section) — same copy
  // fields, same click-tracking script below (already multi-instance-
  // safe via querySelectorAll, so rendering CTA.astro twice on one page
  // — band + sidebar — needs no changes there), just a smaller card
  // instead of a full-bleed band, so a reader never sees two near-
  // identical full CTAs stacked on the same screen.
  variant?: 'band' | 'sidebar';
  // Lets a caller target this exact instance (e.g. BlogPost.astro's
  // IntersectionObserver watching for when the bottom band scrolls into
  // view, to hide the sidebar CTA at that point) — optional since no
  // other call site needs to address a specific instance.
  id?: string;
}

const {
  heading,
  subheading,
  buttonText = 'Contact Us',
  href = withBase('/contact'),
  pageId,
  variant = 'band',
  id,
} = Astro.props;
import { STATIC_EXPORT } from '../lib/exportMode';
---

{variant === 'sidebar' ? (
  <div id={id} class="rounded-xl bg-brand-primary p-6 text-white shadow-md">
    <h2 class="font-[family-name:var(--font-heading)] text-lg font-bold">{heading}</h2>
    {subheading && <p class="mt-2 text-sm text-white/90">{subheading}</p>}
    <a
      href={href}
      class="cta-button mt-4 block rounded-md bg-white px-4 py-2 text-center text-sm font-semibold text-brand-primary transition hover:bg-brand-neutral hover:shadow-md"
      data-page-id={pageId}
    >
      {buttonText}
    </a>
  </div>
) : (
  <section id={id} class="bg-brand-primary py-16 text-center text-white">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="font-[family-name:var(--font-heading)] text-2xl font-extrabold tracking-tight md:text-3xl">{heading}</h2>
      {subheading && <p class="mt-3 text-white/90">{subheading}</p>}
      <a
        href={href}
        class="cta-button mt-6 inline-block rounded-md bg-white px-6 py-3 font-semibold text-brand-primary transition hover:bg-brand-neutral hover:shadow-md"
        data-page-id={pageId}
      >
        {buttonText}
      </a>
    </div>
  </section>
)}

{pageId && !STATIC_EXPORT && (
  <script>
    // Class selector + querySelectorAll, not an id — this component can
    // render more than once per page in principle, same discipline as
    // LeadGenerator.astro (see CLAUDE.md's real-bugs list). Fire-and-
    // forget: a failed insert never blocks or affects the actual link
    // navigation, and nothing here is sensitive enough to need retry
    // logic — a missed click just under-counts by one.
    const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
    const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

    document.querySelectorAll<HTMLAnchorElement>('.cta-button[data-page-id]').forEach((link) => {
      link.addEventListener('click', () => {
        const pageId = link.dataset.pageId;
        if (!pageId) return;
        fetch(`${SUPABASE_URL}/rest/v1/page_cta_clicks`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            apikey: SUPABASE_ANON_KEY,
            Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
            Prefer: 'return=minimal',
          },
          body: JSON.stringify({ page_id: pageId }),
          keepalive: true,
        }).catch(() => {
          // Swallow — see comment above.
        });
      });
    });
  </script>
)}
