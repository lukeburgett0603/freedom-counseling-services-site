---
// A tinted band for one central statement (Freedom: "Faith at the
// center. Never forced."): big heading left, body right. At most one per
// page (theme lock: tints stay in the page's own color family).
import { renderCopy } from '../../lib/markdown';
import { withBase } from '../../lib/url';
import Ph from './Ph.astro';

interface Props {
  heading: string;
  body: string; // markdown
  link?: { label: string; href: string };
}

const { heading, body, link } = Astro.props;
---

{heading && (
  <section class="s-section s-band sb">
    <div class="s-wrap sb-grid s-reveal">
      <h2>{heading}</h2>
      <div>
        <div class="s-rich" set:html={renderCopy(body)} />
        {link?.label && <a class="s-link sb-link" href={/^\/(?!\/)/.test(link.href) ? withBase(link.href) : link.href}>{link.label} <Ph name="arrow-right" /></a>}
      </div>
    </div>
  </section>
)}

<style>
  .sb { background: var(--accent-tint); }
  .sb-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 56px; align-items: start; }
  h2 { font-size: clamp(2rem, 3.4vw, 3rem); font-weight: 800; color: var(--accent-strong); }
  .sb-link { margin-top: 22px; }
  @media (max-width: 1023px) { .sb-grid { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
</style>
