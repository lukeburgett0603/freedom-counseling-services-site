---
// The article library: every article, filterable by topic. Topics are
// the service pages (hub and spoke: each service page is a category hub,
// each article a spoke tied to one hub through `category`). Works
// without JavaScript (everything shows); with it, the topic buttons
// filter in place and the choice is kept in the address (?topic=slug),
// so a service page can link straight to its own articles.
import Ph from './Ph.astro';

interface Topic { slug: string; label: string; count: number }
interface Article { title: string; text?: string; href: string; author?: string; topic?: string; topicLabel?: string }

interface Props {
  topics: Topic[];
  articles: Article[];
}

const { topics, articles } = Astro.props;
---

<section class="s-section al" data-library>
  <div class="s-wrap">
    <div class="al-filter" role="group" aria-label="Filter articles by topic">
      <button type="button" class="al-chip" aria-pressed="true" data-topic="">All articles <span>{articles.length}</span></button>
      {topics.map((t) => <button type="button" class="al-chip" aria-pressed="false" data-topic={t.slug}>{t.label} <span>{t.count}</span></button>)}
    </div>
    <p class="al-count" aria-live="polite"></p>
    <ul class="al-list">
      {articles.map((a) => (
        <li data-topic={a.topic ?? ''}>
          <a href={a.href}>
            <span class="al-meta">{a.topicLabel}{a.topicLabel && a.author && ' · '}{a.author}</span>
            <strong>{a.title}</strong>
            {a.text && <span class="al-text">{a.text}</span>}
            <span class="al-read">Read the article <Ph name="arrow-right" /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .al { padding-top: 0; }
  .al-filter { display: flex; flex-wrap: wrap; gap: 10px; }
  .al-chip { font: inherit; font-size: 0.95rem; font-weight: 600; padding: 9px 16px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; display: inline-flex; gap: 8px; align-items: center; }
  .al-chip span { font-weight: 500; color: var(--muted); font-size: 0.85rem; }
  .al-chip[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .al-chip[aria-pressed='true'] span { color: color-mix(in srgb, var(--accent-ink) 80%, transparent); }
  .al-count { margin-top: 18px; color: var(--muted); font-size: 0.95rem; min-height: 1.4em; }
  .al-list { list-style: none; padding: 0; margin-top: 12px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .al-list li[hidden] { display: none; }
  .al-list a { height: 100%; display: grid; gap: 8px; align-content: start; padding: 22px 24px; background: var(--surface); border-radius: var(--radius-card); box-shadow: var(--shadow); text-decoration: none; transition: transform 0.2s; }
  .al-list a:hover { transform: translateY(-2px); }
  .al-meta { font-size: 0.82rem; font-weight: 600; color: var(--accent); }
  strong { font-size: 1.15rem; line-height: 1.3; }
  .al-text { color: var(--muted); font-size: 0.95rem; line-height: 1.5; }
  .al-read { display: inline-flex; gap: 6px; align-items: center; font-weight: 600; font-size: 0.92rem; margin-top: 4px; }
  @media (max-width: 767px) { .al-list { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-library]').forEach((lib) => {
    const chips = [...lib.querySelectorAll<HTMLButtonElement>('.al-chip')];
    const items = [...lib.querySelectorAll<HTMLElement>('.al-list li')];
    const count = lib.querySelector<HTMLElement>('.al-count')!;
    const show = (topic: string, push: boolean) => {
      if (topic && !chips.some((c) => c.dataset.topic === topic)) topic = '';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.topic === topic)));
      let n = 0;
      items.forEach((li) => { const on = !topic || li.dataset.topic === topic; li.hidden = !on; if (on) n++; });
      const label = chips.find((c) => c.dataset.topic === topic)?.firstChild?.textContent?.trim();
      count.textContent = topic ? `${n} article${n === 1 ? '' : 's'} on ${label?.toLowerCase()}` : '';
      if (push) {
        const url = new URL(location.href);
        if (topic) url.searchParams.set('topic', topic); else url.searchParams.delete('topic');
        history.replaceState(null, '', url);
      }
    };
    chips.forEach((c) => c.addEventListener('click', () => show(c.dataset.topic ?? '', true)));
    show(new URLSearchParams(location.search).get('topic') ?? '', false);
  });
</script>
