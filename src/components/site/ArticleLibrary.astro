---
// The article library: every article, filterable by topic. Topics are
// the service pages (hub and spoke: each service page is a category hub,
// each article a spoke tied to one hub through `category`). Works
// without JavaScript (everything shows); with it, the topic buttons
// filter in place and the choice is kept in the address (?topic=slug),
// so a service page can link straight to its own articles.
// The featured article sits above the filter while "All articles" is
// chosen (and isn't repeated in the grid); choosing a topic hides it and
// shows every matching article, the featured one included.
// Four cards across on desktop (two on tablets, one on phones), and 20
// per page: past 20, page links appear and the page is kept in the
// address (?page=2) along with the topic.
// A search box ranks articles by how well they match (title first, then
// topic, then summary, headings, and opening), understands everyday
// words ("marriage" finds couples articles, "worried" finds anxiety),
// and forgives small typos and partial words. The search is kept in the
// address too (?q=...).
import { Image } from 'astro:assets';
import Ph from './Ph.astro';
import { withBase } from '../../lib/url';

interface Topic { slug: string; label: string; count: number }
interface Article { title: string; text?: string; href: string; author?: string; topic?: string; topicLabel?: string; slug?: string; date?: string; image?: { url: string; alt: string }; search?: string }

interface Props {
  topics: Topic[];
  articles: Article[];
  featured?: string;
  perPage?: number;
}

const { topics, articles, featured, perPage = 20 } = Astro.props;
const lead = featured ? articles.find((a) => a.slug === featured) : undefined;
const fmtDate = (d?: string) => d ? new Date(`${d.slice(0, 10)}T12:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : undefined;
---

<section class="s-section al" data-library data-per-page={perPage}>
  <div class="s-wrap">
    {lead && (
      <a class="al-feature" href={lead.href} data-featured>
        {lead.image && (
          <div class="al-feature-img">
            <Image src={lead.image.url} alt={lead.image.alt} inferSize widths={[480, 720, 960]} sizes="(max-width: 767px) 100vw, 560px" loading="eager" />
          </div>
        )}
        <div class="al-feature-body">
          <span class="al-badge">Featured article</span>
          <span class="al-meta">{lead.topicLabel}{lead.topicLabel && lead.author && ' · '}{lead.author}</span>
          <strong class="al-feature-title">{lead.title}</strong>
          {lead.text && <span class="al-text">{lead.text}</span>}
          {fmtDate(lead.date) && <span class="al-date">{fmtDate(lead.date)}</span>}
          <span class="al-read">Read the article <Ph name="arrow-right" /></span>
        </div>
      </a>
    )}
    <form class="al-search" role="search" onsubmit="return false">
      <label for="al-q" class="al-search-label">Search articles</label>
      <div class="al-search-box">
        <Ph name="magnifying-glass" />
        <input id="al-q" type="search" name="q" autocomplete="off" placeholder="Try a word or question, like “worry,” “marriage,” or “grief”" />
        <button type="button" class="al-clear" aria-label="Clear search" hidden>Clear</button>
      </div>
    </form>
    <div class="al-filter" role="group" aria-label="Filter articles by topic">
      <button type="button" class="al-chip" aria-pressed="true" data-topic="">All articles <span>{articles.length}</span></button>
      {topics.map((t) => <button type="button" class="al-chip" aria-pressed="false" data-topic={t.slug}>{t.label} <span>{t.count}</span></button>)}
    </div>
    <p class="al-count" aria-live="polite"></p>
    <div class="al-empty" hidden>
      <p><strong>No articles match that yet.</strong> Try a broader word, choose a topic above, or <a href={withBase('/contact')}>ask us directly</a>. We're glad to point you in the right direction.</p>
    </div>
    <ul class="al-list">
      {articles.map((a) => (
        <li data-topic={a.topic ?? ''} data-title={a.title.toLowerCase()} data-topic-label={(a.topicLabel ?? '').toLowerCase()} data-search={a.search ?? ''} data-lead={lead && a.slug === lead.slug ? '' : undefined} hidden={!!lead && a.slug === lead.slug}>
          <a href={a.href}>
            {a.image && (
              <div class="al-img">
                <Image src={a.image.url} alt={a.image.alt} inferSize widths={[320, 480, 640]} sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 300px" loading="lazy" />
              </div>
            )}
            <span class="al-meta">{a.topicLabel}{a.topicLabel && a.author && ' · '}{a.author}</span>
            <strong>{a.title}</strong>
            {a.text && <span class="al-text">{a.text}</span>}
            <span class="al-read">Read the article <Ph name="arrow-right" /></span>
          </a>
        </li>
      ))}
    </ul>
    <nav class="al-pages" aria-label="Article pages" hidden></nav>
  </div>
</section>

<style>
  .al { padding-top: 0; }
  .al-filter { display: flex; flex-wrap: wrap; gap: 10px; }
  .al-chip { font: inherit; font-size: 0.95rem; font-weight: 600; padding: 9px 16px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; display: inline-flex; gap: 8px; align-items: center; }
  .al-chip span { font-weight: 500; color: var(--muted); font-size: 0.85rem; }
  .al-chip[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .al-chip[aria-pressed='true'] span { color: color-mix(in srgb, var(--accent-ink) 80%, transparent); }
  .al-search { margin-bottom: 18px; max-width: 640px; }
  .al-search-label { display: block; font-weight: 700; margin-bottom: 8px; }
  .al-search-box { display: flex; align-items: center; gap: 10px; padding: 0 8px 0 16px; background: var(--surface); border: 1.5px solid var(--line); border-radius: 999px; }
  .al-search-box:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent); }
  .al-search-box input { flex: 1; min-width: 0; font: inherit; font-size: 1rem; padding: 13px 0; border: 0; background: transparent; color: var(--ink); outline: none; }
  .al-search-box input::-webkit-search-cancel-button { display: none; }
  .al-clear { font: inherit; font-size: 0.9rem; font-weight: 600; border: 0; background: transparent; color: var(--accent); cursor: pointer; padding: 8px 10px; }
  .al-clear[hidden], .al-empty[hidden] { display: none; }
  .al-empty { margin-top: 12px; padding: 22px 24px; background: var(--surface); border-radius: var(--radius-card); box-shadow: var(--shadow); max-width: 640px; }
  .al-count { margin-top: 18px; color: var(--muted); font-size: 0.95rem; min-height: 1.4em; }
  .al-list { list-style: none; padding: 0; margin-top: 12px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .al-list li[hidden] { display: none; }
  .al-list a { height: 100%; display: grid; gap: 8px; align-content: start; padding: 0 20px 20px; background: var(--surface); border-radius: var(--radius-card); box-shadow: var(--shadow); text-decoration: none; transition: transform 0.2s; overflow: hidden; }
  .al-list a > :first-child:not(.al-img) { margin-top: 20px; }
  .al-img { margin: 0 -20px 6px; aspect-ratio: 16 / 9; background: var(--tint); overflow: hidden; }
  .al-img img, .al-feature-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .al-feature { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); margin-bottom: 36px; background: var(--surface); border-radius: var(--radius-card); box-shadow: var(--shadow); overflow: hidden; text-decoration: none; transition: transform 0.2s; }
  .al-feature:hover { transform: translateY(-2px); }
  .al-feature[hidden] { display: none; }
  .al-feature-img { min-height: 300px; background: var(--tint); }
  .al-feature-body { display: grid; gap: 10px; align-content: center; padding: 32px 36px; }
  .al-badge { justify-self: start; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-ink); background: var(--accent); padding: 5px 10px; border-radius: 999px; }
  .al-feature-title { font-size: clamp(1.4rem, 2.4vw, 1.9rem); line-height: 1.2; }
  .al-date { color: var(--muted); font-size: 0.88rem; }
  .al-list a:hover { transform: translateY(-2px); }
  .al-meta { font-size: 0.82rem; font-weight: 600; color: var(--accent); }
  strong { font-size: 1.05rem; line-height: 1.3; }
  .al-text { color: var(--muted); font-size: 0.9rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .al-feature .al-text { -webkit-line-clamp: unset; display: block; font-size: 0.98rem; }
  .al-pages { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 28px; }
  .al-pages[hidden] { display: none; }
  .al-pages button { font: inherit; font-weight: 600; min-width: 44px; height: 44px; padding: 0 14px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--surface); color: var(--ink); cursor: pointer; }
  .al-pages button[aria-current='page'] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .al-pages button:disabled { opacity: 0.4; cursor: default; }
  @media (max-width: 1023px) { .al-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .al-read { display: inline-flex; gap: 6px; align-items: center; font-weight: 600; font-size: 0.92rem; margin-top: 4px; }
  @media (max-width: 767px) {
    .al-list { grid-template-columns: minmax(0, 1fr); }
    .al-feature { grid-template-columns: minmax(0, 1fr); }
    .al-feature-img { min-height: 0; aspect-ratio: 16 / 9; }
    .al-feature-body { padding: 22px 24px 26px; }
  }
</style>

<script>
  // Everyday words people search, mapped to the words articles use.
  const SYNONYMS: Record<string, string[]> = {
    marriage: ['couple', 'marriage', 'spouse'], married: ['couple', 'marriage'], husband: ['couple', 'marriage'], wife: ['couple', 'marriage'], spouse: ['couple', 'marriage'], relationship: ['couple', 'relationship'], partner: ['couple'],
    fight: ['fight', 'repair', 'conflict'], argue: ['fight', 'repair', 'conflict'], argument: ['fight', 'repair', 'conflict'], conflict: ['conflict', 'fight', 'repair'],
    worry: ['anxiety', 'worry'], worried: ['anxiety', 'worry'], nervous: ['anxiety'], panic: ['anxiety', 'panic'], stress: ['stress', 'anxiety'], stressed: ['stress', 'anxiety'], overwhelmed: ['anxiety', 'stress'], anxious: ['anxiety'],
    sad: ['depression', 'grief'], sadness: ['depression', 'grief'], depressed: ['depression'], hopeless: ['depression'], down: ['depression'], numb: ['numb', 'grief'],
    loss: ['grief', 'loss'], lost: ['grief', 'loss'], death: ['grief', 'death'], died: ['grief', 'death'], dying: ['grief'], mourning: ['grief'], grieving: ['grief'], bereavement: ['grief'],
    kid: ['child', 'teen'], kids: ['child', 'teen'], children: ['child'], son: ['child', 'teen'], daughter: ['child', 'teen'], teenager: ['teen'], adolescent: ['teen'], parenting: ['child', 'teen', 'parent'],
    god: ['god', 'faith', 'christian'], faith: ['faith', 'christian', 'god'], church: ['church', 'faith', 'christian'], jesus: ['faith', 'christian'], bible: ['scripture', 'faith', 'christian'], prayer: ['faith', 'pray'], spiritual: ['faith', 'christian'],
    ptsd: ['trauma', 'emdr'], abuse: ['trauma'], flashback: ['trauma', 'emdr'], trauma: ['trauma', 'emdr'],
    intrusive: ['ocd', 'intrusive'], obsessive: ['ocd'], compulsive: ['ocd'], scrupulosity: ['ocd', 'scrupulosity'], erp: ['erp', 'ocd'],
    porn: ['porn'], pornography: ['porn'], pastor: ['pastor', 'ministry'], ministry: ['pastor', 'ministry'],
  };
  const STOP = new Set('a an and are as at be but by can do does for from how i if in is it its me my of on or our so that the their them they this to was what when where who why will with you your im ive dont'.split(' '));
  const stem = (w: string) => w.replace(/(ing|ed|es|s|ly)$/, '').replace(/(.)\1$/, '$1') || w;
  const words = (t: string) => t.toLowerCase().normalize('NFKD').replace(/[^a-z0-9\s]/g, ' ').split(/\s+/).filter((w) => w && !STOP.has(w));
  const near = (a: string, b: string) => {
    // True when one letter is added, removed, or changed, or two
    // neighboring letters are swapped (a small typo).
    if (Math.abs(a.length - b.length) > 1) return false;
    if (a.length === b.length) {
      const diff = [...a].map((c, k) => (c === b[k] ? -1 : k)).filter((k) => k >= 0);
      if (diff.length === 2 && diff[1] === diff[0] + 1 && a[diff[0]] === b[diff[1]] && a[diff[1]] === b[diff[0]]) return true;
    }
    let i = 0, j = 0, edits = 0;
    while (i < a.length && j < b.length) {
      if (a[i] === b[j]) { i++; j++; continue; }
      if (++edits > 1) return false;
      if (a.length > b.length) i++; else if (b.length > a.length) j++; else { i++; j++; }
    }
    return edits + (a.length - i) + (b.length - j) <= 1;
  };
  const hits = (term: string, list: string[]) => {
    let best = 0;
    for (const w of list) {
      if (w === term) return 1;
      if (term.length >= 3 && w.startsWith(term)) best = Math.max(best, 0.8);
      else if (term.length >= 5 && near(w, term)) best = Math.max(best, 0.6);
    }
    return best;
  };

  document.querySelectorAll<HTMLElement>('[data-library]').forEach((lib) => {
    const chips = [...lib.querySelectorAll<HTMLButtonElement>('.al-chip')];
    const list = lib.querySelector<HTMLElement>('.al-list')!;
    const items = [...lib.querySelectorAll<HTMLElement>('.al-list li')];
    const count = lib.querySelector<HTMLElement>('.al-count')!;
    const feature = lib.querySelector<HTMLElement>('[data-featured]');
    const nav = lib.querySelector<HTMLElement>('.al-pages')!;
    const input = lib.querySelector<HTMLInputElement>('#al-q')!;
    const clear = lib.querySelector<HTMLButtonElement>('.al-clear')!;
    const empty = lib.querySelector<HTMLElement>('.al-empty')!;
    const perPage = Number(lib.dataset.perPage) || 20;
    const index = items.map((li) => ({
      li,
      title: words(li.dataset.title ?? '').map(stem),
      topic: words(li.dataset.topicLabel ?? '').map(stem),
      body: words(li.dataset.search ?? '').map(stem),
    }));
    const score = (q: string) => {
      const terms = words(q);
      const scores = new Map<HTMLElement, number>();
      for (const doc of index) {
        let total = 0;
        let matched = 0;
        for (const raw of terms) {
          // The word itself counts fully; its everyday synonyms add a
          // smaller boost, so an exact match always ranks first.
          const field = (t: string) => 5 * hits(t, doc.title) + 3 * hits(t, doc.topic) + 1.5 * hits(t, doc.body);
          const own = stem(raw);
          const syn = [...new Set((SYNONYMS[raw] ?? []).map(stem))].filter((t) => t !== own);
          const best = field(own) + 0.4 * Math.max(0, ...syn.map(field));
          if (best > 0) matched++;
          total += best;
        }
        // Articles matching more of the words rank higher.
        if (total > 0) scores.set(doc.li, total * (matched / terms.length));
      }
      return scores;
    };
    let topic = '';
    let page = 1;
    let query = '';
    const render = (push: boolean, scroll = false) => {
      if (topic && !chips.some((c) => c.dataset.topic === topic)) topic = '';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(!query && c.dataset.topic === topic)));
      let matching: HTMLElement[];
      if (query) {
        const s = score(query);
        matching = items.filter((li) => s.has(li)).sort((a, b) => (s.get(b) ?? 0) - (s.get(a) ?? 0));
        matching.forEach((li) => list.append(li));
      } else {
        items.forEach((li) => list.append(li));
        matching = items.filter((li) => (topic ? li.dataset.topic === topic : !('lead' in li.dataset)));
      }
      const pages = Math.max(1, Math.ceil(matching.length / perPage));
      page = Math.min(Math.max(1, page), pages);
      const shown = new Set(matching.slice((page - 1) * perPage, page * perPage));
      items.forEach((li) => { li.hidden = !shown.has(li); });
      if (feature) feature.hidden = !!topic || !!query || page > 1;
      clear.hidden = !query;
      empty.hidden = !query || matching.length > 0;
      const label = chips.find((c) => c.dataset.topic === topic)?.firstChild?.textContent?.trim();
      count.textContent = query
        ? (matching.length ? `${matching.length} article${matching.length === 1 ? '' : 's'} for “${query}”, best matches first` : '')
        : topic ? `${matching.length} article${matching.length === 1 ? '' : 's'} on ${label?.toLowerCase()}` : '';
      nav.hidden = pages < 2;
      nav.innerHTML = '';
      if (pages > 1) {
        const btn = (text: string, to: number, opts: { current?: boolean; disabled?: boolean; label?: string } = {}) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = text;
          if (opts.label) b.setAttribute('aria-label', opts.label);
          if (opts.current) b.setAttribute('aria-current', 'page');
          b.disabled = !!opts.disabled;
          b.addEventListener('click', () => { page = to; render(true, true); });
          nav.append(b);
        };
        btn('Previous', page - 1, { disabled: page === 1 });
        for (let i = 1; i <= pages; i++) btn(String(i), i, { current: i === page, label: `Page ${i}` });
        btn('Next', page + 1, { disabled: page === pages });
      }
      if (push) {
        const url = new URL(location.href);
        for (const [k, v] of [['q', query], ['topic', query ? '' : topic], ['page', page > 1 ? String(page) : '']]) {
          if (v) url.searchParams.set(k, v); else url.searchParams.delete(k);
        }
        history.replaceState(null, '', url);
      }
      if (scroll) lib.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    chips.forEach((c) => c.addEventListener('click', () => { topic = c.dataset.topic ?? ''; query = ''; input.value = ''; page = 1; render(true); }));
    let timer: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => { query = input.value.trim(); topic = ''; page = 1; render(true); }, 150);
    });
    clear.addEventListener('click', () => { input.value = ''; query = ''; page = 1; render(true); input.focus(); });
    const params = new URLSearchParams(location.search);
    query = params.get('q')?.trim() ?? '';
    input.value = query;
    topic = query ? '' : params.get('topic') ?? '';
    page = Number(params.get('page')) || 1;
    render(false);
  });
</script>
