---
// Real faces as the hero visual: an asymmetric photo grid of the team.
// Five people: one tall tile plus a 2x2 grid. Fewer: a simpler grid. Each
// photo keeps the face in frame via its ImageSlot `focus`.
//
// Rule (Luke, 2026-10-14): no tile is ever wider than it is tall.
// Headshots are portrait, and a wide strip can only show a band of the
// face (a forehead, or a chin), whatever the focus point. Tiles are square
// or portrait at every screen size.
import { Image } from 'astro:assets';
import type { ImageSlot } from '../../lib/pages';

interface Props {
  people: { name: string; photo: ImageSlot }[];
}

// Placeholder photos ("Photo coming soon") never go in the hero grid.
const people = Astro.props.people.filter((p) => p.photo?.url && !p.photo.placeholder).slice(0, 5);
const layout = people.length >= 5 ? 'five' : people.length === 4 ? 'four' : people.length === 1 ? 'one' : 'few';
---

{people.length > 0 && (
  <div class:list={['pm', `pm-${layout}`]}>
    {people.map((p, i) => (
      <figure class={`pm-${i}`}>
        <Image
          src={p.photo.url}
          alt={p.photo.alt || p.name}
          inferSize
          widths={i === 0 ? [320, 480, 640] : [200, 300, 400]}
          sizes={i === 0 ? '(max-width: 1023px) 50vw, 240px' : '(max-width: 1023px) 33vw, 160px'}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          style={`object-position:${p.photo.focus ?? 'var(--headshot-focus)'}`}
        />
      </figure>
    ))}
  </div>
)}

<style>
  .pm { display: grid; gap: 10px; max-width: 460px; }
  figure { position: relative; margin: 0; border-radius: var(--radius-card); overflow: hidden; background: var(--tint); aspect-ratio: 1; }
  img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Five: a tall tile on the left, four squares on the right. */
  .pm-five { grid-template-columns: 1.2fr 1fr 1fr; }
  .pm-five .pm-0 { grid-column: 1; grid-row: 1 / 3; aspect-ratio: auto; }
  /* Four: two by two. */
  .pm-four { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* Two or three: side by side, slightly tall. */
  .pm-few { grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); }
  .pm-few figure { aspect-ratio: 4 / 5; }
  /* One: a single portrait. */
  .pm-one { max-width: 320px; }
  .pm-one figure { aspect-ratio: 4 / 5; }
  @media (max-width: 767px) { .pm { gap: 8px; } }
</style>
