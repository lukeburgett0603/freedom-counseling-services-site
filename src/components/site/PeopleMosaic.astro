---
// Real faces as the hero visual: an asymmetric photo grid of the team.
// Five people: one large tile plus four. Fewer: a simpler grid. Each
// photo keeps the face in frame via its ImageSlot `focus`.
import { Image } from 'astro:assets';
import type { ImageSlot } from '../../lib/pages';

interface Props {
  people: { name: string; photo: ImageSlot }[];
}

const people = Astro.props.people.filter((p) => p.photo?.url).slice(0, 5);
const layout = people.length >= 5 ? 'five' : people.length === 4 ? 'four' : 'few';
---

{people.length > 0 && (
  <div class:list={['pm', `pm-${layout}`]}>
    {people.map((p, i) => (
      <figure class={`pm-${i}`}>
        <Image
          src={p.photo.url}
          alt={p.photo.alt || p.name}
          width={i === 0 ? 640 : 400}
          height={i === 0 ? 640 : 400}
          widths={i === 0 ? [320, 480, 640] : [200, 300, 400]}
          sizes={i === 0 ? '(max-width: 1023px) 66vw, 280px' : '(max-width: 1023px) 33vw, 140px'}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          style={p.photo.focus ? `object-position:${p.photo.focus}` : undefined}
        />
      </figure>
    ))}
  </div>
)}

<style>
  .pm { display: grid; gap: 10px; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 118px; }
  figure { border-radius: var(--radius-card); overflow: hidden; background: var(--tint); }
  img { width: 100%; height: 100%; object-fit: cover; }
  .pm-five .pm-0 { grid-column: 1 / 3; grid-row: 1 / 3; }
  .pm-five .pm-1 { grid-column: 3; grid-row: 1; }
  .pm-five .pm-2 { grid-column: 3; grid-row: 2; }
  .pm-five .pm-3 { grid-column: 1; grid-row: 3; }
  .pm-five .pm-4 { grid-column: 2 / 4; grid-row: 3; }
  .pm-four { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 170px; }
  .pm-few { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 220px; }
  .pm-few .pm-0:last-child { grid-column: 1 / -1; }
  @media (max-width: 767px) { .pm { grid-auto-rows: 96px; gap: 8px; } .pm-four { grid-auto-rows: 140px; } }
</style>
