---
// A two-cell bento: how to get started (verb-labelled steps, a button)
// beside a dark card with the price range (price transparency).
import Ph from './Ph.astro';
import { renderCopy } from '../../lib/markdown';
import { withBase } from '../../lib/url';

interface Props {
  stepsHeading: string;
  steps: { icon: string; title: string; text: string }[];
  action?: { label: string; href: string };
  costHeading: string;
  costFigure: string;
  costNote?: string;
  costBody?: string; // markdown
  costLink?: { label: string; href: string };
}

const { stepsHeading, steps, action, costHeading, costFigure, costNote, costBody, costLink } = Astro.props;
---

<section class="s-section sc">
  <div class="s-wrap sc-grid s-reveal">
    <div class="sc-steps">
      <h2>{stepsHeading}</h2>
      <ol>
        {steps.map((s) => (
          <li>
            <span class="sc-icon"><Ph name={s.icon || 'check'} /></span>
            <div><h3>{s.title}</h3><p>{s.text}</p></div>
          </li>
        ))}
      </ol>
      {action && <a class="s-btn s-btn-primary" href={action.href}>{action.label}</a>}
    </div>
    <div class="sc-cost">
      <h2>{costHeading}</h2>
      <p class="sc-fig">{costFigure}</p>
      {costNote && <p class="sc-note">{costNote}</p>}
      {costBody && <div class="sc-body" set:html={renderCopy(costBody)} />}
      {costLink && <a class="sc-link" href={withBase(costLink.href)}>{costLink.label} <Ph name="arrow-right" /></a>}
    </div>
  </div>
</section>

<style>
  .sc { padding-top: 0; }
  .sc-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 18px; }
  .sc-steps { background: var(--surface); border-radius: var(--radius-card); padding: 40px; box-shadow: var(--shadow); }
  ol { list-style: none; padding: 0; margin-top: 28px; display: grid; gap: 26px; }
  li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; }
  .sc-icon { width: 44px; height: 44px; border-radius: 50%; background: var(--tint); display: grid; place-items: center; font-size: 1.3rem; color: var(--accent); }
  h3 { font-size: 1.1rem; }
  li p { color: var(--muted); font-size: 1rem; }
  .sc-steps .s-btn { margin-top: 30px; }
  .sc-cost { background: var(--ink); color: #eef1f2; border-radius: var(--radius-card); padding: 40px; display: flex; flex-direction: column; }
  .sc-cost h2 { color: #fff; }
  .sc-fig { font-size: clamp(2.6rem, 4.4vw, 3.6rem); font-weight: 800; letter-spacing: -0.03em; margin: 22px 0 4px; color: #fff; line-height: 1.1; }
  .sc-note { color: #c3ccce; font-size: 0.95rem; }
  .sc-body { color: #d5dcdd; margin-top: 18px; font-size: 1rem; }
  .sc-body :global(a) { color: #fff; }
  .sc-link { margin-top: auto; padding-top: 24px; color: #fff; font-weight: 600; display: inline-flex; gap: 6px; align-items: center; }
  @media (max-width: 1023px) { .sc-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 767px) { .sc-steps, .sc-cost { padding: 28px; } }
</style>
