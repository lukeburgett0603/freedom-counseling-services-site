---
// One large photo for a person's own page (counselor profile hero).
import { Image } from 'astro:assets';
import type { ImageSlot } from '../../lib/pages';

interface Props { photo: ImageSlot | null; name: string }
const { photo, name } = Astro.props;
---

{photo && (
  <figure class="pt">
    <Image src={photo.url} alt={photo.alt || name} inferSize widths={[360, 540, 720]} sizes="(max-width: 1023px) 90vw, 420px" loading="eager" fetchpriority="high" style={`object-position:${photo.focus ?? 'var(--headshot-focus)'}`} />
  </figure>
)}

<style>
  .pt { border-radius: var(--radius-card); overflow: hidden; background: var(--tint); aspect-ratio: 5 / 6; max-height: 520px; }
  img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 1023px) { .pt { max-width: 420px; } }
</style>
