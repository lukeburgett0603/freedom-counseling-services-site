---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import BlogPreview from '../components/BlogPreview.astro';
import CTA from '../components/CTA.astro';
import LeadGenerator from '../components/LeadGenerator.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import { renderCopy } from '../lib/markdown';
import { withBase } from '../lib/url';
import { getCounselorOptions } from '../lib/pages';
import type { Page, Business } from '../lib/pages';

interface Props {
  page: Page;
  allPages: Page[];
  business: Business;
}

const { page, allPages, business } = Astro.props;
const counselors = getCounselorOptions(allPages);

// The hub page whose `category` matches this post's — used for the
// "back to [category]" link so a spoke post links back to its pillar,
// same as the pillar links out to its spokes (BlogPreview.astro).
// Both 'Content Pillar' and 'Service Hub' can own a category (see
// CLAUDE.md's "Service Hub" section) — a client whose categories are
// all Service Hub pages (e.g. Freedom Counseling Services) would
// otherwise never get a working back-link on any of its blog posts.
const hubPage = page.category
  ? allPages.find(
      (p) => (p.page_type === 'Content Pillar' || p.page_type === 'Service Hub') && p.category === page.category
    )
  : undefined;

const publishedDate = page.date_published
  ? new Date(page.date_published).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

// Related-posts cards, same category-match pattern as ContentPillar/
// ServiceHub's own BlogPreview — a Blog Post page never had this at all
// before (see CLAUDE.md's "Blog sidebar CTA" section); capped to 3, not
// the usual 6, since this is a lighter "keep reading" nudge here, not a
// hub page's own dedicated related-content section.
const relatedPosts = page.category
  ? allPages
      .filter((p) => p.page_type === 'Blog Post' && p.category === page.category && p.id !== page.id)
      .sort((a, b) => (b.date_published ?? '').localeCompare(a.date_published ?? ''))
  : [];
---

<BaseLayout page={page} allPages={allPages} business={business}>
  <Hero
    h1={page.h1 ?? page.title}
    imageUrl={page.images.hero?.url}
    imageAlt={page.images.hero?.alt}
    imageCreditName={page.images.hero?.creditName}
    imageCreditUrl={page.images.hero?.creditUrl}
    imageFocalY={page.hero_image_focal_y}
    compact
  />
  <div class="mx-auto max-w-3xl px-6 pt-6 text-sm text-slate-500">
    {page.author_name && (
      <span>By {page.author_name}{page.credentials && <>, {page.credentials}</>}</span>
    )}
    {page.author_name && (publishedDate || page.category) && <span> &middot; </span>}
    {publishedDate && <span>{publishedDate}</span>}
    {publishedDate && page.category && <span> &middot; </span>}
    {page.category && hubPage && (
      <a href={withBase(`/${hubPage.slug}`)} class="text-brand-primary hover:underline">{page.category}</a>
    )}
    {page.category && !hubPage && <span>{page.category}</span>}
  </div>
  <div class="mx-auto max-w-3xl px-6 pt-6">
    <KeyTakeaways items={page.key_takeaways} />
  </div>
  {/*
    Desktop-only two-column layout: the article sits in a wider grid
    track than before (was mx-auto max-w-3xl, centered) — prose-lg's own
    65ch line-length cap (see ContentPillar.astro's identical comment)
    still keeps the text itself readable, it just now sits flush-left in
    its track rather than centered, which is what actually "nudges it
    left." The sidebar is a sticky CTA card (see CTA.astro's `sidebar`
    variant) so a reader scrolling through a long post always has an
    easy next step in view, without competing with the full CTA band
    once that scrolls into view (handled by the script below). Hidden
    below `lg` — a sticky sidebar has nowhere sensible to sit on a
    narrow viewport, and mobile already has MobileCTABar's persistent
    bottom bar for this same job.
  */}
  <div class="mx-auto grid max-w-5xl grid-cols-1 gap-10 px-6 pb-10 lg:grid-cols-[1fr_320px]">
    <article class="prose prose-lg">
      <Fragment set:html={renderCopy(page.copy)} />
    </article>
    <aside id="blog-sidebar-cta" class="hidden lg:sticky lg:top-24 lg:block lg:self-start">
      <CTA
        variant="sidebar"
        heading={page.cta_heading ?? `Want help from ${business.display_name}?`}
        subheading={page.cta_subheading}
        buttonText={page.cta_button_text ?? undefined}
        href="#lead-generator"
        pageId={page.id}
      />
    </aside>
  </div>
  {relatedPosts.length > 0 && page.category && (
    <BlogPreview posts={relatedPosts} category={page.category} allPages={allPages} limit={3} />
  )}
  <CTA
    id="blog-main-cta"
    heading={page.cta_heading ?? `Want help from ${business.display_name}?`}
    subheading={page.cta_subheading}
    buttonText={page.cta_button_text ?? undefined}
    pageId={page.id}
  />
  <LeadMagnet pageId={page.id} turnstileSiteKey={business.cloudflare_turnstile_site_key} />
  <LeadGenerator
    slug={page.slug}
    heading={page.cta_button_text ?? undefined}
    submitText={page.cta_button_text ?? undefined}
    collectWebsiteUrl={business.collect_website_in_leads}
    responseTimeNote={business.lead_response_time_note}
    turnstileSiteKey={business.cloudflare_turnstile_site_key}
    collectCounselorPreference={business.collect_counselor_preference}
    collectSessionFormat={business.collect_session_format_preference}
    collectLeadSource={business.collect_lead_source}
    counselors={counselors}
  />
</BaseLayout>

<script>
  // Hide the sticky sidebar CTA the moment the real, bottom CTA band
  // scrolls into view — same "don't show two near-identical CTAs in one
  // view at once" rule MobileCTABar.astro already enforces against a
  // visible lead-form submit button, just watching the CTA band instead
  // here (the sidebar's whole job is to stand in for that band while
  // it's out of view below). Reappears if the reader scrolls back up
  // past it, matching the same toggle-on-every-intersection-change
  // behavior MobileCTABar uses rather than a one-shot hide.
  const sidebar = document.getElementById('blog-sidebar-cta');
  const mainCta = document.getElementById('blog-main-cta');
  if (sidebar && mainCta) {
    // Inline style, not a Tailwind class — see adminAuth.ts's own note on
    // why toggling classList against an element that already carries a
    // responsive display utility (`lg:block` here) doesn't reliably work;
    // an empty string clears the inline override, letting `hidden`/
    // `lg:block` resume controlling visibility normally again.
    const observer = new IntersectionObserver(([entry]) => {
      sidebar.style.display = entry.isIntersecting ? 'none' : '';
    });
    observer.observe(mainCta);
  }
</script>
