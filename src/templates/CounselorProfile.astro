---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import StoryBrandSection from '../components/StoryBrandSection.astro';
import CollapsibleSection from '../components/CollapsibleSection.astro';
import StatusPill from '../components/StatusPill.astro';
import TelehealthPill from '../components/TelehealthPill.astro';
import InPersonPill from '../components/InPersonPill.astro';
import SpecialtyPills from '../components/SpecialtyPills.astro';
import CounselorQuote from '../components/CounselorQuote.astro';
import Modalities from '../components/Modalities.astro';
import PlanSteps from '../components/PlanSteps.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import LeadGenerator from '../components/LeadGenerator.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import { renderCopy } from '../lib/markdown';
import { getCounselorOptions } from '../lib/pages';
import type { Page, Business } from '../lib/pages';

interface Props {
  page: Page;
  allPages: Page[];
  business: Business;
}

const { page, allPages, business } = Astro.props;
const headshot = page.images.headshot;
const counselors = getCounselorOptions(allPages);
// A physical office is a fact about the practice, not this one counselor
// — every counselor at a practice with a real street address sees
// clients there. See InPersonPill.astro's own comment for when this
// would need to become a real per-counselor field instead.
const hasOffice = !!business.street_address;
---

<BaseLayout page={page} allPages={allPages} business={business}>
  <section class="mx-auto max-w-5xl px-6 py-14">
    <div class="grid grid-cols-1 gap-8 rounded-lg border border-black/5 bg-white p-8 text-center shadow-sm sm:grid-cols-[14rem_1fr] sm:items-start sm:p-10 sm:text-left">
      <div class="flex flex-col items-center sm:items-start">
        {/*
          `avatar-crop` is a plain hook class with no default rule here —
          `rounded-full` covers the shape for every client with no per-client
          motif. A client whose real brand supports a distinct photo-crop
          motif (an arch, say) defines `.avatar-crop` in their own
          global.css to override it there instead of here, the same way
          global.css's color/font tokens already diverge per client.
        */}
        {headshot && (
          <div class="relative shrink-0">
            <OptimizedImage
              src={headshot.url}
              alt={headshot.alt}
              class="avatar-crop h-56 w-56 rounded-full object-cover"
              loading="eager"
              widths={[224, 448]}
              sizes="224px"
              creditName={headshot.creditName}
              creditUrl={headshot.creditUrl}
            />
            <div class="absolute bottom-2 left-1/2 -translate-x-1/2 sm:left-2 sm:translate-x-0">
              <StatusPill status={page.availability_status} />
            </div>
          </div>
        )}
        <div class="mt-4 flex flex-col items-center gap-1 sm:items-start">
          {/*
            The counselor's own name — no longer the literal <h1> (see
            hero_headline below), but still the first, most prominent
            thing in the identity column so a visitor always knows whose
            page this is regardless of whether a tagline is set.
          */}
          <p class="font-[family-name:var(--font-heading)] text-xl font-bold text-brand-ink">{page.title}</p>
          {(page.professional_title || page.credentials) && (
            <p class="text-sm font-semibold text-brand-primary">{page.professional_title ?? page.credentials}</p>
          )}
          {page.license_number && <p class="text-xs text-slate-500">License #{page.license_number}</p>}
          {page.education && <p class="text-xs text-slate-500">{page.education}</p>}
        </div>
        {(page.telehealth_available || hasOffice) && (
          <div class="mt-3 flex flex-wrap justify-center gap-2 sm:justify-start">
            <TelehealthPill telehealthAvailable={page.telehealth_available} />
            <InPersonPill hasOffice={hasOffice} />
          </div>
        )}
      </div>
      <div>
        <h1 class="font-[family-name:var(--font-heading)] text-3xl font-extrabold tracking-tight text-brand-ink sm:text-4xl">
          {page.hero_headline ?? page.title}
        </h1>
        {page.hero_subhead && <p class="mt-4 text-slate-600">{page.hero_subhead}</p>}

        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a
            href="#lead-generator"
            class="inline-flex items-center gap-2 rounded-md bg-brand-primary px-7 py-3.5 text-base font-semibold text-white shadow-sm transition duration-150 hover:-translate-y-px hover:shadow-[0_6px_14px_rgba(123,39,20,0.22)]"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px] shrink-0" aria-hidden="true">
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M3 10h18M8 3v4M16 3v4"></path>
            </svg>
            {page.cta_button_text ?? 'Start Counseling'}
          </a>
          {business.telephone && (
            <a
              href={`tel:${business.telephone.replace(/[^0-9+]/g, '')}`}
              class="inline-flex items-center gap-2 rounded-md border border-slate-300 px-5 py-3 text-sm font-semibold text-brand-ink transition hover:bg-slate-50"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0" aria-hidden="true">
                <path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C11.9 21 3 12.1 3 3c0-.6.4-1 1-1h3.2c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1z"></path>
              </svg>
              {business.telephone}
            </a>
          )}
        </div>

        {(page.specialties.length > 0 || page.modalities.length > 0) && (
          <div class="mt-6 grid grid-cols-1 gap-5 border-t border-brand-tint/40 pt-5 opacity-[0.82] sm:grid-cols-2">
            {page.specialties.length > 0 && (
              <div>
                <p class="mb-1.5 text-center text-xs font-semibold uppercase tracking-wide text-slate-400 sm:text-left">Specialties</p>
                <SpecialtyPills specialties={page.specialties} />
              </div>
            )}
            {page.modalities.length > 0 && (
              <div>
                <Modalities modalities={page.modalities} />
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  </section>
  <CounselorQuote quote={page.testimonial_quote} author={page.testimonial_author} />
  {(page.storybrand_problem || page.storybrand_guide_empathy) && (
    <section class="mx-auto max-w-5xl px-6 py-14">
      <div class:list={['grid grid-cols-1 gap-6', page.storybrand_problem && page.storybrand_guide_empathy && 'lg:grid-cols-2']}>
        {page.storybrand_problem && (
          <div class="rounded-lg border border-black/5 bg-white p-6 shadow-sm sm:p-8">
            <div class="prose">
              <Fragment set:html={renderCopy(page.storybrand_problem)} />
            </div>
          </div>
        )}
        {page.storybrand_guide_empathy && (
          <div class="rounded-lg border border-black/5 bg-white p-6 shadow-sm sm:p-8">
            <div class="prose">
              <Fragment set:html={renderCopy(page.storybrand_guide_empathy)} />
            </div>
          </div>
        )}
      </div>
    </section>
  )}
  <PlanSteps steps={page.plan_steps} heading="What to expect in your first session" />
  <CollapsibleSection markdown={page.storybrand_pitch} triggerText={page.storybrand_pitch_label} />
  <StoryBrandSection markdown={page.storybrand_success} />
  {page.storybrand_failure && (
    <Section>
      <Fragment set:html={renderCopy(page.storybrand_failure)} />
    </Section>
  )}
  <FAQ faqs={page.faqs} />
  <CTA heading={page.cta_heading ?? `Book with ${page.title}`} buttonText={page.cta_button_text ?? undefined} />
  <LeadMagnet pageId={page.id} />
  <LeadGenerator
    slug={page.slug}
    heading={page.cta_button_text ?? undefined}
    submitText={page.cta_button_text ?? undefined}
    collectWebsiteUrl={business.collect_website_in_leads}
    responseTimeNote={business.lead_response_time_note}
    collectCounselorPreference={business.collect_counselor_preference}
    collectSessionFormat={business.collect_session_format_preference}
    counselors={counselors}
    defaultCounselorId={page.id}
  />
</BaseLayout>
