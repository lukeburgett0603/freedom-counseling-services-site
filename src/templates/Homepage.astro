---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import StoryBrandSection from '../components/StoryBrandSection.astro';
import ValueAddStrip from '../components/ValueAddStrip.astro';
import ValueProposition from '../components/ValueProposition.astro';
import Guide from '../components/Guide.astro';
import FeaturedServices from '../components/FeaturedServices.astro';
import CounselorCards from '../components/CounselorCards.astro';
import ExplanatoryBrandscript from '../components/ExplanatoryBrandscript.astro';
import CTA from '../components/CTA.astro';
import Testimonial from '../components/Testimonial.astro';
import PlanSteps from '../components/PlanSteps.astro';
import LeadGenerator from '../components/LeadGenerator.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import { renderCopy } from '../lib/markdown';
import { getCounselorOptions } from '../lib/pages';
import type { Page, Business } from '../lib/pages';

interface Props {
  page: Page;
  allPages: Page[];
  business: Business;
}

const { page, allPages, business } = Astro.props;
const counselors = getCounselorOptions(allPages);

// The overlay Hero style only actually renders as 'overlay' once a real
// image is on file (see Hero.astro's own fallback) — computed once here
// too so the aside form's field set/styling stays in lockstep with what
// Hero.astro will actually show, rather than re-deriving the same
// condition twice and risking the two drifting apart.
const isOverlayHero = page.hero_style === 'overlay' && !!page.images.hero;
---

<BaseLayout page={page} allPages={allPages} business={business}>
  <Hero
    h1={page.h1 ?? page.title}
    subhead={page.hero_subhead ?? undefined}
    imageUrl={page.images.hero?.url}
    imageAlt={page.images.hero?.alt}
    imageCreditName={page.images.hero?.creditName}
    imageCreditUrl={page.images.hero?.creditUrl}
    imageFocalY={page.hero_image_focal_y}
    ctaText={page.cta_button_text ?? 'Get Started'}
    style={page.hero_style}
    overlayColor={page.hero_overlay_color}
    overlayOpacity={page.hero_overlay_opacity}
  >
    {/*
      In the default style, only renders when there's no hero image
      (Hero.astro's `aside` slot is ignored whenever imageUrl is set) — a
      compact, lower-friction form as a second entry point for a homepage
      that leads with a form instead of a photo. In the overlay style, this
      renders alongside the full-bleed image as a frosted-glass card and
      shows every field (compact=false) — the form itself is the page's
      one real CTA there, matching Hero.astro's own CTA-button suppression
      whenever this slot is visible. Either way, the full-fields
      LeadGenerator further down the page stays too, for visitors who
      scroll past the hero without converting.
    */}
    <Fragment slot="aside">
      <LeadGenerator
        slug={page.slug}
        embedded
        compact={!isOverlayHero}
        frosted={isOverlayHero}
        heading={page.cta_button_text ?? 'Get Started'}
        submitText={page.cta_button_text ?? 'Get Started'}
        collectWebsiteUrl={business.collect_website_in_leads}
        responseTimeNote={business.lead_response_time_note}
        turnstileSiteKey={business.cloudflare_turnstile_site_key}
        collectCounselorPreference={business.collect_counselor_preference}
        collectSessionFormat={business.collect_session_format_preference}
        counselors={counselors}
      />
    </Fragment>
  </Hero>

  {/* Value Add strip — a quick, scannable first pass at value, distinct
      from the fuller ValueProposition section below. */}
  <ValueAddStrip items={page.value_add_items} />

  {/* Stakes — storybrand_problem, relabeled "Stakes" in the admin for
      Homepage rows only (same column/data as Service Page/Counselor
      Profile's "The Problem", different admin-facing label). Loss-
      aversion/philosophical-wrongness framing per copywriter guidance,
      positioned right after the Hero so it isn't buried. */}
  {page.storybrand_problem && (
    <Section>
      <Fragment set:html={renderCopy(page.storybrand_problem)} />
    </Section>
  )}

  {/* Value Proposition — the positive flip, repurposed from
      storybrand_pitch/storybrand_pitch_label (freed up now that
      ExplanatoryBrandscript owns the freestanding full-brandscript
      role). Own CTA, optional supporting image. */}
  <ValueProposition
    heading={page.storybrand_pitch_label}
    body={page.storybrand_pitch}
    image={page.images.valueProposition}
    ctaText={page.cta_button_text}
  />

  {/* The Plan — unchanged rendering (H2 heading / H3 per step / optional
      paragraph), now with its own inline CTA inside the same band. */}
  <PlanSteps steps={page.plan_steps} ctaText={page.cta_button_text} />

  {/* The Guide — empathy + scannable authority facts + own CTA, with the
      existing optional Testimonial directly below (still independently
      gated on having a real quote). */}
  <Guide body={page.storybrand_guide_empathy} authorityStats={page.guide_authority_stats} ctaText={page.cta_button_text} />
  {page.testimonial_quote && page.testimonial_author && (
    <Testimonial quote={page.testimonial_quote} author={page.testimonial_author} role={page.testimonial_role} />
  )}

  {/* Featured Services — up to 3 cards, self-maintaining. */}
  <FeaturedServices allPages={allPages} />

  {/* Counselor cards — group-practice only, self-gates on >1 Counselor
      Profile page. */}
  <CounselorCards allPages={allPages} />

  {/* Explanatory Paragraph — the new freestanding full BrandScript,
      collapsible, with optional video. */}
  <ExplanatoryBrandscript
    oneLiner={page.brandscript_one_liner}
    teaser={page.brandscript_teaser}
    full={page.brandscript_full}
    videoUrl={page.brandscript_video_url}
  />

  {/* Failure (stakes reminder) — moved to just before Success, so the
      page's final narrative beats are "what's still at risk" followed
      immediately by "and here's what's possible instead," landing the
      visitor in success rather than on the reminder of failure. */}
  {page.storybrand_failure && (
    <Section>
      <Fragment set:html={renderCopy(page.storybrand_failure)} />
    </Section>
  )}
  <StoryBrandSection markdown={page.storybrand_success} />

  <CTA heading={page.cta_heading ?? `Ready to work with ${business.display_name}?`} buttonText={page.cta_button_text ?? undefined} />
  <LeadMagnet pageId={page.id} turnstileSiteKey={business.cloudflare_turnstile_site_key} />
  <LeadGenerator
    slug={page.slug}
    heading={page.cta_button_text ?? undefined}
    submitText={page.cta_button_text ?? undefined}
    collectWebsiteUrl={business.collect_website_in_leads}
    responseTimeNote={business.lead_response_time_note}
    turnstileSiteKey={business.cloudflare_turnstile_site_key}
    collectCounselorPreference={business.collect_counselor_preference}
    collectSessionFormat={business.collect_session_format_preference}
    counselors={counselors}
  />
</BaseLayout>
