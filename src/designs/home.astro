---
// Homepage design (site system v2), from Freedom Counseling Services'
// approved direction (2026-10-13). Section order is the page's story:
// recognition, reassurance, faith, the people, how to start and what it
// costs, a picture of change, honest limits, questions, then the
// request form. Each section uses a different layout family.
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroSplit from '../components/site/HeroSplit.astro';
import PeopleMosaic from '../components/site/PeopleMosaic.astro';
import FactsStrip from '../components/site/FactsStrip.astro';
import QuoteLinks from '../components/site/QuoteLinks.astro';
import ProseSplit from '../components/site/ProseSplit.astro';
import StatementBand from '../components/site/StatementBand.astro';
import PeopleCards from '../components/site/PeopleCards.astro';
import StepsCost from '../components/site/StepsCost.astro';
import NoteCard from '../components/site/NoteCard.astro';
import FaqList from '../components/site/FaqList.astro';
import RequestPanel from '../components/site/RequestPanel.astro';
import { blockReader, type BlockValues } from '../lib/blocks';
import type { Page, Business } from '../lib/pages';
import { withBase } from '../lib/url';
import { HOME_BLOCKS } from './home.blocks';
import { personCards, rateRange, counselorOptions, fill } from './shared';

interface Props {
  page: Page;
  allPages: Page[];
  business: Business;
  blocks: BlockValues;
  allBlocks: Map<string, BlockValues>;
}

const { page, allPages, business, blocks, allBlocks } = Astro.props;
const { t, list } = blockReader(blocks, HOME_BLOCKS);
const vars = { rate_range: rateRange(allPages), phone: business.telephone };
const f = (key: string) => fill(t(key), vars);
const people = personCards(allPages, allBlocks);
const tel = business.telephone?.replace(/[^0-9+]/g, '');
---

<SiteLayout page={page} allPages={allPages} business={business}>
  <HeroSplit
    eyebrow={t('hero.eyebrow')}
    headline={page.h1 ?? page.title}
    subhead={f('hero.subhead')}
    primary={{ label: page.cta_button_text ?? 'Request an appointment', href: '#request' }}
    secondary={tel ? { label: business.telephone!, href: `tel:${tel}`, icon: 'phone' } : undefined}
  >
    <PeopleMosaic slot="media" people={people.map((p) => ({ name: p.name, photo: p.photo! })).filter((p) => p.photo)} />
  </HeroSplit>

  <FactsStrip items={list('facts').map((i) => ({ icon: i.icon, text: fill(i.text, vars), linkText: i.link_text, href: i.href ? withBase(i.href) : undefined }))} />

  <QuoteLinks heading={t('brings.heading')} lede={t('brings.lede')} items={list('brings.items').map((i) => ({ quote: i.quote, label: i.label, href: i.href }))} />

  <ProseSplit heading={t('empathy.heading')} body={f('empathy.body')} layout="split" />

  <StatementBand heading={t('faith.heading')} body={t('faith.body')} link={{ label: t('faith.link_label'), href: t('faith.link_href') }} />

  <PeopleCards
    heading={t('team.heading')}
    lede={t('team.lede')}
    people={people}
    note={t('team.note')}
    allLink={{ label: t('team.all_label'), href: '/counselors' }}
  />

  <StepsCost
    stepsHeading={t('start.heading')}
    steps={list('start.steps').map((s) => ({ icon: s.icon, title: s.title, text: fill(s.text, vars) }))}
    action={{ label: page.cta_button_text ?? 'Request an appointment', href: '#request' }}
    costHeading={t('cost.heading')}
    costFigure={vars.rate_range ?? ''}
    costNote={f('cost.note')}
    costBody={f('cost.body')}
    costLink={{ label: t('cost.link_label'), href: '/fees' }}
  />

  <ProseSplit heading={t('vision.heading')} body={t('vision.body')} layout="stack" />

  <NoteCard heading={t('elsewhere.heading')} body={f('elsewhere.body')} icon="signpost" />

  <FaqList heading={t('faq.heading')} faqs={page.faqs} />

  <RequestPanel
    slug={page.slug}
    business={business}
    heading={t('request.heading')}
    text={f('request.text')}
    counselors={counselorOptions(allPages)}
    formatNote={t('request.format_note')}
    submitText={page.cta_button_text ?? undefined}
  />
</SiteLayout>
