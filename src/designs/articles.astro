---
// Articles list design (site system v2), the Blog Index page.
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroSplit from '../components/site/HeroSplit.astro';
import LinkCards from '../components/site/LinkCards.astro';
import RequestPanel from '../components/site/RequestPanel.astro';
import type { Page, Business } from '../lib/pages';
import type { BlockValues } from '../lib/blocks';
import { withBase } from '../lib/url';
import { counselorOptions } from './shared';

interface Props {
  page: Page;
  allPages: Page[];
  business: Business;
  blocks: BlockValues;
  allBlocks: Map<string, BlockValues>;
}

const { page, allPages, business } = Astro.props;
const posts = allPages
  .filter((p) => p.page_type === 'Blog Post')
  .sort((a, b) => (b.date_published ?? '').localeCompare(a.date_published ?? ''))
  .map((p) => ({ title: p.h1 || p.title, text: p.meta_description ?? undefined, href: withBase(`/${p.slug}`), meta: p.author_name ? `By ${p.author_name}` : undefined }));
---

<SiteLayout page={page} allPages={allPages} business={business}>
  <HeroSplit headline={page.h1 ?? page.title} subhead={page.hero_subhead ?? 'Plain answers to the questions people bring to counseling, written by our counselors.'} />
  <LinkCards heading="All articles" items={posts} columns={2} />
  <RequestPanel slug={page.slug} business={business} heading="Ready when you are." text="Request an appointment in about a minute. Most people are seen the same week." counselors={counselorOptions(allPages)} formatNote="Online sessions are for clients in Kentucky. Indiana clients meet in person." />
</SiteLayout>
