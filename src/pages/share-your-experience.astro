---
// Where the waiting-room sign's QR code leads (see
// admin/review-program.astro). Deliberately an information page, not a
// straight redirect to Google: before anyone decides to post, they see
// that it's optional, what posting publicly means for their privacy, and
// that the practice can't respond. That's the ethical point of the
// program (ACA Code of Ethics C.3.b: counselors don't solicit
// testimonials from current or former clients). Never linked from site
// nav, emails, or anything sent to clients. noindex, and excluded from
// the sitemap in astro.config.mjs.
import { getBusiness } from '../lib/pages';
import { withBase } from '../lib/url';
import '../styles/global.css';

const business = await getBusiness();
const reviewUrl = business.google_review_url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Share Your Experience | {business.display_name}</title>
    <meta name="robots" content="noindex" />
    {business.google_fonts_url && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href={business.google_fonts_url} rel="stylesheet" />
      </>
    )}
  </head>
  <body class="bg-brand-neutral px-4 py-12 text-brand-ink">
    <main class="mx-auto max-w-xl">
      <p class="text-center text-sm font-semibold text-slate-500">{business.display_name}</p>
      <h1 class="mt-2 text-center font-[family-name:var(--font-heading)] text-3xl font-extrabold tracking-tight">
        Share your experience, only if you'd like to
      </h1>
      <p class="mt-4 text-center text-slate-700">
        Some people find it meaningful to share how counseling helped them, because it can help someone else take the
        first step. Others would rather keep their care completely private. Both are perfectly fine.
      </p>

      <div class="mt-8 space-y-4 rounded-lg border border-black/5 bg-white p-6 shadow-sm">
        <div>
          <h2 class="font-semibold">It's entirely your choice</h2>
          <p class="mt-1 text-sm text-slate-700">
            No one here will ask you for a review, and whether or not you leave one has no effect on your care.
          </p>
        </div>
        <div>
          <h2 class="font-semibold">Before you post, think about your privacy</h2>
          <ul class="mt-1 list-disc space-y-1 pl-5 text-sm text-slate-700">
            <li>Google reviews are public and show the name on your Google account.</li>
            <li>Posting a review may let others know you've been a client here.</li>
            <li>You don't need to share any details about why you came or what you worked on.</li>
            <li>You can edit or delete your review at any time.</li>
          </ul>
        </div>
        <div>
          <h2 class="font-semibold">Why we don't respond to reviews</h2>
          <p class="mt-1 text-sm text-slate-700">
            To protect your confidentiality, we don't reply to reviews or confirm that anyone is a client, whether the review
            is positive or negative. If you have a concern about your care, please talk with your counselor or contact our
            office directly{business.telephone && <> at <a href={`tel:${business.telephone}`} class="whitespace-nowrap font-semibold underline">{business.telephone}</a></>}.
          </p>
        </div>
      </div>

      {reviewUrl ? (
        <div class="mt-8 text-center">
          <a
            href={reviewUrl}
            rel="noopener"
            class="inline-block rounded-md bg-brand-accent px-6 py-3 font-semibold text-white transition hover:opacity-90"
          >
            Leave a Google review
          </a>
        </div>
      ) : (
        <p class="mt-8 text-center text-sm text-slate-500">Reviews aren't set up yet.</p>
      )}

      <p class="mt-10 text-center text-xs text-slate-500">
        If you're in crisis or thinking about harming yourself, call or text 988 (the Suicide &amp; Crisis Lifeline) or
        call 911.
      </p>
      <p class="mt-4 text-center text-xs">
        <a href={withBase('/')} class="text-slate-500 underline">Back to {business.display_name}</a>
      </p>
    </main>
  </body>
</html>
