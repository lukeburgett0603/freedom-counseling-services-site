---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { withBase } from '../../../lib/url';

const link = (path: string) => withBase(path);
---

<!--
  Monthly report (was "Overview"): the whole Full Caseload System on one screen (Get Found, Get
  Chosen, Get Referred, Get Booked, Watch It Work), plus a "Needs
  attention" list. Doubles as the monthly client report ("Print report";
  the admin sidebar is hidden in print by AdminLayout). Every number comes
  from data the detail dashboards already use, computed client-side with
  the same shared helpers, so the two never disagree:
  leadSource.ts (speed to lead), caseload.ts, adAttribution.ts.
  Website visits come from get-traffic-stats, which only knows this month
  and last month, so the "Last month" view shows visits without a
  comparison. Redesigned in phase 3 of the admin redesign (2026-10-07):
  same numbers, new layout; print uses the light tokens in admin.css.
-->
<AdminLayout title="Monthly report | Admin" current="analytics-overview">
  <div class="m-toolbar">
    <p class="i-intro m-intro" id="period-label">Your whole Full Caseload System on one page.</p>
    <div class="i-inline">
      <div class="i-seg" role="group" aria-label="Report month" id="m-period">
        <button type="button" data-offset="0" aria-pressed="true">This month</button>
        <button type="button" data-offset="1" aria-pressed="false">Last month</button>
      </div>
      <select id="period-select" hidden aria-hidden="true" tabindex="-1">
        <option value="0">This month (so far)</option>
        <option value="1">Last month</option>
      </select>
      <button id="print-report" type="button" class="a-btn i-btn">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 9V3h10v6M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2" /><path d="M7 14h10v7H7z" /></svg>
        Print
      </button>
    </div>
  </div>

  <p id="report-title" class="m-print-title"></p>

  <div class="t-grid m-loading" id="loading" aria-hidden="true">
    <div class="t-skel t-s12" style="height:120px"></div>
    <div class="t-skel t-s7" style="height:240px"></div>
    <div class="t-skel t-s5" style="height:240px"></div>
  </div>

  <div id="overview" hidden>
    <div class="m-kpis">
      <div class="t-kpi"><span class="t-lbl">New clients</span><span id="h-clients" class="t-v a-num">—</span><span id="h-clients-change" class="t-delta"></span></div>
      <div class="t-kpi"><span class="t-lbl">New inquiries</span><span id="h-leads" class="t-v a-num">—</span><span id="h-leads-change" class="t-delta"></span></div>
      <div class="t-kpi"><span class="t-lbl">Caseload</span><span id="h-caseload" class="t-v a-num">—</span><span id="h-caseload-sub" class="t-delta"></span></div>
      <div class="t-kpi"><span class="t-lbl">Median response time</span><span id="h-speed" class="t-v a-num">—</span><span id="h-speed-sub" class="t-delta"></span></div>
    </div>

    <section id="attention" class="t-card m-attn" hidden>
      <h2>Needs attention<span class="t-aside">Right now, whichever month you're viewing</span></h2>
      <ul id="attention-list" class="m-attn-list"></ul>
    </section>

    <div class="m-steps">
      <section class="t-card m-step">
        <h2><span class="m-num">1</span>Get found<a class="t-aside m-more" href={link('/admin/analytics/traffic')}>Website traffic &rarr;</a></h2>
        <dl id="found" class="m-rows"></dl>
      </section>
      <section class="t-card m-step">
        <h2><span class="m-num">2</span>Get chosen<a class="t-aside m-more" href={link('/admin/review-program')}>Reviews &rarr;</a></h2>
        <dl id="chosen" class="m-rows"></dl>
      </section>
      <section class="t-card m-step">
        <h2><span class="m-num">3</span>Get referred<a class="t-aside m-more" href={link('/admin/referral-partners')}>Referral partners &rarr;</a></h2>
        <dl id="referred" class="m-rows"></dl>
      </section>
      <section class="t-card m-step">
        <h2><span class="m-num">4</span>Get booked<a class="t-aside m-more" href={link('/admin/crm')}>Inquiries &rarr;</a></h2>
        <dl id="booked" class="m-rows"></dl>
      </section>
      <section class="t-card m-step m-wide">
        <h2><span class="m-num">5</span>Watch it work<a class="t-aside m-more" href={link('/admin/analytics/caseload')}>Caseload &rarr;</a></h2>
        <div id="work"></div>
      </section>
    </div>
    <p class="m-print-foot" id="m-print-foot"></p>
  </div>
</AdminLayout>

<script>
  import { supabase, initAdminAuth } from '../../../lib/adminAuth';
  import { withBase } from '../../../lib/url';
  import { formatHours, hoursToFirstContact, leadSourceShortLabel, median, REFERRAL_LEAD_SOURCES } from '../../../lib/leadSource';
  import { ALMOST_FULL_THRESHOLD, daysSince, percentFull, targetCaseload, type CounselorCaseload } from '../../../lib/caseload';
  import { isGoogleAdsLead } from '../../../lib/adAttribution';

  const MANUAL_SOURCE = 'Manually added'; // matches admin/crm.astro
  const STALE_DAYS = 30;

  type Lead = {
    id: string;
    created_at: string;
    status: string | null;
    scheduled_at: string | null;
    first_contacted_at: string | null;
    source_page: string | null;
    lead_magnet_id: string | null;
    lead_source: string | null;
    referral_partner_id: string | null;
    assigned_counselor_page_id: string | null;
    archived_at: string | null;
    gclid: string | null;
    gbraid: string | null;
    wbraid: string | null;
    utm_source: string | null;
    utm_medium: string | null;
  };
  type Partner = { id: string; status: string; next_follow_up: string | null; archived_at: string | null };
  type Activity = { activity_type: string; occurred_on: string };
  type Snapshot = { recorded_on: string; review_count: number; average_rating: number | null };
  type Business = {
    display_name: string;
    lead_auto_reply_enabled: boolean;
    collect_lead_source: boolean;
    google_review_url: string | null;
  };
  type Traffic = { thisMonth: { visits: number }; lastMonth: { visits: number } } | null;

  type Data = {
    leads: Lead[];
    counselors: { id: string; title: string }[];
    caseloads: Map<string, CounselorCaseload>;
    partners: Partner[];
    activities: Activity[];
    snapshots: Snapshot[];
    business: Business | null;
    keywords: { id: string }[];
    latestRanks: Map<string, number | null>;
    traffic: Traffic;
  };

  let data: Data | null = null;

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function monthBounds(offset: number) {
    const now = new Date();
    const start = new Date(now.getFullYear(), now.getMonth() - offset, 1);
    const end = new Date(now.getFullYear(), now.getMonth() - offset + 1, 1);
    const prevStart = new Date(now.getFullYear(), now.getMonth() - offset - 1, 1);
    // A month in progress is compared with the same point last month (Oct
    // 1-7 vs Sep 1-7), never a whole month, same as Today.
    let prevEnd = start;
    if (offset === 0) {
      const sameDay = new Date(prevStart.getFullYear(), prevStart.getMonth(), now.getDate(), now.getHours(), now.getMinutes());
      prevEnd = sameDay < start ? sameDay : start;
    }
    return { start, end, prevStart, prevEnd };
  }

  // Plain local calendar dates (YYYY-MM-DD) for comparing against `date`
  // columns, never toISOString() (UTC), which shifts the day in some zones.
  function localIso(d: Date): string {
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }

  const inRange = (iso: string | null, a: Date, b: Date) => {
    if (!iso) return false;
    const t = new Date(iso).getTime();
    return t >= a.getTime() && t < b.getTime();
  };

  let compareLabel = 'the month before';

  function change(current: number, previous: number, unit: string): { text: string; cls: string } {
    const diff = current - previous;
    if (diff === 0) return { text: `Same as ${compareLabel} (${previous} ${unit})`, cls: '' };
    return {
      text: `${diff > 0 ? '+' : ''}${diff} vs ${compareLabel} (${previous})`,
      cls: diff > 0 ? 'up' : 'down',
    };
  }

  function row(label: string, value: string, note = ''): string {
    return `<div class="m-row"><dt>${label}</dt><dd><b>${value}</b>${note ? `<small>${note}</small>` : ''}</dd></div>`;
  }

  // Same rules as the Leads dashboard's speed to lead: manual leads are
  // excluded, and a lead that left "New" before tracking existed is
  // excluded rather than counted as slow.
  function speedStats(leads: Lead[]) {
    const tracked = leads.filter((l) => l.source_page !== MANUAL_SOURCE && (l.first_contacted_at || (l.status ?? 'new') === 'new'));
    const hours = tracked.filter((l) => l.first_contacted_at).map((l) => hoursToFirstContact(l.created_at, l.first_contacted_at!));
    const eligible = tracked.filter((l) => l.first_contacted_at || Date.now() - new Date(l.created_at).getTime() >= 86_400_000);
    const within = eligible.filter((l) => l.first_contacted_at && hoursToFirstContact(l.created_at, l.first_contacted_at) <= 24).length;
    return { median: median(hours), withinPct: eligible.length ? Math.round((within / eligible.length) * 100) : null };
  }

  const isReferral = (l: Lead) => Boolean(l.referral_partner_id) || REFERRAL_LEAD_SOURCES.includes(l.lead_source ?? '');

  function render(offset: number) {
    if (!data) return;
    const { start, end, prevStart, prevEnd } = monthBounds(offset);
    const monthName = start.toLocaleDateString(undefined, { month: 'long', year: 'numeric' });
    compareLabel = offset === 0 ? 'this point last month' : 'the month before';
    document.getElementById('period-label')!.innerHTML =
      offset === 0 ? `<b>${monthName}</b> so far, compared with the same point last month.` : `<b>${monthName}</b>, compared with the month before.`;
    document.getElementById('report-title')!.textContent = `${data.business?.display_name ?? ''}: ${monthName} report`;
    document.getElementById('m-print-foot')!.textContent = `Prepared ${new Date().toLocaleDateString(undefined, { month: 'long', day: 'numeric', year: 'numeric' })}${offset === 0 ? ', partway through the month' : ''}.`;

    const realLeads = data.leads.filter((l) => !l.lead_magnet_id);
    const leadsNow = realLeads.filter((l) => inRange(l.created_at, start, end));
    const leadsPrev = realLeads.filter((l) => inRange(l.created_at, prevStart, prevEnd));
    const clients = realLeads.filter((l) => l.status === 'scheduled' && l.scheduled_at);
    const clientsNow = clients.filter((l) => inRange(l.scheduled_at, start, end));
    const clientsPrev = clients.filter((l) => inRange(l.scheduled_at, prevStart, prevEnd));

    // Headline
    document.getElementById('h-clients')!.textContent = String(clientsNow.length);
    const cc = change(clientsNow.length, clientsPrev.length, 'clients');
    Object.assign(document.getElementById('h-clients-change')!, { textContent: cc.text, className: `t-delta ${cc.cls}` });
    document.getElementById('h-leads')!.textContent = String(leadsNow.length);
    const lc = change(leadsNow.length, leadsPrev.length, 'inquiries');
    Object.assign(document.getElementById('h-leads-change')!, { textContent: lc.text, className: `t-delta ${lc.cls}` });

    const complete = data.counselors.filter((c) => {
      const r = data!.caseloads.get(c.id);
      return targetCaseload(r?.weekly_client_target) !== null && r?.current_active_clients != null;
    });
    let current = 0;
    let target = 0;
    for (const c of complete) {
      const r = data.caseloads.get(c.id)!;
      current += r.current_active_clients!;
      target += targetCaseload(r.weekly_client_target)!;
    }
    document.getElementById('h-caseload')!.textContent = target ? `${Math.round((current / target) * 100)}%` : '—';
    document.getElementById('h-caseload-sub')!.textContent = target
      ? `${current} of ${target} clients, ${Math.max(0, target - current)} open spots now`
      : 'Counselors haven’t set their caseloads yet';

    const speedNow = speedStats(leadsNow);
    const speedPrev = speedStats(leadsPrev);
    document.getElementById('h-speed')!.textContent = speedNow.median === null ? '—' : formatHours(speedNow.median);
    document.getElementById('h-speed-sub')!.textContent =
      speedNow.median === null
        ? 'None recorded yet. Timed from the form to the first move out of Waiting.'
        : `${speedNow.withinPct ?? 0}% contacted within 24 hours${speedPrev.median !== null ? ` (was ${formatHours(speedPrev.median)})` : ''}`;

    // 1. Get Found
    const visits = data.traffic ? (offset === 0 ? data.traffic.thisMonth.visits : data.traffic.lastMonth.visits) : null;
    const prevVisits = data.traffic && offset === 0 ? data.traffic.lastMonth.visits : null;
    const ranked = [...data.latestRanks.values()];
    const top3 = ranked.filter((p) => p !== null && p <= 3).length;
    const top10 = ranked.filter((p) => p !== null && p <= 10).length;
    const adLeadsNow = leadsNow.filter(isGoogleAdsLead).length;
    const searchLeadsNow = leadsNow.filter((l) => l.lead_source === 'google_search' || l.lead_source === 'google_maps').length;
    document.getElementById('found')!.innerHTML = [
      row('Website visits', visits === null ? 'Not connected' : visits.toLocaleString(), prevVisits !== null ? `${prevVisits.toLocaleString()} in all of last month` : ''),
      row(
        'Search rankings',
        ranked.length ? `${top3} in the top 3` : 'Tracking starts soon',
        ranked.length ? `${top10} of ${data.keywords.length} tracked searches on page 1` : `${data.keywords.length} target searches chosen`
      ),
      row('Inquiries who found you on Google', String(searchLeadsNow), 'Search or Maps, as they told us'),
      row('Inquiries from Google Ads', String(adLeadsNow)),
    ].join('');

    // 2. Get Chosen
    const snaps = [...data.snapshots].sort((a, b) => a.recorded_on.localeCompare(b.recorded_on));
    const latest = snaps.at(-1);
    const endIso = localIso(end);
    const startIso = localIso(start);
    const lastInPeriod = [...snaps].reverse().find((s) => s.recorded_on < endIso);
    const lastBefore = [...snaps].reverse().find((s) => s.recorded_on < startIso);
    const gained = lastInPeriod && lastBefore ? lastInPeriod.review_count - lastBefore.review_count : null;
    document.getElementById('chosen')!.innerHTML = [
      row('Visits that became inquiries', visits ? `${((leadsNow.length / visits) * 100).toFixed(1)}%` : '—', visits ? `${leadsNow.length} inquiries from ${visits.toLocaleString()} visits` : ''),
      row(
        'Google reviews',
        latest ? `${latest.review_count}${latest.average_rating ? ` · ${latest.average_rating}★` : ''}` : 'Not logged yet',
        gained !== null
          ? `${gained >= 0 ? '+' : ''}${gained} this month`
          : latest
            ? `As of ${new Date(latest.recorded_on + 'T00:00:00').toLocaleDateString(undefined, { month: 'short', day: 'numeric' })}`
            : 'Log your count on the Reviews page'
      ),
    ].join('');

    // 3. Get Referred
    const livePartners = data.partners.filter((p) => !p.archived_at);
    const activePartners = livePartners.filter((p) => p.status === 'active').length;
    const inProgress = livePartners.filter((p) => ['prospect', 'contacted', 'meeting'].includes(p.status)).length;
    const touches = data.activities.filter((a) => a.activity_type !== 'note' && a.occurred_on >= startIso && a.occurred_on < endIso).length;
    const refLeads = leadsNow.filter(isReferral).length;
    const refClients = clientsNow.filter(isReferral).length;
    document.getElementById('referred')!.innerHTML = [
      row('Active referral partners', String(activePartners), `${inProgress} more in progress`),
      row('Outreach this month', `${touches} touch${touches === 1 ? '' : 'es'}`, 'Emails, calls, visits, thank-yous'),
      row('Referred inquiries', String(refLeads)),
      row('Clients from referrals', String(refClients)),
    ].join('');

    // 4. Get Booked
    const bookedFromNow = leadsNow.filter((l) => l.status === 'scheduled').length;
    document.getElementById('booked')!.innerHTML = [
      row('Median time to first contact', speedNow.median === null ? '—' : formatHours(speedNow.median), speedNow.withinPct !== null ? `${speedNow.withinPct}% within 24 hours` : ''),
      row('Booking rate', leadsNow.length ? `${Math.round((bookedFromNow / leadsNow.length) * 100)}%` : '—', `${bookedFromNow} of ${leadsNow.length} inquiries this month are scheduled`),
      row('Automatic reply to new inquiries', data.business?.lead_auto_reply_enabled ? 'On' : 'Off'),
    ].join('');

    // 5. Watch It Work
    const bySource = new Map<string, number>();
    for (const l of clientsNow) {
      const key = isGoogleAdsLead(l) ? 'Google Ads' : leadSourceShortLabel(l.lead_source);
      bySource.set(key, (bySource.get(key) ?? 0) + 1);
    }
    const sources = [...bySource.entries()].sort((a, b) => b[1] - a[1]);
    const pct = target ? Math.round((current / target) * 100) : 0;
    // Same bands as the Caseload screen: green when (almost) full, amber
    // under 60% (send referrals here), accent in between.
    const ratio = target ? current / target : 0;
    const tone = ratio >= ALMOST_FULL_THRESHOLD ? ' good' : ratio < 0.6 ? ' low' : '';
    const top = sources[0]?.[1] ?? 1;
    document.getElementById('work')!.innerHTML = `
      <div class="m-work">
        <div>
          ${
            target
              ? `<div class="m-cap"><b class="a-num">${pct}%</b><span>full · ${current} of ${target} clients · ${Math.max(0, target - current)} open spots</span></div>
                 <div class="t-track m-track"><div class="t-fill${tone}" style="width:${percentFull(current, target)}%"></div></div>`
              : '<p class="i-hint">The caseload bar appears once counselors set their numbers on Counselor settings.</p>'
          }
        </div>
        <div>
          <p class="m-sub">Where this month's new clients came from</p>
          ${
            sources.length
              ? `<div class="t-bars">${sources
                  .map(([s, n]) => `<div class="t-bar"><span class="t-lbl">${escapeHtml(s)}</span><div class="t-track"><div class="t-fill" style="width:${Math.round((n / top) * 100)}%"></div></div><span class="a-num">${n}</span></div>`)
                  .join('')}</div>`
              : '<p class="i-hint">No new clients yet this month.</p>'
          }
        </div>
      </div>`;

    renderAttention();
  }

  // Always about right now, whichever month is being viewed.
  function renderAttention() {
    if (!data) return;
    const items: string[] = [];
    const add = (text: string, href: string | null, label: string) =>
      items.push(
        `<li><span class="m-dot" aria-hidden="true"></span><span class="m-attn-t">${text}</span>${
          href ? `<a href="${withBase(href)}" class="a-btn i-btn">${label}</a>` : `<span class="i-hint">${label}</span>`
        }</li>`
      );

    const waiting = data.leads.filter(
      (l) => !l.lead_magnet_id && !l.archived_at && (l.status ?? 'new') === 'new' && l.source_page !== MANUAL_SOURCE && Date.now() - new Date(l.created_at).getTime() > 86_400_000
    ).length;
    if (waiting) add(`${waiting} ${waiting === 1 ? 'inquiry has' : 'inquiries have'} waited more than 24 hours for a first contact.`, '/admin/crm', 'Open Inquiries');

    const today = localIso(new Date());
    const overdue = data.partners.filter((p) => !p.archived_at && p.status !== 'inactive' && p.next_follow_up && p.next_follow_up < today).length;
    if (overdue) add(`${overdue} referral partner follow-up${overdue === 1 ? ' is' : 's are'} overdue.`, '/admin/referral-partners', 'Referral partners');

    const unset = data.counselors.filter((c) => !data!.caseloads.get(c.id)?.weekly_client_target).length;
    const stale = data.counselors.filter((c) => {
      const r = data!.caseloads.get(c.id);
      return r?.weekly_client_target && daysSince(r.updated_at) > STALE_DAYS;
    }).length;
    if (unset) add(`${unset} counselor${unset === 1 ? " hasn't" : "s haven't"} set a caseload yet.`, '/admin/counselor-settings', 'Counselor settings');
    if (stale) add(`${stale} counselor${stale === 1 ? "'s" : "s'"} caseload numbers are over ${STALE_DAYS} days old.`, '/admin/counselor-settings', 'Counselor settings');

    const unassigned =
      data.counselors.length > 1
        ? data.leads.filter((l) => l.status === 'scheduled' && !l.assigned_counselor_page_id && !l.lead_magnet_id).length
        : 0;
    if (unassigned) add(`${unassigned} new client${unassigned === 1 ? " isn't" : "s aren't"} assigned to a counselor.`, '/admin/crm', 'Open Inquiries');

    const lastSnap = [...data.snapshots].sort((a, b) => b.recorded_on.localeCompare(a.recorded_on))[0];
    if (!lastSnap || (Date.now() - new Date(lastSnap.recorded_on).getTime()) / 86_400_000 > STALE_DAYS) {
      add(lastSnap ? `Google review count hasn't been logged in over ${STALE_DAYS} days.` : 'Google review count has never been logged.', '/admin/review-program', 'Reviews');
    }
    if (data.business && !data.business.lead_auto_reply_enabled) {
      add('Automatic reply to new inquiries is off.', '/admin/content/business-info', 'Turn it on');
    }
    if (data.business && !data.business.collect_lead_source) {
      add(`Your form doesn't ask "How did you hear about us?", so sources can't be measured.`, null, 'Ask your agency to turn it on');
    }

    document.getElementById('attention')!.hidden = items.length === 0;
    document.getElementById('attention-list')!.innerHTML = items.join('');
  }

  async function fetchTraffic(): Promise<Traffic> {
    try {
      const { data: sessionData } = await supabase.auth.getSession();
      const token = sessionData.session?.access_token;
      if (!token) return null;
      const response = await fetch(`${import.meta.env.PUBLIC_SUPABASE_URL}/functions/v1/get-traffic-stats`, {
        method: 'POST',
        headers: { apikey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY, Authorization: `Bearer ${token}` },
      });
      return response.ok ? ((await response.json()) as Traffic) : null;
    } catch {
      return null;
    }
  }

  async function load() {
    const [leads, counselors, caseloads, partners, activities, snapshots, business, keywords, ranks, traffic] = await Promise.all([
      supabase
        .from('leads')
        .select('id, created_at, status, scheduled_at, first_contacted_at, source_page, lead_magnet_id, lead_source, referral_partner_id, assigned_counselor_page_id, archived_at, gclid, gbraid, wbraid, utm_source, utm_medium'),
      supabase.from('pages').select('id, title').eq('page_type', 'Counselor Profile'),
      supabase.from('counselor_caseload').select('*'),
      supabase.from('referral_partners').select('id, status, next_follow_up, archived_at'),
      supabase.from('referral_partner_activities').select('activity_type, occurred_on'),
      supabase.from('review_snapshots').select('recorded_on, review_count, average_rating'),
      supabase.from('business').select('display_name, lead_auto_reply_enabled, collect_lead_source, google_review_url').single(),
      supabase.from('target_keywords').select('id').eq('status', 'active'),
      supabase.from('keyword_rank_snapshots').select('target_keyword_id, position, checked_at').order('checked_at', { ascending: false }),
      fetchTraffic(),
    ]);
    if (leads.error) {
      showError('Could not load: ' + leads.error.message);
      return;
    }
    // Latest position per keyword (rows arrive newest first).
    const latestRanks = new Map<string, number | null>();
    for (const r of (ranks.data ?? []) as { target_keyword_id: string; position: number | null }[]) {
      if (!latestRanks.has(r.target_keyword_id)) latestRanks.set(r.target_keyword_id, r.position);
    }
    data = {
      leads: (leads.data ?? []) as Lead[],
      counselors: (counselors.data ?? []) as { id: string; title: string }[],
      caseloads: new Map(((caseloads.data ?? []) as CounselorCaseload[]).map((c) => [c.counselor_page_id, c])),
      partners: (partners.data ?? []) as Partner[],
      activities: (activities.data ?? []) as Activity[],
      snapshots: (snapshots.data ?? []) as Snapshot[],
      business: (business.data as Business) ?? null,
      keywords: (keywords.data ?? []) as { id: string }[],
      latestRanks,
      traffic,
    };
    document.getElementById('loading')!.hidden = true;
    document.getElementById('overview')!.hidden = false;
    render(0);
  }

  function showError(message: string) {
    const el = document.getElementById('loading')!;
    el.hidden = false;
    el.innerHTML = `<div class="t-card t-s12"><div class="t-empty"><b>Couldn't build the report.</b>${escapeHtml(message)}</div></div>`;
  }

  // The month toggle drives the (hidden) select, which owns the value.
  const periodSelect = document.getElementById('period-select') as HTMLSelectElement;
  periodSelect.addEventListener('change', () => render(Number(periodSelect.value)));
  document.getElementById('m-period')!.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-offset]');
    if (!button) return;
    periodSelect.value = button.dataset.offset!;
    document.querySelectorAll('#m-period [data-offset]').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
    render(Number(periodSelect.value));
  });
  document.getElementById('print-report')!.addEventListener('click', () => window.print());

  // Never leave the page stuck on "Loading..." if something unexpected
  // throws: say so, and log the real error for debugging.
  async function safeLoad() {
    try {
      await load();
    } catch (err) {
      console.error('overview: failed to build dashboard', err);
      showError('Something went wrong. Try reloading the page.');
    }
  }

  initAdminAuth(safeLoad, { allowedRoles: ['owner', 'agency'] });
</script>
