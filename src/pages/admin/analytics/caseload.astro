---
// Caseload (admin redesign phase 3, 2026-10-06): the outcome the rest of
// the marketing exists for.
//
// Two sources, kept distinct:
//   - How full each counselor is: counselor_caseload.current_active_clients
//     vs. their target caseload (weekly target x 1.5, lib/caseload.ts).
//     Booking a client adds one automatically (0074); clients finishing
//     treatment are counted down here with the minus button, since an
//     inquiry never records when therapy ends.
//   - New clients from marketing: leads marked Scheduled, dated by
//     scheduled_at, credited by assigned_counselor_page_id.
//
// Owners/agency see the practice and every counselor. A linked counselor
// sees "My caseload": only their own card (RLS on counselor_caseload and
// leads, plus explicit filters here).
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { withBase } from '../../../lib/url';
---

<AdminLayout title="Caseload | Admin" current="analytics-caseload">
  <p class="i-intro" id="c-intro">How full each counselor is, and where new clients are coming from.</p>

  <div class="t-grid" id="c-loading" aria-hidden="true">
    <div class="t-skel t-s5" style="height:300px"></div>
    <div class="t-skel t-s7" style="height:300px"></div>
    <div class="t-skel t-s12" style="height:220px"></div>
  </div>

  <div id="c-empty" class="t-card" hidden>
    <div class="t-empty">
      <b id="c-empty-title">No caseload set up yet</b>
      <span id="c-empty-body"></span><br />
      <a class="t-act" href={withBase('/admin/counselor-settings')}>Go to Counselor settings</a>
    </div>
  </div>

  <div id="c-body" hidden>
    <div class="t-grid" style="margin-top:0">
      <div class="t-card t-s5 t-ringcard" id="c-practice">
        <h2 id="c-ring-title">Practice caseload</h2>
        <div class="t-ring" role="img" id="c-ring-label">
          <svg viewBox="0 0 168 168"><circle class="trk" cx="84" cy="84" r="76"></circle><circle class="val" cx="84" cy="84" r="76" style="stroke-dasharray:477.5;stroke-dashoffset:477.5"></circle></svg>
          <div class="mid"><span class="a-num" id="c-pct">0%</span><small>full</small></div>
        </div>
        <div class="t-sub" id="c-sub"></div>
        <p class="i-hint c-missing" id="c-missing" hidden></p>
      </div>
      <div class="t-s7 t-kpis" id="c-kpis"></div>
    </div>

    <div class="t-card c-section" id="c-team-card">
      <h2 id="c-team-title">By counselor<span class="t-aside">Use − when a client finishes. Booking a client adds one automatically.</span></h2>
      <div class="c-team" id="c-team"></div>
    </div>

    <div class="t-grid">
      <div class="t-card t-s7">
        <h2>Where new clients came from
          <span class="t-aside c-range" role="group" aria-label="Time range">
            <button type="button" data-range="90" aria-pressed="true">90 days</button>
            <button type="button" data-range="all" aria-pressed="false">All time</button>
          </span>
        </h2>
        <div id="c-sources"></div>
      </div>
      <div class="t-card t-s5">
        <h2>How it's counted</h2>
        <ul class="c-notes">
          <li><b>A new client</b> is an inquiry marked Scheduled, counted in the month it was marked.</li>
          <li><b>Caseload</b> goes up by one automatically when an inquiry is marked Scheduled, and back down if it's moved out of Scheduled.</li>
          <li><b>When a client finishes</b>, press − on that counselor's card. Nothing else knows when therapy ends.</li>
          <li><b>Full caseload</b> is clients per week × 1.5, because some clients come every other week or monthly.</li>
        </ul>
        <p class="i-hint" id="c-unassigned" hidden></p>
      </div>
    </div>
  </div>
  <div class="t-toast" id="t-toast" role="status" aria-live="polite"></div>
</AdminLayout>

<script>
  import { supabase, initAdminAuth, type AdminUser } from '../../../lib/adminAuth';
  import { withBase } from '../../../lib/url';
  import { leadSourceShortLabel } from '../../../lib/leadSource';
  import { daysSince, targetCaseload, ALMOST_FULL_THRESHOLD, type CounselorCaseload } from '../../../lib/caseload';

  // A count no one has confirmed in this long gets flagged.
  const STALE_AFTER_DAYS = 30;
  const DAY = 86_400_000;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Lead = { id: string; status: string | null; scheduled_at: string | null; created_at: string; assigned_counselor_page_id: string | null; lead_magnet_id: string | null; lead_source: string | null };
  type Counselor = { id: string; title: string; availability_status: string | null };

  const $ = (id: string) => document.getElementById(id)!;
  const esc = (v: string) => {
    const d = document.createElement('div');
    d.textContent = v;
    return d.innerHTML;
  };
  const initials = (t: string) => t.split(',')[0].split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0].toUpperCase()).join('');
  function countUp(el: HTMLElement, to: number, suffix = '', dur = 1100, from = 0) {
    if (reduced) return void (el.textContent = Math.round(to) + suffix);
    const t0 = performance.now();
    const step = (t: number) => {
      const k = Math.min((t - t0) / dur, 1);
      el.textContent = Math.round(from + (to - from) * (1 - Math.pow(1 - k, 3))) + suffix;
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }
  let toastTimer: number | undefined;
  function toast(title: string, sub: string, error = false) {
    const t = $('t-toast');
    t.classList.toggle('err', error);
    t.innerHTML = `<span class="t-ok">${error ? '!' : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7"/></svg>'}</span><span><b>${esc(title)}</b><small>${esc(sub)}</small></span>`;
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => t.classList.remove('show'), 3800);
  }
  function spotsText(open: number): string {
    if (open > 0) return `${open} open spot${open === 1 ? '' : 's'}`;
    if (open === 0) return 'Full';
    return `${-open} over full`;
  }
  function band(current: number, target: number): { cls: string; note: string } {
    const r = current / target;
    if (r >= 1) return { cls: 'good', note: 'Full' };
    if (r >= ALMOST_FULL_THRESHOLD) return { cls: 'good', note: 'Almost full' };
    if (r < 0.6) return { cls: 'low', note: 'Send referrals here' };
    return { cls: '', note: 'Room to grow' };
  }
  const AVAIL: Record<string, string> = { accepting: 'Accepting new clients', almost_full: 'Almost full', not_accepting: 'Not accepting' };

  let counselors: Counselor[] = [];
  let caseloads = new Map<string, CounselorCaseload>();
  let leads: Lead[] = [];
  let counselorMode = false;
  let range: '90' | 'all' = '90';

  function practiceTotals() {
    let cur = 0;
    let full = 0;
    const missing: Counselor[] = [];
    for (const c of counselors) {
      const row = caseloads.get(c.id);
      const target = targetCaseload(row?.weekly_client_target);
      if (target === null || row?.current_active_clients == null) {
        missing.push(c);
        continue;
      }
      cur += row.current_active_clients;
      full += target;
    }
    return { cur, full, missing };
  }

  // The percentage moves from where it was, not from zero, after a +/-.
  let shownPct = 0;
  function paintRing() {
    const { cur, full, missing } = practiceTotals();
    const pct = full ? Math.round((cur / full) * 100) : 0;
    const C = 2 * Math.PI * 76;
    const val = document.querySelector<SVGCircleElement>('#c-practice .val')!;
    val.style.strokeDasharray = String(C);
    val.style.strokeDashoffset = String(C * (1 - Math.min(1, full ? cur / full : 0)));
    countUp($('c-pct'), pct, '%', shownPct ? 700 : 1400, shownPct);
    shownPct = pct;
    $('c-ring-label').setAttribute('aria-label', `Caseload ${pct} percent full`);
    $('c-sub').innerHTML = `<b>${cur}</b> of ${full} clients · <b>${Math.max(0, full - cur)}</b> open ${full - cur === 1 ? 'spot' : 'spots'}`;
    const m = $('c-missing');
    m.hidden = counselorMode || missing.length === 0;
    m.textContent = `Not counted yet (no weekly target set): ${missing.map((c) => c.title.split(',')[0]).join(', ')}.`;
  }

  function renderKpis() {
    const real = leads.filter((l) => !l.lead_magnet_id);
    const clients = real.filter((l) => l.status === 'scheduled' && l.scheduled_at);
    const now = new Date();
    const m0 = new Date(now.getFullYear(), now.getMonth(), 1);
    const mPrev = new Date(now.getFullYear(), now.getMonth() - 1, 1);
    const prevCut = new Date(Math.min(mPrev.getTime() + (now.getTime() - m0.getTime()), m0.getTime()));
    const inRange = (iso: string, a: Date, b: Date) => new Date(iso) >= a && new Date(iso) < b;
    const thisMonth = clients.filter((l) => new Date(l.scheduled_at!) >= m0).length;
    const samePoint = clients.filter((l) => inRange(l.scheduled_at!, mPrev, prevCut)).length;
    const lastMonth = clients.filter((l) => inRange(l.scheduled_at!, mPrev, m0)).length;
    const rate = real.length ? Math.round((clients.length / real.length) * 100) : null;
    const diff = thisMonth - samePoint;
    const kpis = [
      { l: 'New clients so far this month', v: thisMonth, d: diff === 0 ? 'Same as this point last month' : `${diff > 0 ? '+' : ''}${diff} vs this point last month`, cls: diff > 0 ? 'up' : diff < 0 ? 'down' : '' },
      { l: 'New clients last month', v: lastMonth, d: mPrev.toLocaleDateString('en-US', { month: 'long' }), cls: '' },
      { l: 'Inquiries that became clients', v: rate, suf: '%', d: `${clients.length} of ${real.length}, all time`, cls: '' },
      { l: counselorMode ? 'Your weekly client target' : 'Counselors with a caseload set', v: counselorMode ? caseloads.get(counselors[0]?.id)?.weekly_client_target ?? null : counselors.length - practiceTotals().missing.length, suf: counselorMode ? ' a week' : ` of ${counselors.length}`, d: counselorMode ? 'Change it on Counselor settings' : 'Set on Counselor settings', cls: '' },
    ];
    $('c-kpis').innerHTML = kpis
      .map((k, i) => `<div class="t-kpi"><span class="t-lbl">${k.l}</span><span class="t-v a-num" data-k="${i}">${k.v == null ? '—' : '0'}</span><span class="t-delta ${k.cls}">${esc(k.d)}</span></div>`)
      .join('');
    kpis.forEach((k, i) => {
      if (k.v != null) countUp(document.querySelector<HTMLElement>(`[data-k="${i}"]`)!, k.v, k.suf ?? '');
    });
  }

  function cardHtml(c: Counselor, newThisMonth: number): string {
    const row = caseloads.get(c.id);
    const target = targetCaseload(row?.weekly_client_target);
    const cur = row?.current_active_clients ?? null;
    const name = esc(c.title.split(',')[0]);
    if (target === null || cur === null) {
      return `<div class="c-card c-unset"><div class="t-who c-who"><span class="t-initials">${initials(c.title)}</span><div><b>${name}</b><small>${newThisMonth} new this month</small></div></div>
        <p class="i-faint">No weekly target set yet.</p><a class="t-act" href="${withBase('/admin/counselor-settings')}">Set caseload</a></div>`;
    }
    const b = band(cur, target);
    const pct = Math.min(100, Math.round((cur / target) * 100));
    const age = daysSince(row!.updated_at);
    const stale = age > STALE_AFTER_DAYS;
    const avail = c.availability_status ? AVAIL[c.availability_status] : null;
    const mismatch = c.availability_status === 'accepting' && cur / target >= ALMOST_FULL_THRESHOLD;
    return `<div class="c-card" data-c="${c.id}">
      <div class="c-who"><span class="t-initials">${initials(c.title)}</span><div><b>${name}</b><small>${newThisMonth} new this month${avail ? ` · ${esc(avail)}` : ''}</small></div><span class="c-note ${b.cls}">${b.note}</span></div>
      <div class="c-count"><span class="a-num c-big" data-cur="${c.id}">${cur}</span><span class="c-of">of ${target}</span>
        <span class="c-step" role="group" aria-label="Adjust ${name}'s caseload">
          <button type="button" data-step="-1" data-id="${c.id}" aria-label="One client finished">−</button>
          <button type="button" data-step="1" data-id="${c.id}" aria-label="Add one client">+</button>
        </span>
      </div>
      <div class="t-track"><div class="t-fill ${b.cls}" data-w="${pct}"></div></div>
      <div class="t-meta c-meta"><span data-open="${c.id}">${spotsText(target - cur)}</span><span class="${stale ? 'i-late' : ''}">${stale ? `Confirmed ${age} days ago` : `Confirmed ${age === 0 ? 'today' : `${age} day${age === 1 ? '' : 's'} ago`}`}</span></div>
      ${mismatch ? `<p class="c-flag">${cur >= target ? 'Full' : 'Nearly full'}, but ${counselorMode ? 'your' : 'their'} page still says "Accepting new clients".</p>` : ''}
    </div>`;
  }

  function renderTeam() {
    const m0 = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
    const newBy = new Map<string, number>();
    for (const l of leads) {
      if (l.status === 'scheduled' && l.scheduled_at && new Date(l.scheduled_at) >= m0 && l.assigned_counselor_page_id) {
        newBy.set(l.assigned_counselor_page_id, (newBy.get(l.assigned_counselor_page_id) ?? 0) + 1);
      }
    }
    const solo = counselors.length === 1;
    if (solo && !counselorMode) newBy.set(counselors[0].id, leads.filter((l) => l.status === 'scheduled' && l.scheduled_at && new Date(l.scheduled_at) >= m0).length);
    $('c-team').innerHTML = counselors.map((c) => cardHtml(c, newBy.get(c.id) ?? 0)).join('');
    setTimeout(() => document.querySelectorAll<HTMLElement>('#c-team [data-w]').forEach((el) => (el.style.width = `${el.dataset.w}%`)), 120);

    if (!counselorMode && !solo) {
      const unassigned = leads.filter((l) => l.status === 'scheduled' && !l.assigned_counselor_page_id && !l.lead_magnet_id).length;
      const u = $('c-unassigned');
      u.hidden = unassigned === 0;
      u.innerHTML = `${unassigned} client${unassigned === 1 ? ' has' : 's have'} no counselor assigned, so ${unassigned === 1 ? "it isn't" : "they aren't"} on anyone's caseload. <a class="a-link" href="${withBase('/admin/crm')}">Assign in Inquiries</a>`;
    }
  }

  function renderSources() {
    const cutoff = range === '90' ? Date.now() - 90 * DAY : 0;
    const counts = new Map<string, number>();
    for (const l of leads) {
      if (l.lead_magnet_id || l.status !== 'scheduled' || !l.scheduled_at || new Date(l.scheduled_at).getTime() < cutoff) continue;
      const k = leadSourceShortLabel(l.lead_source);
      counts.set(k, (counts.get(k) ?? 0) + 1);
    }
    const rows = [...counts.entries()].sort((a, b) => b[1] - a[1]);
    $('c-sources').innerHTML = rows.length
      ? `<div class="t-bars">${rows.map(([l, n]) => `<div class="t-bar"><span class="t-lbl">${esc(l)}</span><div class="t-track"><div class="t-fill" data-w="${Math.round((n / rows[0][1]) * 100)}"></div></div><span class="a-num">${n}</span></div>`).join('')}</div>`
      : `<div class="t-empty"><b>No new clients ${range === '90' ? 'in the last 90 days' : 'yet'}.</b>Each one's source shows here once an inquiry is marked Scheduled.</div>`;
    setTimeout(() => document.querySelectorAll<HTMLElement>('#c-sources [data-w]').forEach((el) => (el.style.width = `${el.dataset.w}%`)), 60);
  }

  async function step(id: string, delta: number, btn: HTMLButtonElement) {
    const row = caseloads.get(id);
    if (!row || row.current_active_clients == null) return;
    const next = Math.max(0, Math.min(200, row.current_active_clients + delta));
    if (next === row.current_active_clients) return;
    btn.disabled = true;
    const now = new Date().toISOString();
    const { error } = await supabase.from('counselor_caseload').update({ current_active_clients: next, updated_at: now }).eq('counselor_page_id', id);
    btn.disabled = false;
    if (error) return toast("That didn't save", error.message, true);
    row.current_active_clients = next;
    row.updated_at = now;
    const c = counselors.find((x) => x.id === id)!;
    renderTeam();
    paintRing();
    toast(
      delta < 0 ? 'Client finished' : 'Client added',
      `${counselorMode ? 'Your' : `${c.title.split(',')[0]}'s`} caseload is now ${next} of ${targetCaseload(row.weekly_client_target)}.`
    );
  }

  function render() {
    $('c-loading').hidden = true;
    if (counselors.length === 0) {
      $('c-empty').hidden = false;
      $('c-empty-body').textContent = counselorMode ? "Your login isn't linked to a counselor page yet. Ask the practice owner." : 'Caseload tracking needs at least one counselor profile page.';
      return;
    }
    if (practiceTotals().full === 0 && counselors.every((c) => targetCaseload(caseloads.get(c.id)?.weekly_client_target) === null)) {
      $('c-empty').hidden = false;
      $('c-empty-body').textContent = counselorMode || counselors.length === 1
        ? 'Enter your clients per week and current clients on Counselor settings to see your caseload here.'
        : 'Each counselor enters their clients per week and current clients on Counselor settings. The practice total shows here once at least one has.';
      return;
    }
    $('c-body').hidden = false;
    if (counselorMode) {
      $('c-ring-title').textContent = 'Your caseload';
      $('c-team-title').firstChild!.textContent = 'Your count';
    } else if (counselors.length === 1) {
      $('c-ring-title').textContent = 'Your caseload';
      $('c-team-title').firstChild!.textContent = 'Your count';
    }
    requestAnimationFrame(() => {
      paintRing();
      renderKpis();
      renderTeam();
      renderSources();
    });
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const s = t.closest<HTMLButtonElement>('[data-step]');
    if (s) return void step(s.dataset.id!, Number(s.dataset.step), s);
    const r = t.closest<HTMLButtonElement>('[data-range]');
    if (r) {
      range = r.dataset.range as '90' | 'all';
      document.querySelectorAll('[data-range]').forEach((b) => b.setAttribute('aria-pressed', String(b === r)));
      renderSources();
    }
  });

  async function load(user: AdminUser) {
    if (user.role === 'staff') {
      if (!user.linked_counselor_page_id) return void (window.location.href = withBase('/admin/today'));
      counselorMode = true;
      document.querySelector('.a-title')!.textContent = 'My caseload';
      $('c-intro').textContent = 'How full you are, and where your new clients came from.';
    }
    const mine = user.linked_counselor_page_id;
    let pagesQ = supabase.from('pages').select('id, title, availability_status').eq('page_type', 'Counselor Profile').order('title');
    let caseQ = supabase.from('counselor_caseload').select('*');
    let leadsQ = supabase.from('leads').select('id, status, scheduled_at, created_at, assigned_counselor_page_id, lead_magnet_id, lead_source');
    if (counselorMode && mine) {
      pagesQ = pagesQ.eq('id', mine);
      caseQ = caseQ.eq('counselor_page_id', mine);
      leadsQ = leadsQ.eq('assigned_counselor_page_id', mine);
    }
    const [p, c, l] = await Promise.all([pagesQ, caseQ, leadsQ]);
    if (l.error) {
      $('c-loading').hidden = true;
      $('c-empty').hidden = false;
      $('c-empty-title').textContent = "Couldn't load your caseload";
      $('c-empty-body').textContent = 'Try reloading the page.';
      return;
    }
    counselors = (p.data ?? []) as Counselor[];
    caseloads = new Map(((c.data ?? []) as CounselorCaseload[]).map((r) => [r.counselor_page_id, r]));
    leads = (l.data ?? []) as Lead[];
    render();
  }

  initAdminAuth(load, { allowedRoles: ['owner', 'agency', 'staff'] });
</script>
