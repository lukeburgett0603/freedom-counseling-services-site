---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<!--
  Owner/agency only, same as SEO Insights and Leads — a staff/counselor
  login never sees this (see ROLE_NAV_ACCESS in adminAuth.ts). See
  CLAUDE.md's "Blog analytics" section for the full design reasoning.
  Moved here from admin/blog-analytics.astro as part of the "Analytics
  Dashboards" nav reorg (see CLAUDE.md) — same content, just grouped
  under the new nav folder alongside Leads/Traffic/GBP/SEO.

  Unlike Tier 2/3/4's own "hide the whole section if the integration
  isn't configured" discipline, this page shows partial data on purpose:
  leads-per-post and CTA-clicks-per-post are both already-collected,
  zero-external-dependency data (leads.source_page, page_cta_clicks) —
  only the Pageviews column depends on Cloudflare being configured. A
  missing/failed Cloudflare call degrades just that one column to "—"
  rather than hiding real, working data the rest of the page has.
-->
<AdminLayout title="Blog analytics | Admin" current="analytics-blog">
  <p class="mb-6 text-sm text-slate-500">Last 30 days.</p>

  <div class="mb-8 grid gap-4 sm:grid-cols-3">
    <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Blog pageviews</p>
      <p id="stat-pageviews" class="mt-1 font-[family-name:var(--font-heading)] text-3xl font-extrabold text-brand-ink">—</p>
    </div>
    <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Leads from blog posts</p>
      <p id="stat-leads" class="mt-1 font-[family-name:var(--font-heading)] text-3xl font-extrabold text-brand-ink">—</p>
    </div>
    <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">CTA clicks</p>
      <p id="stat-clicks" class="mt-1 font-[family-name:var(--font-heading)] text-3xl font-extrabold text-brand-ink">—</p>
    </div>
  </div>

  <p id="pageviews-not-configured" class="mb-4 hidden text-sm text-amber-700">
    Traffic analytics isn't configured for this site, so the Pageviews column can't be filled in — everything else on this
    page (leads, CTA clicks) is real data either way.
  </p>

  <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
    <p class="mb-4 text-xs font-semibold uppercase tracking-wide text-slate-500">By post</p>
    <div class="overflow-x-auto rounded-lg border border-slate-200">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-slate-200 bg-slate-50">
          <tr>
            <th class="px-4 py-3 font-semibold">Title</th>
            <th class="px-4 py-3 font-semibold">Published</th>
            <th class="px-4 py-3 font-semibold">Pageviews</th>
            <th class="px-4 py-3 font-semibold">CTA clicks</th>
            <th class="px-4 py-3 font-semibold">Leads</th>
            <th class="px-4 py-3 font-semibold">Conversion</th>
          </tr>
        </thead>
        <tbody id="posts-table-body"></tbody>
      </table>
    </div>
    <p id="posts-empty" class="hidden px-1 py-4 text-sm text-slate-500">No published blog posts yet.</p>
  </div>
</AdminLayout>

<script>
  import { supabase, initAdminAuth } from '../../../lib/adminAuth';

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  // Cloudflare's requestPath and this app's own stored slug formats don't
  // agree on leading/trailing slashes (see CLAUDE.md's "Blog analytics"
  // section) — normalize both sides to the same bare form before matching.
  function normalizeSlug(value: string): string {
    return value.replace(/^\/+|\/+$/g, '').toLowerCase();
  }

  interface BlogPostRow {
    id: string;
    title: string;
    slug: string;
    date_published: string | null;
  }

  const statPageviews = document.getElementById('stat-pageviews')!;
  const statLeads = document.getElementById('stat-leads')!;
  const statClicks = document.getElementById('stat-clicks')!;
  const pageviewsNotConfigured = document.getElementById('pageviews-not-configured')!;
  const postsTableBody = document.getElementById('posts-table-body')!;
  const postsEmpty = document.getElementById('posts-empty')!;

  function renderTable(
    posts: BlogPostRow[],
    pageviewsBySlug: Map<string, number> | null,
    leadsBySlug: Map<string, number>,
    clicksByPageId: Map<string, number>
  ) {
    postsEmpty.classList.toggle('hidden', posts.length > 0);
    postsTableBody.innerHTML = posts
      .map((post) => {
        const pageviews = pageviewsBySlug?.get(normalizeSlug(post.slug)) ?? 0;
        const leads = leadsBySlug.get(normalizeSlug(post.slug)) ?? 0;
        const clicks = clicksByPageId.get(post.id) ?? 0;
        const conversion = pageviews > 0 ? `${((leads / pageviews) * 100).toFixed(1)}%` : '—';
        return `
      <tr class="border-b border-slate-100 last:border-0">
        <td class="px-4 py-3 font-semibold text-brand-ink">${escapeHtml(post.title)}</td>
        <td class="px-4 py-3 whitespace-nowrap">${post.date_published ? new Date(post.date_published + 'T00:00:00').toLocaleDateString() : '—'}</td>
        <td class="px-4 py-3">${pageviewsBySlug ? pageviews.toLocaleString() : '—'}</td>
        <td class="px-4 py-3">${clicks.toLocaleString()}</td>
        <td class="px-4 py-3">${leads.toLocaleString()}</td>
        <td class="px-4 py-3">${conversion}</td>
      </tr>`;
      })
      .join('');
  }

  async function loadPageviews(): Promise<Map<string, number> | null> {
    try {
      const { data: sessionData } = await supabase.auth.getSession();
      const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
      const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
      const response = await fetch(`${SUPABASE_URL}/functions/v1/get-blog-analytics`, {
        method: 'POST',
        headers: {
          apikey: SUPABASE_ANON_KEY,
          Authorization: `Bearer ${sessionData.session?.access_token}`,
          'Content-Type': 'application/json',
        },
      });
      if (!response.ok) return null;
      const result = await response.json();
      const map = new Map<string, number>();
      for (const row of result.byPath ?? []) {
        const key = normalizeSlug(row.path);
        map.set(key, (map.get(key) ?? 0) + row.pageviews);
      }
      return map;
    } catch {
      return null;
    }
  }

  async function loadLeadsBySlug(): Promise<Map<string, number>> {
    // Real leads only (lead_magnet_id null) — a guide download is a
    // different, lower-intent signal, same distinction this project's
    // dashboards already draw elsewhere (see CLAUDE.md's "Contacts vs.
    // leads"). Raw rows, tallied client-side — the same "compute from
    // data already being fetched" pattern the original leads dashboard
    // established, proportionate at this data volume.
    const thirtyDaysAgo = new Date();
    thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
    const { data } = await supabase
      .from('leads')
      .select('source_page')
      .is('lead_magnet_id', null)
      .gte('created_at', thirtyDaysAgo.toISOString());
    const map = new Map<string, number>();
    for (const row of data ?? []) {
      if (!row.source_page) continue;
      const key = normalizeSlug(row.source_page);
      map.set(key, (map.get(key) ?? 0) + 1);
    }
    return map;
  }

  async function loadClicksByPageId(): Promise<Map<string, number>> {
    const thirtyDaysAgo = new Date();
    thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
    const { data } = await supabase.from('page_cta_clicks').select('page_id').gte('created_at', thirtyDaysAgo.toISOString());
    const map = new Map<string, number>();
    for (const row of data ?? []) {
      map.set(row.page_id, (map.get(row.page_id) ?? 0) + 1);
    }
    return map;
  }

  async function loadPosts(): Promise<BlogPostRow[]> {
    const { data } = await supabase
      .from('pages')
      .select('id, title, slug, date_published')
      .eq('page_type', 'Blog Post')
      .eq('status', 'content-complete');
    return (data as BlogPostRow[]) ?? [];
  }

  initAdminAuth(
    async () => {
      const [posts, pageviewsBySlug, leadsBySlug, clicksByPageId] = await Promise.all([
        loadPosts(),
        loadPageviews(),
        loadLeadsBySlug(),
        loadClicksByPageId(),
      ]);

      pageviewsNotConfigured.classList.toggle('hidden', pageviewsBySlug !== null);

      const totalPageviews = posts.reduce((sum, p) => sum + (pageviewsBySlug?.get(normalizeSlug(p.slug)) ?? 0), 0);
      const totalLeads = posts.reduce((sum, p) => sum + (leadsBySlug.get(normalizeSlug(p.slug)) ?? 0), 0);
      const totalClicks = posts.reduce((sum, p) => sum + (clicksByPageId.get(p.id) ?? 0), 0);

      statPageviews.textContent = pageviewsBySlug ? totalPageviews.toLocaleString() : '—';
      statLeads.textContent = totalLeads.toLocaleString();
      statClicks.textContent = totalClicks.toLocaleString();

      // Highest pageviews first — the most useful default ordering for
      // "how are my posts doing," matching the ask directly. Posts with
      // no pageview data (not configured) keep their natural fetch order
      // instead of an arbitrary all-zero sort.
      const sorted = pageviewsBySlug
        ? [...posts].sort((a, b) => (pageviewsBySlug.get(normalizeSlug(b.slug)) ?? 0) - (pageviewsBySlug.get(normalizeSlug(a.slug)) ?? 0))
        : posts;

      renderTable(sorted, pageviewsBySlug, leadsBySlug, clicksByPageId);
    },
    { allowedRoles: ['owner', 'agency'] }
  );
</script>
