---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<!--
  Split out of the old combined admin/leads.astro into its own dashboard
  under "Analytics Dashboards" — see AdminLayout.astro and CLAUDE.md's
  "Analytics Dashboards reorg" section. Tier 4 — Google Business Profile,
  sourced from the get-gbp-insights Edge Function (see CLAUDE.md's
  "Client dashboard" section). Hidden entirely (not shown empty), not
  just on a site with no google_business_location_id/OAuth credentials
  configured but on ANY failure calling the function, same graceful-
  degrade discipline as every other tier.

  Redesigned in phase 3 of the admin redesign (2026-10-07): views and
  actions (calls, website clicks, directions) as separate stories, the
  share of viewers who acted, Maps vs Search, and the daily views chart
  (shared src/lib/areaChart.ts). This month is month to date while the
  function only returns last month as a whole, so last month is shown as
  a plain total, never as a percent change.
-->
<AdminLayout title="Google profile | Admin" current="analytics-gbp">
  <p class="i-intro">Your listing in Google Maps and search: how many people see it, and how many call, visit your website, or get directions.</p>

  <div class="t-grid m-loading" id="g-loading" aria-hidden="true">
    <div class="t-skel t-s12" style="height:110px"></div>
    <div class="t-skel t-s12" style="height:260px"></div>
  </div>

  <section id="gbp-empty" class="t-card" hidden>
    <div class="t-empty">
      <b>Google profile insights aren't connected yet</b>
      These numbers come straight from your Google Business Profile. Ask your agency to connect it.
    </div>
  </section>

  <div id="gbp-section" hidden>
    <div class="t-grid g-top">
      <section class="t-card t-s5 g-views">
        <h2>People who saw your profile<span class="t-aside">This month</span></h2>
        <span class="v-big a-num" id="g-views">—</span>
        <p class="i-hint" id="g-views-last"></p>
        <div class="g-split" aria-hidden="true"><span class="g-maps" id="g-split-maps"></span><span class="g-search" id="g-split-search"></span></div>
        <div class="g-split-legend">
          <span><i class="g-key g-maps"></i>Google Maps <b class="a-num" id="gbp-map-views">—</b></span>
          <span><i class="g-key g-search"></i>Google Search <b class="a-num" id="gbp-search-views">—</b></span>
        </div>
        <p class="i-hint" hidden><span id="gbp-map-views-last"></span><span id="gbp-search-views-last"></span></p>
      </section>

      <section class="t-card t-s7">
        <h2>People who took action<span class="t-aside" id="g-rate"></span></h2>
        <div class="g-actions">
          <div class="g-act">
            <span class="g-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg></span>
            <div><span>Calls</span><b class="a-num" id="gbp-call-clicks">—</b><small id="gbp-call-clicks-last"></small></div>
          </div>
          <div class="g-act">
            <span class="g-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg></span>
            <div><span>Website clicks</span><b class="a-num" id="gbp-website-clicks">—</b><small id="gbp-website-clicks-last"></small></div>
          </div>
          <div class="g-act">
            <span class="g-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></svg></span>
            <div><span>Direction requests</span><b class="a-num" id="gbp-direction-requests">—</b><small id="gbp-direction-requests-last"></small></div>
          </div>
        </div>
        <p class="i-hint g-note">Calls from your profile skip your website entirely, so they won't show up in Inquiries unless someone logs them.</p>
      </section>
    </div>

    <section class="t-card w-chart-card q-section">
      <h2>Profile views per day<span class="t-aside" id="gbp-chart-peak"></span></h2>
      <div class="w-chart" id="gbp-chart">
        <div class="w-tip" id="g-tip" hidden></div>
      </div>
      <div class="v-axis" id="g-axis"></div>
      <p class="i-hint g-note">Maps and Search combined. Google's numbers usually run a few days behind.</p>
    </section>
  </div>
</AdminLayout>

<script>
  import { supabase, initAdminAuth } from '../../../lib/adminAuth';
  import { localDay, renderAreaChart, shortDay } from '../../../lib/areaChart';

  type GbpMonthSummary = {
    mapViews: number;
    searchViews: number;
    websiteClicks: number;
    callClicks: number;
    directionRequests: number;
  };
  type GbpInsights = {
    thisMonth: GbpMonthSummary;
    lastMonth: GbpMonthSummary;
    byDay: { date: string; value: number }[];
  };

  const set = (id: string, text: string) => (document.getElementById(id)!.textContent = text);

  async function loadGbpInsights() {
    const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
    const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    const empty = () => {
      document.getElementById('g-loading')!.hidden = true;
      document.getElementById('gbp-empty')!.hidden = false;
    };
    try {
      const { data: sessionData } = await supabase.auth.getSession();
      const accessToken = sessionData.session?.access_token;
      if (!accessToken) return empty();

      const response = await fetch(`${SUPABASE_URL}/functions/v1/get-gbp-insights`, {
        method: 'POST',
        headers: { apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${accessToken}` },
      });
      if (!response.ok) return empty();
      const stats = (await response.json()) as GbpInsights;
      const t = stats.thisMonth;
      const l = stats.lastMonth;
      const lastMonthName = new Date(new Date().getFullYear(), new Date().getMonth() - 1, 1).toLocaleDateString(undefined, { month: 'long' });
      // This month is month to date; last month is only available whole,
      // so it's shown as a total rather than a misleading percent change.
      const last = (n: number) => `${n.toLocaleString()} in all of ${lastMonthName}`;

      const views = t.mapViews + t.searchViews;
      set('g-views', views.toLocaleString());
      set('g-views-last', last(l.mapViews + l.searchViews));
      set('gbp-map-views', t.mapViews.toLocaleString());
      set('gbp-search-views', t.searchViews.toLocaleString());
      set('gbp-map-views-last', last(l.mapViews));
      set('gbp-search-views-last', last(l.searchViews));
      const mapsPct = views ? Math.round((t.mapViews / views) * 100) : 50;
      (document.getElementById('g-split-maps') as HTMLElement).style.flexBasis = `${mapsPct}%`;
      (document.getElementById('g-split-search') as HTMLElement).style.flexBasis = `${100 - mapsPct}%`;

      set('gbp-call-clicks', t.callClicks.toLocaleString());
      set('gbp-call-clicks-last', last(l.callClicks));
      set('gbp-website-clicks', t.websiteClicks.toLocaleString());
      set('gbp-website-clicks-last', last(l.websiteClicks));
      set('gbp-direction-requests', t.directionRequests.toLocaleString());
      set('gbp-direction-requests-last', last(l.directionRequests));
      const actions = t.callClicks + t.websiteClicks + t.directionRequests;
      set('g-rate', views ? `${actions.toLocaleString()} actions · ${((actions / views) * 100).toFixed(1)}% of viewers` : '');

      const days = stats.byDay ?? [];
      const peak = days.reduce<{ date: string; value: number } | null>((m, d) => (!m || d.value > m.value ? d : m), null);
      set('gbp-chart-peak', peak ? `Busiest: ${peak.value.toLocaleString()} on ${shortDay(peak.date)}` : '');
      renderAreaChart(
        document.getElementById('gbp-chart')!,
        document.getElementById('g-tip')!,
        document.getElementById('g-axis')!,
        days,
        (i) =>
          `<b>${localDay(days[i].date).toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' })}</b><span><i class="a-num">${days[i].value.toLocaleString()}</i> profile views</span>`
      );

      document.getElementById('g-loading')!.hidden = true;
      document.getElementById('gbp-section')!.hidden = false;
    } catch {
      // Network error, malformed response, etc.: show the empty state.
      empty();
    }
  }

  initAdminAuth(loadGbpInsights, { allowedRoles: ['owner', 'agency'] });
</script>
