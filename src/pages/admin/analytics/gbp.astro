---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<!--
  Split out of the old combined admin/leads.astro into its own dashboard
  under "Analytics Dashboards" — see AdminLayout.astro and CLAUDE.md's
  "Analytics Dashboards reorg" section. Tier 4 — Google Business Profile,
  sourced from the get-gbp-insights Edge Function (see CLAUDE.md's
  "Client dashboard" section). Hidden entirely (not shown empty), not
  just on a site with no google_business_location_id/OAuth credentials
  configured but on ANY failure calling the function, same graceful-
  degrade discipline as every other tier.
-->
<AdminLayout title="Google Business Profile | Admin" current="analytics-gbp">
  <div id="gbp-empty" class="rounded-lg border border-black/5 bg-white p-5 text-sm text-slate-500 shadow-sm">
    Google Business Profile insights aren't configured for this site yet.
  </div>
  <div id="gbp-section" class="hidden">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Map views</p>
        <p id="gbp-map-views" class="mt-1 font-[family-name:var(--font-heading)] text-2xl font-extrabold text-brand-ink">—</p>
        <p id="gbp-map-views-last" class="mt-1 text-xs text-slate-500"></p>
      </div>
      <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Search views</p>
        <p id="gbp-search-views" class="mt-1 font-[family-name:var(--font-heading)] text-2xl font-extrabold text-brand-ink">—</p>
        <p id="gbp-search-views-last" class="mt-1 text-xs text-slate-500"></p>
      </div>
      <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Website clicks</p>
        <p id="gbp-website-clicks" class="mt-1 font-[family-name:var(--font-heading)] text-2xl font-extrabold text-brand-ink">—</p>
        <p id="gbp-website-clicks-last" class="mt-1 text-xs text-slate-500"></p>
      </div>
      <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Calls</p>
        <p id="gbp-call-clicks" class="mt-1 font-[family-name:var(--font-heading)] text-2xl font-extrabold text-brand-ink">—</p>
        <p id="gbp-call-clicks-last" class="mt-1 text-xs text-slate-500"></p>
      </div>
      <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Direction requests</p>
        <p id="gbp-direction-requests" class="mt-1 font-[family-name:var(--font-heading)] text-2xl font-extrabold text-brand-ink">—</p>
        <p id="gbp-direction-requests-last" class="mt-1 text-xs text-slate-500"></p>
      </div>
    </div>
    <div class="mt-4 rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <div class="mb-4 flex items-baseline justify-between">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Map + search views per day</p>
        <p id="gbp-chart-peak" class="text-xs text-slate-400"></p>
      </div>
      <!-- No items-end — see CLAUDE.md's "Pageviews-per-day chart" entry
           for why a stretched, definite-height parent is required for
           the bar's percentage height to resolve against once each day
           became a label+bar+label column instead of a bare bar. -->
      <div id="gbp-chart" class="flex h-28 gap-[3px]"></div>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase, initAdminAuth } from '../../../lib/adminAuth';

  type GbpMonthSummary = {
    mapViews: number;
    searchViews: number;
    websiteClicks: number;
    callClicks: number;
    directionRequests: number;
  };
  type GbpInsights = {
    thisMonth: GbpMonthSummary;
    lastMonth: GbpMonthSummary;
    byDay: { date: string; value: number }[];
  };

  function formatGbpDelta(thisValue: number, lastValue: number): string {
    if (lastValue > 0) {
      const pct = Math.round(((thisValue - lastValue) / lastValue) * 100);
      return `${pct > 0 ? '+' : ''}${pct}% vs last month`;
    }
    if (thisValue > 0) return 'None last month';
    return '';
  }

  async function loadGbpInsights() {
    const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
    const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    try {
      const { data: sessionData } = await supabase.auth.getSession();
      const accessToken = sessionData.session?.access_token;
      if (!accessToken) return;

      const response = await fetch(`${SUPABASE_URL}/functions/v1/get-gbp-insights`, {
        method: 'POST',
        headers: { apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${accessToken}` },
      });
      if (!response.ok) return;
      const stats = (await response.json()) as GbpInsights;

      document.getElementById('gbp-map-views')!.textContent = stats.thisMonth.mapViews.toLocaleString();
      document.getElementById('gbp-map-views-last')!.textContent = formatGbpDelta(stats.thisMonth.mapViews, stats.lastMonth.mapViews);
      document.getElementById('gbp-search-views')!.textContent = stats.thisMonth.searchViews.toLocaleString();
      document.getElementById('gbp-search-views-last')!.textContent = formatGbpDelta(
        stats.thisMonth.searchViews,
        stats.lastMonth.searchViews
      );
      document.getElementById('gbp-website-clicks')!.textContent = stats.thisMonth.websiteClicks.toLocaleString();
      document.getElementById('gbp-website-clicks-last')!.textContent = formatGbpDelta(
        stats.thisMonth.websiteClicks,
        stats.lastMonth.websiteClicks
      );
      document.getElementById('gbp-call-clicks')!.textContent = stats.thisMonth.callClicks.toLocaleString();
      document.getElementById('gbp-call-clicks-last')!.textContent = formatGbpDelta(stats.thisMonth.callClicks, stats.lastMonth.callClicks);
      document.getElementById('gbp-direction-requests')!.textContent = stats.thisMonth.directionRequests.toLocaleString();
      document.getElementById('gbp-direction-requests-last')!.textContent = formatGbpDelta(
        stats.thisMonth.directionRequests,
        stats.lastMonth.directionRequests
      );

      // Same sparse-label treatment as the Website Traffic chart (see
      // CLAUDE.md's "Pageviews-per-day chart" entry) — a label on every
      // single bar would be unreadable, and an empty label span must
      // reserve the same fixed height as a populated one or every bar's
      // bottom lands on a different line.
      const LABEL_INTERVAL = 5;
      const maxDayValue = Math.max(1, ...stats.byDay.map((d) => d.value));
      const peakEl = document.getElementById('gbp-chart-peak')!;
      peakEl.textContent = maxDayValue > 0 ? `Peak: ${maxDayValue.toLocaleString()}/day` : '';
      const chartEl = document.getElementById('gbp-chart')!;
      chartEl.innerHTML = stats.byDay
        .map((d, i) => {
          const heightPct = Math.max(Math.round((d.value / maxDayValue) * 100), d.value > 0 ? 4 : 1);
          const label = d.date
            ? new Date(d.date + 'T00:00:00').toLocaleDateString(undefined, { month: 'short', day: 'numeric' })
            : '';
          const showLabel = i % LABEL_INTERVAL === 0 || i === stats.byDay.length - 1;
          return `
      <div class="flex flex-1 flex-col items-center justify-end gap-1" title="${d.value} view${d.value === 1 ? '' : 's'} — ${label}">
        <span class="flex h-3 items-end text-[10px] font-semibold text-slate-500">${showLabel ? d.value.toLocaleString() : ''}</span>
        <div class="w-full rounded-t bg-brand-accent" style="height: ${heightPct}%"></div>
        <span class="flex h-3 items-start whitespace-nowrap text-[9px] text-slate-400">${showLabel ? label : ''}</span>
      </div>`;
        })
        .join('');

      document.getElementById('gbp-empty')!.classList.add('hidden');
      document.getElementById('gbp-section')!.classList.remove('hidden');
    } catch {
      // Network error, malformed response, etc. — stays on the empty state.
    }
  }

  initAdminAuth(loadGbpInsights, { allowedRoles: ['owner', 'agency'] });
</script>
