---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ACTIVITY_TYPES, PARTNER_CATEGORIES, PARTNER_STATUSES } from '../../lib/referralPartners';
import { OUTREACH_GUIDELINES, OUTREACH_TEMPLATES } from '../../lib/outreachKit';
---

<!--
  Referral partner tracker: the "Get Referred" step of the Full Caseload
  System. A small CRM for the practice's referral relationships (doctors,
  attorneys, churches...): relationship stage, follow-up reminders, an
  append-only activity log, and the leads/clients each partner actually
  sent (leads.referral_partner_id, linked in the Lead CRM or automatically
  on an exact "Who referred you?" match). Same list/detail toggle and
  "due this week" patterns as admin/crm.astro. See
  0068_referral_partners.sql.
-->
<AdminLayout title="Referral partners | Admin" current="referral-partners">
  <div id="partners-list-view">
    <div class="mb-8 grid gap-4 sm:grid-cols-3">
      <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Active partners</p>
        <p id="stat-active" class="mt-1 font-[family-name:var(--font-heading)] text-3xl font-extrabold text-brand-ink">—</p>
        <p id="stat-pipeline" class="mt-1 text-xs text-slate-500"></p>
      </div>
      <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Referred leads</p>
        <p id="stat-referred-leads" class="mt-1 font-[family-name:var(--font-heading)] text-3xl font-extrabold text-brand-ink">—</p>
        <p class="mt-1 text-xs text-slate-500">All time, linked to a partner</p>
      </div>
      <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Clients from partners</p>
        <p id="stat-referred-clients" class="mt-1 font-[family-name:var(--font-heading)] text-3xl font-extrabold text-brand-ink">—</p>
        <p class="mt-1 text-xs text-slate-500">Referred leads marked Scheduled</p>
      </div>
    </div>

    <!-- Outreach kit, practice-wide half: the printable handout and the
         ground rules. The per-partner messages live in the detail view. -->
    <div class="mb-8 rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Outreach kit</p>
          <p class="mt-1 text-sm text-slate-600">
            A one-page overview of your practice to leave with partners, and ready-to-send messages on each partner's page.
          </p>
        </div>
        <button id="print-handout-button" type="button" class="rounded-md bg-brand-accent px-4 py-2 text-sm font-semibold text-white hover:opacity-90">Print practice handout</button>
      </div>
      <label class="mt-3 flex items-center gap-2 text-sm text-slate-700">
        <input id="faith-integration-checkbox" type="checkbox" />
        We offer faith-integrated counseling (mentioned in church outreach and on the handout)
      </label>
      <p id="faith-status" class="text-xs" role="status"></p>
      <details class="mt-3 text-sm">
        <summary class="cursor-pointer font-semibold text-brand-ink">Ground rules for referral outreach</summary>
        <ul class="mt-2 list-disc space-y-1.5 pl-5 text-slate-700">
          {OUTREACH_GUIDELINES.map((g) => <li>{g}</li>)}
        </ul>
      </details>
    </div>

    <div id="due-section" class="mb-8 hidden rounded-lg border border-amber-200 bg-amber-50 p-5">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-amber-800">Follow up this week</p>
      <div id="due-list" class="space-y-2 text-sm"></div>
    </div>

    <div class="mb-4 flex flex-wrap items-end gap-3">
      <div>
        <label for="search-input" class="block text-xs font-semibold text-slate-500">Search</label>
        <input id="search-input" type="search" placeholder="Name, contact..." class="rounded-md border border-slate-300 px-3 py-2 text-sm" />
      </div>
      <div>
        <label for="status-filter" class="block text-xs font-semibold text-slate-500">Stage</label>
        <select id="status-filter" class="rounded-md border border-slate-300 px-3 py-2 text-sm">
          <option value="">All</option>
          {PARTNER_STATUSES.map((s) => <option value={s.value}>{s.label}</option>)}
        </select>
      </div>
      <div>
        <label for="category-filter" class="block text-xs font-semibold text-slate-500">Type</label>
        <select id="category-filter" class="rounded-md border border-slate-300 px-3 py-2 text-sm">
          <option value="">All</option>
          {PARTNER_CATEGORIES.map((c) => <option value={c.value}>{c.label}</option>)}
        </select>
      </div>
      <label class="flex items-center gap-2 pb-2 text-sm text-slate-600">
        <input id="show-archived" type="checkbox" />
        Show archived
      </label>
      <button
        id="add-partner-button"
        type="button"
        class="ml-auto rounded-md bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90"
      >
        + Add partner
      </button>
    </div>

    <p id="partners-count" class="mb-2 text-sm text-slate-600"></p>
    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-slate-200 bg-slate-50">
          <tr>
            <th class="px-4 py-3 font-semibold">Partner</th>
            <th class="px-4 py-3 font-semibold">Type</th>
            <th class="px-4 py-3 font-semibold">Stage</th>
            <th class="px-4 py-3 font-semibold">Last touch</th>
            <th class="px-4 py-3 font-semibold">Next follow-up</th>
            <th class="px-4 py-3 font-semibold">Leads</th>
            <th class="px-4 py-3 font-semibold">Clients</th>
          </tr>
        </thead>
        <tbody id="partners-table-body"></tbody>
      </table>
    </div>
  </div>

  <div id="partner-detail-view" class="hidden">
    <div class="mb-4 flex items-center justify-between">
      <button id="back-button" type="button" class="text-sm font-semibold text-brand-primary hover:underline">&larr; Back to all partners</button>
      <div class="flex gap-2">
        <button id="archive-button" type="button" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">Archive</button>
        <button id="delete-button" type="button" class="rounded-md border border-red-300 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50">Delete</button>
      </div>
    </div>

    <div class="mb-6 grid gap-6 lg:grid-cols-5">
      <form id="partner-form" class="space-y-3 rounded-lg border border-black/5 bg-white p-5 shadow-sm lg:col-span-3">
        <p id="detail-archived-banner" class="hidden rounded-md bg-slate-100 px-3 py-2 text-xs text-slate-600">Archived. Hidden from the default list.</p>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label for="pf-name" class="block text-xs font-semibold text-slate-500">Name (office, practice, or organization)</label>
            <input id="pf-name" name="name" type="text" required class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
          </div>
          <div>
            <label for="pf-category" class="block text-xs font-semibold text-slate-500">Type</label>
            <select id="pf-category" name="category" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
              {PARTNER_CATEGORIES.map((c) => <option value={c.value}>{c.label}</option>)}
            </select>
          </div>
          <div>
            <label for="pf-status" class="block text-xs font-semibold text-slate-500">Stage</label>
            <select id="pf-status" name="status" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
              {PARTNER_STATUSES.map((s) => <option value={s.value}>{s.label}</option>)}
            </select>
          </div>
          <div>
            <label for="pf-contact-name" class="block text-xs font-semibold text-slate-500">Contact person</label>
            <input id="pf-contact-name" name="contact_name" type="text" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
          </div>
          <div>
            <label for="pf-next-follow-up" class="block text-xs font-semibold text-slate-500">Next follow-up</label>
            <input id="pf-next-follow-up" name="next_follow_up" type="date" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
          </div>
          <div>
            <label for="pf-email" class="block text-xs font-semibold text-slate-500">Email</label>
            <input id="pf-email" name="email" type="email" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
          </div>
          <div>
            <label for="pf-phone" class="block text-xs font-semibold text-slate-500">Phone</label>
            <input id="pf-phone" name="phone" type="tel" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
          </div>
          <div>
            <label for="pf-website" class="block text-xs font-semibold text-slate-500">Website</label>
            <input id="pf-website" name="website" type="url" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
          </div>
          <div>
            <label for="pf-address" class="block text-xs font-semibold text-slate-500">Address</label>
            <input id="pf-address" name="address" type="text" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
          </div>
          <div class="sm:col-span-2">
            <label for="pf-notes" class="block text-xs font-semibold text-slate-500">About this relationship</label>
            <textarea id="pf-notes" name="notes" rows="3" placeholder="Who they serve, what kinds of clients they'd refer, how they prefer to be contacted..." class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm"></textarea>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <button type="submit" class="rounded-md bg-brand-primary px-5 py-2 text-sm font-semibold text-white hover:opacity-90">Save</button>
          <span id="partner-form-status" class="text-sm" role="status"></span>
        </div>
      </form>

      <div class="space-y-6 lg:col-span-2">
        <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Referrals from this partner</p>
          <p id="detail-referral-summary" class="mb-2 text-sm text-slate-700"></p>
          <ul id="detail-referral-list" class="space-y-1 text-sm"></ul>
          <p class="mt-3 text-xs text-slate-500">Link a lead to this partner from its detail view in the Lead CRM.</p>
        </div>
      </div>
    </div>

    <!-- Outreach kit, per-partner half: a message personalized with this
         partner's name, contact, and type plus the practice's live data.
         Editable before sending; "Log as sent" records it in Activity. -->
    <div class="mb-6 rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Outreach message</p>
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label for="kit-template" class="block text-xs font-semibold text-slate-500">Message</label>
          <select id="kit-template" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
            {OUTREACH_TEMPLATES.map((t) => <option value={t.key}>{t.label}</option>)}
          </select>
        </div>
        <div>
          <label for="kit-signer" class="block text-xs font-semibold text-slate-500">Signed by</label>
          <input id="kit-signer" type="text" placeholder="Your name and title" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
        </div>
      </div>
      <div id="kit-subject-wrap" class="mt-3">
        <label for="kit-subject" class="block text-xs font-semibold text-slate-500">Subject</label>
        <input id="kit-subject" type="text" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
      </div>
      <div class="mt-3">
        <label for="kit-body" class="block text-xs font-semibold text-slate-500">Message (edit freely before sending)</label>
        <textarea id="kit-body" rows="14" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm"></textarea>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button id="kit-copy" type="button" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">Copy</button>
        <a id="kit-mailto" href="#" class="hidden rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">Open in email</a>
        <button id="kit-log" type="button" class="rounded-md bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90">Log as sent</button>
        <span id="kit-status" class="text-sm" role="status"></span>
      </div>
      <p class="mt-2 text-xs text-slate-500">Never mention a client by name, or that someone became a client, without their signed release.</p>
    </div>

    <div class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Activity</p>
      <form id="activity-form" class="mb-4 grid gap-2 sm:grid-cols-7">
        <select name="activity_type" aria-label="Activity type" class="rounded-md border border-slate-300 px-3 py-2 text-sm sm:col-span-2">
          {ACTIVITY_TYPES.map((a) => <option value={a.value}>{a.label}</option>)}
        </select>
        <input name="occurred_on" type="date" aria-label="Date" class="rounded-md border border-slate-300 px-3 py-2 text-sm sm:col-span-1" />
        <input name="note" type="text" aria-label="What happened" placeholder="What happened? e.g. Dropped off brochures, met the office manager" class="rounded-md border border-slate-300 px-3 py-2 text-sm sm:col-span-3" />
        <button type="submit" class="rounded-md bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90 sm:col-span-1">Log it</button>
      </form>
      <ul id="activity-list" class="space-y-3 text-sm"></ul>
    </div>
  </div>

  <div id="add-partner-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="w-full max-w-md rounded-lg bg-white p-6 shadow-xl">
      <div class="mb-4 flex items-center justify-between">
        <p class="font-semibold text-brand-ink">Add a referral partner</p>
        <button id="add-partner-close" type="button" class="text-sm text-slate-500 hover:text-slate-800">Close</button>
      </div>
      <form id="add-partner-form" class="space-y-3">
        <div>
          <label for="ap-name" class="block text-xs font-semibold text-slate-500">Name (office, practice, or organization)</label>
          <input id="ap-name" name="name" type="text" required placeholder="e.g. Grace Church, Dr. Lee's Family Medicine" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <div>
          <label for="ap-category" class="block text-xs font-semibold text-slate-500">Type</label>
          <select id="ap-category" name="category" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm">
            {PARTNER_CATEGORIES.map((c) => <option value={c.value}>{c.label}</option>)}
          </select>
        </div>
        <div>
          <label for="ap-contact-name" class="block text-xs font-semibold text-slate-500">Contact person (optional)</label>
          <input id="ap-contact-name" name="contact_name" type="text" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <p id="add-partner-status" class="text-sm text-red-600"></p>
        <button type="submit" class="w-full rounded-md bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90">Add partner</button>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase, initAdminAuth } from '../../lib/adminAuth';
  import QRCode from 'qrcode';
  import { withBase } from '../../lib/url';
  import {
    OUTREACH_TEMPLATES,
    buildOutreachMessage,
    type OutreachCounselor,
    type OutreachTemplateKey,
  } from '../../lib/outreachKit';
  import {
    activityLabel,
    categoryLabel,
    partnerStatusClasses,
    partnerStatusLabel,
    type PartnerActivity,
    type ReferralPartner,
  } from '../../lib/referralPartners';

  type LinkedLead = {
    id: string;
    name: string | null;
    created_at: string;
    status: string | null;
    referral_partner_id: string;
  };

  let partners: ReferralPartner[] = [];
  let activities: PartnerActivity[] = [];
  let linkedLeads: LinkedLead[] = [];
  let currentId: string | null = null;

  const listView = document.getElementById('partners-list-view')!;
  const detailView = document.getElementById('partner-detail-view')!;
  const tableBody = document.getElementById('partners-table-body')!;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const statusFilter = document.getElementById('status-filter') as HTMLSelectElement;
  const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement;
  const showArchived = document.getElementById('show-archived') as HTMLInputElement;
  const partnerForm = document.getElementById('partner-form') as HTMLFormElement;
  const partnerFormStatus = document.getElementById('partner-form-status')!;
  const activityForm = document.getElementById('activity-form') as HTMLFormElement;
  const activityList = document.getElementById('activity-list')!;
  const archiveButton = document.getElementById('archive-button')!;
  const deleteButton = document.getElementById('delete-button')!;
  const archivedBanner = document.getElementById('detail-archived-banner')!;
  const addModal = document.getElementById('add-partner-modal')!;
  const addForm = document.getElementById('add-partner-form') as HTMLFormElement;
  const addStatus = document.getElementById('add-partner-status')!;

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function todayIso(): string {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }

  // Plain `date` columns (follow-ups, activity dates) have no time zone:
  // parse them as local so "today" doesn't render as yesterday west of
  // UTC. Full timestamps (a lead's created_at) are real instants: let
  // Date convert them to local time.
  function formatDate(iso: string): string {
    const opts: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric', year: 'numeric' };
    if (iso.length > 10) return new Date(iso).toLocaleDateString(undefined, opts);
    const [y, m, d] = iso.split('-').map(Number);
    return new Date(y, m - 1, d).toLocaleDateString(undefined, opts);
  }

  function lastTouch(partnerId: string): string | null {
    const dates = activities.filter((a) => a.partner_id === partnerId).map((a) => a.occurred_on);
    return dates.length ? dates.sort().at(-1)! : null;
  }

  function referralCounts(partnerId: string) {
    const leads = linkedLeads.filter((l) => l.referral_partner_id === partnerId);
    return { leads: leads.length, clients: leads.filter((l) => l.status === 'scheduled').length };
  }

  function statusBadge(status: string): string {
    return `<span class="inline-block rounded-md border px-2 py-0.5 text-xs font-semibold ${partnerStatusClasses(status)}">${escapeHtml(partnerStatusLabel(status))}</span>`;
  }

  function renderStats() {
    const live = partners.filter((p) => !p.archived_at);
    document.getElementById('stat-active')!.textContent = String(live.filter((p) => p.status === 'active').length);
    const inProgress = live.filter((p) => ['prospect', 'contacted', 'meeting'].includes(p.status)).length;
    document.getElementById('stat-pipeline')!.textContent = `${inProgress} more in progress`;
    document.getElementById('stat-referred-leads')!.textContent = String(linkedLeads.length);
    document.getElementById('stat-referred-clients')!.textContent = String(
      linkedLeads.filter((l) => l.status === 'scheduled').length
    );
  }

  // Same rule as the Lead CRM: no lower bound, so an overdue follow-up
  // keeps showing instead of silently disappearing once its date passes.
  function renderDue() {
    const weekOut = new Date();
    weekOut.setDate(weekOut.getDate() + 7);
    const limit = `${weekOut.getFullYear()}-${String(weekOut.getMonth() + 1).padStart(2, '0')}-${String(weekOut.getDate()).padStart(2, '0')}`;
    const today = todayIso();
    const due = partners
      .filter((p) => !p.archived_at && p.status !== 'inactive' && p.next_follow_up && p.next_follow_up <= limit)
      .sort((a, b) => a.next_follow_up!.localeCompare(b.next_follow_up!));
    const section = document.getElementById('due-section')!;
    section.classList.toggle('hidden', due.length === 0);
    document.getElementById('due-list')!.innerHTML = due
      .map((p) => {
        const overdue = p.next_follow_up! < today;
        return `
        <button type="button" data-partner-id="${p.id}" class="open-partner flex w-full items-center justify-between rounded-md bg-white px-3 py-2 text-left hover:bg-amber-100/50">
          <span class="font-semibold text-brand-ink">${escapeHtml(p.name)}</span>
          <span class="${overdue ? 'font-semibold text-red-600' : 'text-amber-800'}">${overdue ? 'Overdue: ' : ''}${formatDate(p.next_follow_up!)}</span>
        </button>`;
      })
      .join('');
  }

  function renderList() {
    const q = searchInput.value.trim().toLowerCase();
    const rows = partners.filter((p) => {
      if (!showArchived.checked && p.archived_at) return false;
      if (statusFilter.value && p.status !== statusFilter.value) return false;
      if (categoryFilter.value && p.category !== categoryFilter.value) return false;
      if (q && ![p.name, p.contact_name ?? '', p.email ?? ''].some((v) => v.toLowerCase().includes(q))) return false;
      return true;
    });
    document.getElementById('partners-count')!.textContent = `${rows.length} partner${rows.length === 1 ? '' : 's'}`;
    if (rows.length === 0) {
      tableBody.innerHTML = `<tr><td colspan="7" class="px-4 py-6 text-center text-slate-500">${
        partners.length === 0 ? 'No referral partners yet. Add the doctors, attorneys, churches, and other professionals you want referrals from.' : 'No partners match these filters.'
      }</td></tr>`;
      return;
    }
    tableBody.innerHTML = rows
      .map((p) => {
        const touch = lastTouch(p.id);
        const counts = referralCounts(p.id);
        return `
      <tr class="border-b border-slate-100 last:border-0 ${p.archived_at ? 'opacity-60' : ''}">
        <td class="px-4 py-3">
          <button type="button" data-partner-id="${p.id}" class="open-partner text-left font-semibold text-brand-ink hover:underline">${escapeHtml(p.name)}</button>
          ${p.contact_name ? `<p class="text-xs text-slate-500">${escapeHtml(p.contact_name)}</p>` : ''}
        </td>
        <td class="px-4 py-3">${escapeHtml(categoryLabel(p.category))}</td>
        <td class="px-4 py-3">${statusBadge(p.status)}</td>
        <td class="px-4 py-3 whitespace-nowrap">${touch ? formatDate(touch) : '<span class="text-slate-400">Never</span>'}</td>
        <td class="px-4 py-3 whitespace-nowrap">${p.next_follow_up ? formatDate(p.next_follow_up) : ''}</td>
        <td class="px-4 py-3">${counts.leads}</td>
        <td class="px-4 py-3 font-semibold ${counts.clients ? 'text-emerald-700' : ''}">${counts.clients}</td>
      </tr>`;
      })
      .join('');
  }

  function renderAll() {
    renderStats();
    renderDue();
    renderList();
  }

  [searchInput, statusFilter, categoryFilter, showArchived].forEach((el) => el.addEventListener('input', renderList));

  document.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement).closest<HTMLElement>('.open-partner');
    if (target?.dataset.partnerId) openDetail(target.dataset.partnerId);
  });

  function renderActivities() {
    const rows = activities
      .filter((a) => a.partner_id === currentId)
      .sort((a, b) => b.occurred_on.localeCompare(a.occurred_on) || b.created_at.localeCompare(a.created_at));
    activityList.innerHTML = rows.length
      ? rows
          .map(
            (a) => `
        <li class="border-l-2 border-slate-200 pl-3">
          <p class="text-xs text-slate-500"><span class="font-semibold text-slate-700">${escapeHtml(activityLabel(a.activity_type))}</span> · ${formatDate(a.occurred_on)}</p>
          ${a.note ? `<p class="mt-0.5 text-slate-700">${escapeHtml(a.note)}</p>` : ''}
        </li>`
          )
          .join('')
      : '<li class="text-slate-500">Nothing logged yet. Log every email, call, visit, and thank-you so you can see the relationship over time.</li>';
  }

  function renderReferrals() {
    const leads = linkedLeads
      .filter((l) => l.referral_partner_id === currentId)
      .sort((a, b) => b.created_at.localeCompare(a.created_at));
    const clients = leads.filter((l) => l.status === 'scheduled').length;
    document.getElementById('detail-referral-summary')!.textContent = leads.length
      ? `${leads.length} lead${leads.length === 1 ? '' : 's'}, ${clients} became client${clients === 1 ? '' : 's'}`
      : 'No referrals linked yet.';
    document.getElementById('detail-referral-list')!.innerHTML = leads
      .map(
        (l) => `
      <li class="flex justify-between gap-2">
        <span>${escapeHtml(l.name ?? '(no name)')}</span>
        <span class="text-slate-500">${formatDate(l.created_at)}${l.status === 'scheduled' ? ' · <span class="font-semibold text-emerald-700">Client</span>' : ''}</span>
      </li>`
      )
      .join('');
  }

  function openDetail(id: string) {
    const p = partners.find((x) => x.id === id);
    if (!p) return;
    currentId = id;
    const f = partnerForm.elements as unknown as Record<string, HTMLInputElement>;
    for (const key of ['name', 'category', 'status', 'contact_name', 'next_follow_up', 'email', 'phone', 'website', 'address', 'notes']) {
      f[key].value = ((p as unknown as Record<string, string | null>)[key] ?? '') as string;
    }
    partnerFormStatus.textContent = '';
    archiveButton.textContent = p.archived_at ? 'Unarchive' : 'Archive';
    archivedBanner.classList.toggle('hidden', !p.archived_at);
    (activityForm.elements.namedItem('occurred_on') as HTMLInputElement).value = todayIso();
    renderActivities();
    renderReferrals();
    renderKit();
    listView.classList.add('hidden');
    detailView.classList.remove('hidden');
    window.scrollTo(0, 0);
  }

  document.getElementById('back-button')!.addEventListener('click', () => {
    detailView.classList.add('hidden');
    listView.classList.remove('hidden');
    renderAll();
  });

  partnerForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!currentId) return;
    const data = new FormData(partnerForm);
    const text = (k: string) => ((data.get(k) as string) ?? '').trim() || null;
    const update = {
      name: text('name') ?? '',
      category: data.get('category') as string,
      status: data.get('status') as string,
      contact_name: text('contact_name'),
      next_follow_up: text('next_follow_up'),
      email: text('email'),
      phone: text('phone'),
      website: text('website'),
      address: text('address'),
      notes: text('notes'),
    };
    if (!update.name) return;
    partnerFormStatus.textContent = 'Saving...';
    partnerFormStatus.className = 'text-sm text-slate-600';
    const { error } = await supabase.from('referral_partners').update(update).eq('id', currentId);
    if (error) {
      partnerFormStatus.textContent = 'Could not save: ' + error.message;
      partnerFormStatus.className = 'text-sm text-red-600';
      return;
    }
    Object.assign(partners.find((p) => p.id === currentId)!, update);
    partnerFormStatus.textContent = 'Saved.';
    partnerFormStatus.className = 'text-sm text-emerald-700';
  });

  // Shared by the Activity form and the outreach kit's "Log as sent".
  async function logActivity(activityType: string, note: string | null, occurredOn = todayIso()): Promise<boolean> {
    if (!currentId) return false;
    const row = { partner_id: currentId, activity_type: activityType, occurred_on: occurredOn, note };
    const { data: inserted, error } = await supabase.from('referral_partner_activities').insert(row).select().single();
    if (error) {
      window.alert('Could not log activity: ' + error.message);
      return false;
    }
    activities.push(inserted as PartnerActivity);

    // First real outreach moves a prospect forward automatically; any
    // later stage change stays the user's call.
    const partner = partners.find((p) => p.id === currentId)!;
    if (partner.status === 'prospect' && activityType !== 'note') {
      const { error: stageError } = await supabase.from('referral_partners').update({ status: 'contacted' }).eq('id', currentId);
      if (!stageError) {
        partner.status = 'contacted';
        (partnerForm.elements.namedItem('status') as HTMLSelectElement).value = 'contacted';
      }
    }
    renderActivities();
    return true;
  }

  activityForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(activityForm);
    const ok = await logActivity(
      data.get('activity_type') as string,
      ((data.get('note') as string) ?? '').trim() || null,
      (data.get('occurred_on') as string) || todayIso()
    );
    if (ok) (activityForm.elements.namedItem('note') as HTMLInputElement).value = '';
  });

  // ---------------------------------------------------------------------
  // Outreach kit
  // ---------------------------------------------------------------------
  type PracticeInfo = {
    id: string;
    display_name: string;
    telephone: string | null;
    email: string | null;
    street_address: string | null;
    street_address_2: string | null;
    address_locality: string | null;
    address_region: string | null;
    postal_code: string | null;
    lead_response_time_note: string | null;
    offers_faith_integration: boolean;
    google_fonts_url: string | null;
  };
  let practice: PracticeInfo | null = null;
  let counselors: OutreachCounselor[] = [];
  // Links in outreach always point at the live site, never localhost.
  const siteUrl = new URL(withBase('/'), import.meta.env.SITE).toString().replace(/\/$/, '');
  const contactUrl = new URL(withBase('/contact'), import.meta.env.SITE).toString();

  const kitTemplate = document.getElementById('kit-template') as HTMLSelectElement;
  const kitSigner = document.getElementById('kit-signer') as HTMLInputElement;
  const kitSubject = document.getElementById('kit-subject') as HTMLInputElement;
  const kitSubjectWrap = document.getElementById('kit-subject-wrap')!;
  const kitBody = document.getElementById('kit-body') as HTMLTextAreaElement;
  const kitMailto = document.getElementById('kit-mailto') as HTMLAnchorElement;
  const kitStatus = document.getElementById('kit-status')!;
  const faithCheckbox = document.getElementById('faith-integration-checkbox') as HTMLInputElement;
  const faithStatus = document.getElementById('faith-status')!;

  // The signer is a per-person convenience, so it's remembered in this
  // browser only. Storage can be unavailable (private mode), so every
  // access is guarded.
  try {
    kitSigner.value = localStorage.getItem('outreach-signer') ?? '';
  } catch {
    /* storage unavailable */
  }

  function renderKit() {
    const partner = partners.find((p) => p.id === currentId);
    if (!partner || !practice) return;
    const key = kitTemplate.value as OutreachTemplateKey;
    const meta = OUTREACH_TEMPLATES.find((t) => t.key === key)!;
    const message = buildOutreachMessage(key, {
      partnerName: partner.name,
      partnerCategory: partner.category,
      contactName: partner.contact_name,
      practiceName: practice.display_name,
      phone: practice.telephone,
      website: siteUrl.replace(/^https?:\/\//, ''),
      city: practice.address_locality,
      responseNote: practice.lead_response_time_note,
      counselors,
      offersFaithIntegration: practice.offers_faith_integration,
      signer: kitSigner.value,
    });
    kitSubjectWrap.classList.toggle('hidden', !meta.hasSubject);
    kitSubject.value = message.subject;
    kitBody.value = message.body;
    kitStatus.textContent = '';
    updateMailto();
  }

  function updateMailto() {
    const partner = partners.find((p) => p.id === currentId);
    const meta = OUTREACH_TEMPLATES.find((t) => t.key === kitTemplate.value)!;
    const show = Boolean(partner?.email) && meta.hasSubject;
    kitMailto.classList.toggle('hidden', !show);
    if (show) {
      kitMailto.href = `mailto:${partner!.email!.trim()}?subject=${encodeURIComponent(kitSubject.value)}&body=${encodeURIComponent(kitBody.value)}`;
    }
  }

  kitTemplate.addEventListener('change', renderKit);
  kitSigner.addEventListener('input', () => {
    try {
      localStorage.setItem('outreach-signer', kitSigner.value);
    } catch {
      /* storage unavailable */
    }
    renderKit();
  });
  kitSubject.addEventListener('input', updateMailto);
  kitBody.addEventListener('input', updateMailto);

  document.getElementById('kit-copy')!.addEventListener('click', async () => {
    const text = kitSubjectWrap.classList.contains('hidden') ? kitBody.value : `Subject: ${kitSubject.value}\n\n${kitBody.value}`;
    try {
      await navigator.clipboard.writeText(text);
      kitStatus.textContent = 'Copied.';
      kitStatus.className = 'text-sm text-emerald-700';
    } catch {
      kitStatus.textContent = 'Select the text and copy it manually.';
      kitStatus.className = 'text-sm text-amber-700';
    }
  });

  document.getElementById('kit-log')!.addEventListener('click', async () => {
    const meta = OUTREACH_TEMPLATES.find((t) => t.key === kitTemplate.value)!;
    const ok = await logActivity(meta.activityType, `Sent: ${meta.label.replace(/ \(.*\)$/, '')} (outreach kit)`);
    if (ok) {
      kitStatus.textContent = 'Logged in Activity.';
      kitStatus.className = 'text-sm text-emerald-700';
    }
  });

  faithCheckbox.addEventListener('change', async () => {
    if (!practice) return;
    const value = faithCheckbox.checked;
    const { error } = await supabase.from('business').update({ offers_faith_integration: value }).eq('id', practice.id);
    if (error) {
      faithCheckbox.checked = !value;
      faithStatus.textContent = 'Could not save: ' + error.message;
      faithStatus.className = 'text-xs text-red-600';
      return;
    }
    practice.offers_faith_integration = value;
    faithStatus.textContent = 'Saved.';
    faithStatus.className = 'text-xs text-emerald-700';
  });

  function escapeAttr(value: string): string {
    return escapeHtml(value).replace(/"/g, '&quot;');
  }

  // One letter-size page, printed from a hidden same-page iframe (a popup
  // can be blocked silently; same approach as the review program's event card).
  document.getElementById('print-handout-button')!.addEventListener('click', async () => {
    if (!practice) return;
    const css = getComputedStyle(document.documentElement);
    const ink = css.getPropertyValue('--color-brand-ink').trim() || '#1c1917';
    const accent = css.getPropertyValue('--color-brand-accent').trim() || '#b5542a';
    const neutral = css.getPropertyValue('--color-brand-neutral').trim() || '#ffffff';
    const heading = css.getPropertyValue('--font-heading').trim() || 'Georgia, serif';
    const body = css.getPropertyValue('--font-body').trim() || 'system-ui, sans-serif';
    const fontLink = practice.google_fonts_url ? `<link rel="stylesheet" href="${escapeAttr(practice.google_fonts_url)}">` : '';
    const qr = await QRCode.toString(contactUrl, { type: 'svg', margin: 0, errorCorrectionLevel: 'M' });
    const where = [practice.address_locality, practice.address_region].filter(Boolean).join(', ');
    const street = [practice.street_address, practice.street_address_2].filter(Boolean).join(', ');
    const address = [street, [where, practice.postal_code].filter(Boolean).join(' ')].filter(Boolean).join(', ');
    const anyTelehealth = counselors.some((c) => c.telehealth);
    const counselorRows = counselors
      .map(
        (c) => `<div class="c"><p class="cn">${escapeHtml(c.name)}${c.accepting ? ' <span class="badge">Accepting new clients</span>' : ''}</p>
          <p class="cs">${escapeHtml(c.specialties.slice(0, 5).join(' · '))}</p></div>`
      )
      .join('');
    const frameHtml = `<!doctype html><html><head><meta charset="utf-8"><title>${escapeHtml(practice.display_name)}</title>${fontLink}
      <style>
        @page { size: letter portrait; margin: 0.55in; }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: ${body}; color: ${ink}; font-size: 11pt; line-height: 1.4;
               -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        header { border-bottom: 3px solid ${accent}; padding-bottom: 0.14in; margin-bottom: 0.18in; }
        h1 { font-family: ${heading}; font-size: 26pt; margin: 0; line-height: 1.1; }
        .sub { margin: 0.05in 0 0; font-size: 12pt; opacity: 0.8; }
        h2 { font-family: ${heading}; font-size: 14pt; margin: 0.2in 0 0.08in; }
        .refer { display: flex; gap: 0.3in; align-items: center; background: ${neutral}; border-radius: 10px; padding: 0.18in 0.22in; }
        .refer p { margin: 0 0 0.05in; }
        .qr { width: 1.25in; height: 1.25in; flex: none; } .qr svg { width: 100%; height: 100%; }
        .qrcap { font-size: 8.5pt; text-align: center; margin-top: 0.04in; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.12in 0.3in; }
        .c { break-inside: avoid; } .cn { font-weight: 700; margin: 0; } .cs { margin: 0.02in 0 0; font-size: 10pt; opacity: 0.85; }
        .badge { font-weight: 600; font-size: 8pt; color: #065f46; background: #d1fae5; border-radius: 4px; padding: 0.01in 0.06in; margin-left: 0.04in; }
        footer { margin-top: 0.25in; padding-top: 0.1in; border-top: 1px solid ${ink}22; font-size: 9pt; opacity: 0.8; }
      </style></head><body>
      <header>
        <h1>${escapeHtml(practice.display_name)}</h1>
        <p class="sub">Counseling${where ? ` in ${escapeHtml(where)}` : ''}${anyTelehealth ? ', in person and by telehealth' : ''}</p>
      </header>
      <h2>How to refer</h2>
      <div class="refer">
        <div>
          ${practice.telephone ? `<p><strong>Call:</strong> ${escapeHtml(practice.telephone)}</p>` : ''}
          <p><strong>Online:</strong> ${escapeHtml(siteUrl.replace(/^https?:\/\//, ''))}</p>
          <p>Anyone can reach out directly. No referral form is needed.</p>
          ${practice.lead_response_time_note ? `<p>${escapeHtml(practice.lead_response_time_note)}</p>` : ''}
          <p>With the client's signed release, we're glad to coordinate care.</p>
        </div>
        <div><div class="qr">${qr}</div><p class="qrcap">Scan to request an appointment</p></div>
      </div>
      <h2>Our counselors</h2>
      <div class="grid">${counselorRows}</div>
      ${practice.offers_faith_integration ? `<p style="margin-top:0.18in;">We offer counseling that integrates Christian faith for anyone who wants it, always following the client's lead.</p>` : ''}
      <footer>${escapeHtml(practice.display_name)}${address ? ` · ${escapeHtml(address)}` : ''}${practice.email ? ` · ${escapeHtml(practice.email)}` : ''}<br>
      If someone is in crisis, they can call or text 988 (Suicide &amp; Crisis Lifeline) or call 911.</footer>
      </body></html>`;
    document.getElementById('handout-print-frame')?.remove();
    const frame = document.createElement('iframe');
    frame.id = 'handout-print-frame';
    frame.title = 'Practice handout (print)';
    frame.setAttribute('aria-hidden', 'true');
    frame.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;';
    frame.srcdoc = frameHtml;
    frame.addEventListener('load', () => setTimeout(() => frame.contentWindow?.print(), 400));
    document.body.appendChild(frame);
  });

  archiveButton.addEventListener('click', async () => {
    const p = partners.find((x) => x.id === currentId);
    if (!p) return;
    const archived_at = p.archived_at ? null : new Date().toISOString();
    const { error } = await supabase.from('referral_partners').update({ archived_at }).eq('id', p.id);
    if (error) {
      window.alert('Could not update: ' + error.message);
      return;
    }
    p.archived_at = archived_at;
    archiveButton.textContent = archived_at ? 'Unarchive' : 'Archive';
    archivedBanner.classList.toggle('hidden', !archived_at);
  });

  deleteButton.addEventListener('click', async () => {
    const p = partners.find((x) => x.id === currentId);
    if (!p) return;
    if (!window.confirm(`Delete ${p.name} and its activity log? Leads linked to it stay, but lose the link. Archive instead if you might want it later.`)) return;
    const { error } = await supabase.from('referral_partners').delete().eq('id', p.id);
    if (error) {
      window.alert('Could not delete: ' + error.message);
      return;
    }
    partners = partners.filter((x) => x.id !== p.id);
    activities = activities.filter((a) => a.partner_id !== p.id);
    linkedLeads = linkedLeads.filter((l) => l.referral_partner_id !== p.id);
    detailView.classList.add('hidden');
    listView.classList.remove('hidden');
    renderAll();
  });

  document.getElementById('add-partner-button')!.addEventListener('click', () => {
    addForm.reset();
    addStatus.textContent = '';
    addModal.classList.remove('hidden');
    addModal.classList.add('flex');
  });
  document.getElementById('add-partner-close')!.addEventListener('click', () => {
    addModal.classList.add('hidden');
    addModal.classList.remove('flex');
  });

  addForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(addForm);
    const name = ((data.get('name') as string) ?? '').trim();
    if (!name) return;
    const { data: inserted, error } = await supabase
      .from('referral_partners')
      .insert({
        name,
        category: data.get('category') as string,
        contact_name: ((data.get('contact_name') as string) ?? '').trim() || null,
      })
      .select()
      .single();
    if (error) {
      addStatus.textContent = 'Could not add partner: ' + error.message;
      return;
    }
    partners.push(inserted as ReferralPartner);
    partners.sort((a, b) => a.name.localeCompare(b.name));
    addModal.classList.add('hidden');
    addModal.classList.remove('flex');
    openDetail((inserted as ReferralPartner).id);
  });

  async function load() {
    const [p, a, l, b, c] = await Promise.all([
      supabase.from('referral_partners').select('*').order('name'),
      supabase.from('referral_partner_activities').select('*'),
      supabase
        .from('leads')
        .select('id, name, created_at, status, referral_partner_id')
        .not('referral_partner_id', 'is', null),
      supabase
        .from('business')
        .select('id, display_name, telephone, email, street_address, street_address_2, address_locality, address_region, postal_code, lead_response_time_note, offers_faith_integration, google_fonts_url')
        .single(),
      supabase
        .from('pages')
        .select('title, availability_status, telehealth_available, specialties')
        .eq('page_type', 'Counselor Profile')
        .order('title'),
    ]);
    if (p.error) {
      document.getElementById('partners-count')!.textContent = 'Could not load partners: ' + p.error.message;
      return;
    }
    partners = (p.data ?? []) as ReferralPartner[];
    activities = (a.data ?? []) as PartnerActivity[];
    linkedLeads = (l.data ?? []) as LinkedLead[];
    practice = (b.data as PracticeInfo) ?? null;
    faithCheckbox.checked = practice?.offers_faith_integration ?? false;
    counselors = ((c.data ?? []) as { title: string; availability_status: string | null; telehealth_available: boolean; specialties: { label: string }[] | null }[]).map(
      (row) => ({
        name: row.title,
        specialties: (row.specialties ?? []).map((s) => s.label),
        accepting: row.availability_status === 'accepting',
        telehealth: row.telehealth_available,
      })
    );
    renderAll();
  }

  initAdminAuth(load, { allowedRoles: ['owner', 'agency'] });
</script>
