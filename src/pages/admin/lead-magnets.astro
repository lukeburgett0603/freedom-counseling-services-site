---
import AdminLayout from '../../layouts/AdminLayout.astro';
import UnsplashSearchModal from '../../components/UnsplashSearchModal.astro';
import RichTextEditor from '../../components/RichTextEditor.astro';
import { SEQUENCE_SCHEDULE_DAYS } from '../../lib/nurtureSequence';
---

<AdminLayout title="Lead magnets | Admin" current="lead-magnets">
  <!--
    Admin redesign phase 3 (2026-10-08): guides as cards with downloads and
    how many follow-up emails are set, and a two-column editor with the
    follow-up emails as a Day 0 / 3 / 7 / 14 timeline. Same ids and saves.
  -->
  <div id="magnets-list-view">
    <p class="i-intro">Free guides people download in exchange for their email, and the follow-up emails they get afterward.</p>
    <div class="r-kpis">
      <div class="t-kpi"><span class="t-lbl">Downloads</span><span id="total-leads-count" class="t-v a-num">0</span><span class="t-delta">All time, across every guide</span></div>
      <div class="t-kpi"><span class="t-lbl">Last 30 days</span><span id="lm-recent" class="t-v a-num">—</span><span class="t-delta" id="lm-recent-sub"></span></div>
      <div class="t-kpi"><span class="t-lbl">Also sent an inquiry</span><span id="lm-conv" class="t-v a-num">—</span><span class="t-delta" id="lm-conv-sub"></span></div>
    </div>
    <div class="i-toolbar">
      <p id="magnets-count" class="i-count lm-count"></p>
      <button id="new-magnet-button" type="button" class="a-btn a-btn-primary i-btn">+ New guide</button>
    </div>
    <div id="magnets-table-body" class="lm-grid"></div>
    <div id="lm-empty" class="t-card t-empty" hidden><b>No guides yet.</b>A short, useful PDF (for example "5 signs it's time to see a counselor") on a matching page turns readers into people you can follow up with.</div>
  </div>

  <div id="magnets-edit-view" class="hidden">
    <div class="i-detail-top">
      <button id="back-to-list-button" type="button" class="a-link">&larr; All guides</button>
      <h2 id="edit-heading" class="lm-edit-h">New lead magnet</h2>
    </div>
    <form id="magnet-form" class="bp-form">
      <div class="bp-main">
        <section class="t-card i-fields">
          <div class="i-field">
            <label for="field-title">Title</label>
            <input id="field-title" type="text" required placeholder="e.g. 5 signs it's time to see a counselor" />
          </div>
          <div class="i-field">
            <label for="field-description">Description</label>
            <textarea id="field-description" rows="3" required class="bp-area"></textarea>
            <span class="i-hint">Shown on the page, next to the download form.</span>
          </div>
        </section>

        <section class="t-card">
          <h2>Follow-up emails<span class="t-aside">Leave a day blank to skip it</span></h2>
          <p class="i-hint lm-seq-note">Sent automatically after someone downloads the guide, on top of their instant download link.</p>
          <ol class="lm-seq">
            {
              SEQUENCE_SCHEDULE_DAYS.map((day, index) => {
                const step = index + 1;
                return (
                  <li class="lm-step">
                    <span class="lm-day">Day {day}</span>
                    <div class="lm-step-body i-fields">
                      <div class="i-field">
                        <label for={`sequence-step-${step}-subject`}>Subject</label>
                        <input id={`sequence-step-${step}-subject`} type="text" />
                      </div>
                      <div class="i-field">
                        <label>Email</label>
                        <RichTextEditor id={`sequence-step-${step}-body`} />
                      </div>
                    </div>
                  </li>
                );
              })
            }
          </ol>
        </section>
      </div>

      <aside class="bp-side">
        <section class="t-card i-fields">
          <div class="i-field">
            <label for="field-page">Shown on page</label>
            <select id="field-page" required></select>
            <span class="i-hint">Pages that already have a guide aren't listed. Pick the page whose topic this guide matches.</span>
          </div>
          <div class="i-field">
            <span>The guide file</span>
            <div class="i-inline">
              <label for="field-file" class="a-btn i-btn">Choose file</label>
              <input id="field-file" type="file" accept=".pdf,.doc,.docx,.zip" class="sr-only" />
            </div>
            <span id="field-file-status" class="i-hint"></span>
          </div>
          <div class="bp-actions lm-actions">
            <button id="save-button" type="button" class="a-btn a-btn-primary">Save</button>
          </div>
          <p id="form-status" class="i-hint" role="status"></p>
          <button id="delete-button" type="button" class="a-link i-danger hidden bp-delete">Delete guide</button>
        </section>
        <section class="t-card i-fields">
          <h2>Cover image</h2>
          <img id="field-image-preview" class="hidden bp-img" alt="" />
          <div class="i-inline">
            <button id="search-unsplash-button" type="button" class="a-btn i-btn">Search Unsplash</button>
            <label for="field-image-file" class="a-btn i-btn">Upload</label>
            <input id="field-image-file" type="file" accept="image/*" class="sr-only" />
          </div>
          <span id="field-image-status" class="i-hint"></span>
        </section>
      </aside>
    </form>
  </div>

  <UnsplashSearchModal />
</AdminLayout>

<script>
  import { supabase, initAdminAuth } from '../../lib/adminAuth';
  import { callPublishFunction } from '../../lib/publishFunction';
  import { initUnsplashSearchModal, type UnsplashPhoto } from '../../lib/unsplashSearch';
  import { initRichTextEditor, type RichTextEditorHandle } from '../../lib/richTextEditor';
  import { SEQUENCE_SCHEDULE_DAYS } from '../../lib/nurtureSequence';

  type LeadMagnet = {
    id: string;
    page_id: string;
    title: string;
    description: string;
    file_url: string;
    file_name: string;
    image_url: string | null;
    image_alt: string | null;
    image_credit_name: string | null;
    image_credit_url: string | null;
  };

  type SequenceStep = { step_order: number; subject: string; body: string };

  type PageOption = { id: string; title: string };

  const listView = document.getElementById('magnets-list-view')!;
  const editView = document.getElementById('magnets-edit-view')!;
  const totalLeadsCount = document.getElementById('total-leads-count')!;
  const magnetsCount = document.getElementById('magnets-count')!;
  const tableBody = document.getElementById('magnets-table-body')!;
  const newMagnetButton = document.getElementById('new-magnet-button')!;
  const backButton = document.getElementById('back-to-list-button')!;
  const editHeading = document.getElementById('edit-heading')!;
  const saveButton = document.getElementById('save-button')!;
  const deleteButton = document.getElementById('delete-button')!;
  const formStatus = document.getElementById('form-status')!;

  const titleField = document.getElementById('field-title') as HTMLInputElement;
  const descriptionField = document.getElementById('field-description') as HTMLTextAreaElement;
  const pageField = document.getElementById('field-page') as HTMLSelectElement;
  const fileField = document.getElementById('field-file') as HTMLInputElement;
  const fileStatus = document.getElementById('field-file-status')!;
  const imageFileField = document.getElementById('field-image-file') as HTMLInputElement;
  const imageStatus = document.getElementById('field-image-status')!;
  const imagePreview = document.getElementById('field-image-preview') as HTMLImageElement;

  const sequenceSubjectFields = SEQUENCE_SCHEDULE_DAYS.map(
    (_, index) => document.getElementById(`sequence-step-${index + 1}-subject`) as HTMLInputElement
  );
  const sequenceEditors: RichTextEditorHandle[] = SEQUENCE_SCHEDULE_DAYS.map((_, index) =>
    initRichTextEditor(`sequence-step-${index + 1}-body`)
  );

  let magnets: LeadMagnet[] = [];
  let pages: PageOption[] = [];
  let leadCountsByMagnet = new Map<string, number>();
  let stepsByMagnet = new Map<string, number>();
  let editingId: string | null = null;
  let uploadedFileUrl: string | null = null;
  let uploadedFileName: string | null = null;
  let selectedImage: { url: string; alt: string; creditName: string | null; creditUrl: string | null } | null = null;

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function showList() {
    editView.classList.add('hidden');
    listView.classList.remove('hidden');
  }

  function showEdit() {
    listView.classList.add('hidden');
    editView.classList.remove('hidden');
  }

  async function loadLeadCounts() {
    const [{ data }, { data: inquiries }, { data: steps }] = await Promise.all([
      supabase.from('leads').select('lead_magnet_id, email, created_at').not('lead_magnet_id', 'is', null),
      supabase.from('leads').select('email').is('lead_magnet_id', null),
      supabase.from('lead_magnet_sequence_steps').select('lead_magnet_id'),
    ]);
    leadCountsByMagnet = new Map();
    for (const row of data ?? []) {
      const id = row.lead_magnet_id as string;
      leadCountsByMagnet.set(id, (leadCountsByMagnet.get(id) ?? 0) + 1);
    }
    stepsByMagnet = new Map();
    for (const row of steps ?? []) stepsByMagnet.set(row.lead_magnet_id, (stepsByMagnet.get(row.lead_magnet_id) ?? 0) + 1);
    const total = [...leadCountsByMagnet.values()].reduce((sum, n) => sum + n, 0);
    totalLeadsCount.textContent = String(total);

    const cutoff = Date.now() - 30 * 86_400_000;
    const recent = (data ?? []).filter((r) => new Date(r.created_at as string).getTime() >= cutoff).length;
    document.getElementById('lm-recent')!.textContent = String(recent);
    document.getElementById('lm-recent-sub')!.textContent = total ? `${Math.round((recent / total) * 100)}% of all downloads` : '';

    // Same rule as Inquiry trends: one person per email on both sides.
    const norm = (e: unknown) => String(e ?? '').trim().toLowerCase();
    const inquiryEmails = new Set((inquiries ?? []).map((r) => norm(r.email)).filter(Boolean));
    const people = new Set((data ?? []).map((r) => norm(r.email)).filter(Boolean));
    const converted = [...people].filter((e) => inquiryEmails.has(e)).length;
    document.getElementById('lm-conv')!.textContent = people.size ? String(converted) : '—';
    document.getElementById('lm-conv-sub')!.textContent = people.size ? `${Math.round((converted / people.size) * 100)}% of ${people.size} people who downloaded` : '';
  }

  async function loadMagnets() {
    const { data, error } = await supabase.from('lead_magnets').select('*').order('title');
    if (error) {
      magnetsCount.textContent = 'Could not load lead magnets: ' + error.message;
      return;
    }
    magnets = data as LeadMagnet[];
    magnetsCount.textContent = `${magnets.length} guide${magnets.length === 1 ? '' : 's'}`;
    document.getElementById('lm-empty')!.hidden = magnets.length > 0;
    tableBody.innerHTML = magnets
      .map((magnet) => {
        const page = pages.find((p) => p.id === magnet.page_id);
        const leadCount = leadCountsByMagnet.get(magnet.id) ?? 0;
        const steps = stepsByMagnet.get(magnet.id) ?? 0;
        return `<button type="button" class="lm-card t-card" data-edit-id="${magnet.id}">
          <span class="lm-cover">${magnet.image_url ? `<img src="${escapeHtml(magnet.image_url)}" alt="" loading="lazy" />` : '<span>PDF</span>'}</span>
          <span class="lm-body">
            <b>${escapeHtml(magnet.title)}</b>
            <small>On ${escapeHtml(page?.title ?? '(page not found)')}</small>
            <span class="lm-stats">
              <span><i class="a-num">${leadCount}</i> download${leadCount === 1 ? '' : 's'}</span>
              <span class="${steps ? '' : 'lm-none'}">${steps ? `${steps} of ${SEQUENCE_SCHEDULE_DAYS.length} follow-up emails` : 'No follow-up emails yet'}</span>
            </span>
          </span>
        </button>`;
      })
      .join('');
  }

  function populatePagePicker() {
    // Only pages with no magnet, plus the page currently being edited (so
    // editing an existing magnet doesn't require re-picking a now-taken page).
    const takenPageIds = new Set(magnets.filter((m) => m.id !== editingId).map((m) => m.page_id));
    const available = pages.filter((p) => !takenPageIds.has(p.id));
    pageField.innerHTML = available.map((p) => `<option value="${p.id}">${escapeHtml(p.title)}</option>`).join('');
  }

  function resetForm() {
    editingId = null;
    uploadedFileUrl = null;
    uploadedFileName = null;
    selectedImage = null;
    titleField.value = '';
    descriptionField.value = '';
    fileField.value = '';
    fileStatus.textContent = '';
    imageFileField.value = '';
    imageStatus.textContent = '';
    imagePreview.classList.add('hidden');
    imagePreview.src = '';
    deleteButton.classList.add('hidden');
    editHeading.textContent = 'New guide';
    formStatus.textContent = '';
    for (const field of sequenceSubjectFields) field.value = '';
    for (const editor of sequenceEditors) editor.setMarkdown('');
    populatePagePicker();
  }

  async function loadMagnetIntoForm(magnet: LeadMagnet) {
    editingId = magnet.id;
    titleField.value = magnet.title;
    descriptionField.value = magnet.description;
    uploadedFileUrl = magnet.file_url;
    uploadedFileName = magnet.file_name;
    fileStatus.textContent = `Current file: ${magnet.file_name} — choose a new one to replace it.`;
    if (magnet.image_url) {
      selectedImage = {
        url: magnet.image_url,
        alt: magnet.image_alt ?? '',
        creditName: magnet.image_credit_name,
        creditUrl: magnet.image_credit_url,
      };
      imagePreview.src = magnet.image_url;
      imagePreview.classList.remove('hidden');
      imageStatus.textContent = 'Current image — choose a new one to replace it.';
    }
    editHeading.textContent = magnet.title;
    deleteButton.classList.remove('hidden');
    populatePagePicker();
    pageField.value = magnet.page_id;

    for (const field of sequenceSubjectFields) field.value = '';
    for (const editor of sequenceEditors) editor.setMarkdown('');
    const { data: steps } = await supabase
      .from('lead_magnet_sequence_steps')
      .select('step_order, subject, body')
      .eq('lead_magnet_id', magnet.id);
    for (const step of (steps ?? []) as SequenceStep[]) {
      const index = step.step_order - 1;
      if (sequenceSubjectFields[index]) sequenceSubjectFields[index].value = step.subject;
      if (sequenceEditors[index]) sequenceEditors[index].setMarkdown(step.body);
    }
  }

  newMagnetButton.addEventListener('click', () => {
    resetForm();
    showEdit();
  });

  backButton.addEventListener('click', showList);

  tableBody.addEventListener('click', async (event) => {
    const card = (event.target as HTMLElement).closest<HTMLElement>('[data-edit-id]');
    if (!card) return;
    const magnet = magnets.find((m) => m.id === card.dataset.editId);
    if (magnet) {
      showEdit();
      window.scrollTo(0, 0);
      await loadMagnetIntoForm(magnet);
    }
  });

  fileField.addEventListener('change', async () => {
    const file = fileField.files?.[0];
    if (!file) return;
    fileStatus.textContent = 'Uploading...';
    const path = `${crypto.randomUUID()}-${file.name.replace(/[^a-zA-Z0-9.-]/g, '_')}`;
    const { error } = await supabase.storage.from('lead-magnet-files').upload(path, file);
    if (error) {
      fileStatus.textContent = 'Upload failed: ' + error.message;
      return;
    }
    const { data: urlData } = supabase.storage.from('lead-magnet-files').getPublicUrl(path);
    uploadedFileUrl = urlData.publicUrl;
    uploadedFileName = file.name;
    fileStatus.textContent = `Uploaded: ${file.name}`;
  });

  imageFileField.addEventListener('change', async () => {
    const file = imageFileField.files?.[0];
    if (!file) return;
    imageStatus.textContent = 'Uploading...';
    const path = `lead-magnets/${Date.now()}-${file.name.replace(/[^a-zA-Z0-9.-]/g, '_')}`;
    const { error } = await supabase.storage.from('site-images').upload(path, file);
    if (error) {
      imageStatus.textContent = 'Upload failed: ' + error.message;
      return;
    }
    const { data: urlData } = supabase.storage.from('site-images').getPublicUrl(path);
    selectedImage = { url: urlData.publicUrl, alt: '', creditName: null, creditUrl: null };
    imagePreview.src = urlData.publicUrl;
    imagePreview.classList.remove('hidden');
    imageStatus.textContent = 'Image uploaded.';
  });

  // ---------------------------------------------------------------------
  initUnsplashSearchModal({
    onSelect: (photo: UnsplashPhoto) => {
      selectedImage = { url: photo.fullUrl, alt: photo.alt, creditName: photo.creditName, creditUrl: photo.creditUrl };
      imagePreview.src = photo.fullUrl;
      imagePreview.classList.remove('hidden');
      imageStatus.textContent = photo.creditName ? `Selected — photo by ${photo.creditName} on Unsplash.` : 'Selected.';
    },
  });

  function validate(): string | null {
    if (!titleField.value.trim()) return 'Title is required.';
    if (!descriptionField.value.trim()) return 'Description is required.';
    if (!pageField.value) return 'Choose a page.';
    if (!uploadedFileUrl || !uploadedFileName) return 'Upload a file.';
    return null;
  }

  saveButton.addEventListener('click', async () => {
    const validationError = validate();
    if (validationError) {
      formStatus.textContent = validationError;
      formStatus.className = 'i-hint r-err';
      return;
    }
    formStatus.textContent = 'Saving...';
    formStatus.className = 'i-hint';
    saveButton.setAttribute('disabled', 'true');

    const payload = {
      title: titleField.value.trim(),
      description: descriptionField.value.trim(),
      page_id: pageField.value,
      file_url: uploadedFileUrl,
      file_name: uploadedFileName,
      image_url: selectedImage?.url ?? null,
      image_alt: selectedImage?.alt ?? null,
      image_credit_name: selectedImage?.creditName ?? null,
      image_credit_url: selectedImage?.creditUrl ?? null,
    };

    const { data: savedMagnet, error } = editingId
      ? await supabase.from('lead_magnets').update(payload).eq('id', editingId).select().single()
      : await supabase.from('lead_magnets').insert(payload).select().single();

    if (error || !savedMagnet) {
      saveButton.removeAttribute('disabled');
      formStatus.textContent = 'Could not save: ' + (error?.message ?? 'unknown error');
      formStatus.className = 'i-hint r-err';
      return;
    }

    // Sequence steps: upsert whichever days have real content, and delete
    // any that were cleared out — a blank subject+body means "skip this
    // day," represented as no row rather than an empty one, matching what
    // the sending function checks for.
    const stepsPayload: SequenceStep[] = SEQUENCE_SCHEDULE_DAYS.map((_, index) => ({
      step_order: index + 1,
      subject: sequenceSubjectFields[index].value.trim(),
      body: sequenceEditors[index].getMarkdown().trim(),
    }));
    const nonEmptySteps = stepsPayload.filter((s) => s.subject || s.body);
    const blankStepOrders = stepsPayload.filter((s) => !s.subject && !s.body).map((s) => s.step_order);

    if (nonEmptySteps.length > 0) {
      const { error: stepsError } = await supabase.from('lead_magnet_sequence_steps').upsert(
        nonEmptySteps.map((s) => ({ ...s, lead_magnet_id: savedMagnet.id })),
        { onConflict: 'lead_magnet_id,step_order' }
      );
      if (stepsError) {
        saveButton.removeAttribute('disabled');
        formStatus.textContent = 'Lead magnet saved, but the email sequence failed to save: ' + stepsError.message;
        formStatus.className = 'i-hint r-err';
        return;
      }
    }
    if (blankStepOrders.length > 0) {
      await supabase
        .from('lead_magnet_sequence_steps')
        .delete()
        .eq('lead_magnet_id', savedMagnet.id)
        .in('step_order', blankStepOrders);
    }

    saveButton.removeAttribute('disabled');

    formStatus.textContent = 'Saving your site...';
    const result = await callPublishFunction({ action: 'publish' });
    formStatus.textContent = result.ok
      ? 'Saved! Your site will update shortly.'
      : "Saved, but the update trigger failed — it will go live on the next rebuild.";
    formStatus.className = result.ok ? 'i-hint r-ok' : 'i-hint r-warn';

    // Counts first: the cards read them.
    await loadLeadCounts();
    await loadMagnets();
    showList();
  });

  deleteButton.addEventListener('click', async () => {
    if (!editingId) return;
    if (!window.confirm('Delete this lead magnet? This cannot be undone.')) return;
    const { error } = await supabase.from('lead_magnets').delete().eq('id', editingId);
    if (error) {
      window.alert('Could not delete: ' + error.message);
      return;
    }
    await callPublishFunction({ action: 'publish' });
    // Counts first: the cards read them.
    await loadLeadCounts();
    await loadMagnets();
    showList();
  });

  async function onAuthed() {
    const { data: pagesData } = await supabase
      .from('pages')
      .select('id, title')
      .neq('page_type', 'Blog Index')
      .order('title');
    pages = (pagesData ?? []) as PageOption[];
    await loadLeadCounts();
    await loadMagnets();
    resetForm();
  }

  initAdminAuth(onAuthed, { allowedRoles: ['owner', 'agency'] });
</script>
