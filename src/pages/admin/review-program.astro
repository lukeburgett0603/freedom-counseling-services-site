---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { withBase } from '../../lib/url';
import { ETHICS_CHECKLIST, EVENT_CARD_COPY, EVENT_RULES, REVIEW_REPLY, NEGATIVE_REVIEW_PROTOCOL, STAFF_GUIDELINES } from '../../lib/reviewProgram';
---

<!--
  "Trusted Without Asking," the ethical Google review program: the
  review half of "Get Chosen" in the Full Caseload System. Nothing here
  ever asks a current or former client for a review (ACA C.3.b, APA 5.05,
  NASW 4.07(b)). Replaced the waiting-room sign and /share-your-experience
  page on 2026-10-03 (that URL now redirects home, see astro.config.mjs).
  Sections follow the program's five pillars: remove client-directed asks,
  be findable with no ask (the "Find us on Google" link), earn reviews
  from non-clients at public events (event QR kit), HIPAA-safe replies,
  and measure more than stars. All copy is in src/lib/reviewProgram.ts.
-->
<AdminLayout title="Review program | Admin" current="review-program">
  <div class="max-w-4xl space-y-8">
    <div>
      <h1 class="font-[family-name:var(--font-heading)] text-2xl font-extrabold tracking-tight text-brand-ink">Trusted Without Asking</h1>
      <p class="mt-2 text-sm text-slate-600">
        Build a strong Google reputation without ever asking a client for a review. Make your practice easy to find, earn
        reviews from people who attend your public events, reply to every review the same privacy-safe way, and measure
        the calls and inquiries your profile brings in, not just the stars.
      </p>
    </div>

    <section class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">1. Ethics check</p>
      <p class="mt-2 text-sm text-slate-600">
        Go through your office, paperwork, and messages once and make sure every one of these is true. A sign or a
        discharge flier is still a request aimed at clients, even when it's "passive."
      </p>
      <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-slate-700">
        {ETHICS_CHECKLIST.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">2. Your Google links</p>

      <div class="mt-3">
        <label for="profile-url-input" class="block text-sm font-semibold text-brand-ink">Business Profile link</label>
        <p class="mt-1 text-sm text-slate-600">
          Your listing on Google Maps (in Maps, open your practice and choose <span class="font-semibold">Share</span>).
          It adds a "Find us on Google" link to your website's footer and contact page. No mention of reviews.
        </p>
        <div class="mt-2 flex flex-wrap gap-2">
          <input id="profile-url-input" type="url" placeholder="https://maps.app.goo.gl/..." class="min-w-0 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm" />
          <button id="profile-url-save" type="button" class="rounded-md bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90">Save</button>
        </div>
        <p id="profile-url-status" class="mt-2 text-sm" role="status"></p>
      </div>

      <div class="mt-5 border-t border-slate-100 pt-5">
        <label for="review-url-input" class="block text-sm font-semibold text-brand-ink">Review link (public events only)</label>
        <p class="mt-1 text-sm text-slate-600">
          In your Google Business Profile, choose <span class="font-semibold">Ask for reviews</span> and copy the link. It's
          used only in the event QR kit below. Never put it on your website or in anything clients receive.
        </p>
        <div class="mt-2 flex flex-wrap gap-2">
          <input id="review-url-input" type="url" placeholder="https://g.page/r/.../review" class="min-w-0 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm" />
          <button id="review-url-save" type="button" class="rounded-md bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90">Save</button>
        </div>
        <p id="review-url-status" class="mt-2 text-sm" role="status"></p>
      </div>
    </section>

    <section class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">3. Event QR kit</p>
          <p class="mt-2 text-sm text-slate-600">
            For workshops, talks, and trainings open to the public. Put the card on your closing slide or handout so
            attendees can review the event.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button id="download-qr-button" type="button" disabled class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50">Download QR (PNG)</button>
          <button id="print-card-button" type="button" disabled class="rounded-md bg-brand-accent px-4 py-2 text-sm font-semibold text-white hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50">Print handout card</button>
        </div>
      </div>
      <p class="mt-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm font-semibold text-amber-900">
        Public events only. Never in your waiting room, session rooms, client portal, reminders, or discharge papers.
      </p>
      <p id="event-kit-missing" class="mt-3 text-sm text-slate-500">Add your review link above to generate the QR code.</p>
      <div id="card-preview" class="mx-auto mt-5 hidden max-w-sm rounded-lg border border-slate-200 bg-brand-neutral p-8 text-center">
        <p class="font-[family-name:var(--font-heading)] text-xl font-extrabold leading-snug text-brand-ink">{EVENT_CARD_COPY.heading}</p>
        <p class="mt-3 text-sm text-slate-700">{EVENT_CARD_COPY.body}</p>
        <div id="card-qr" class="mx-auto mt-5 h-36 w-36"></div>
        <p class="mt-2 text-xs font-semibold text-slate-700">{EVENT_CARD_COPY.qrCaption}</p>
        <p class="mt-5 text-[11px] text-slate-500">{EVENT_CARD_COPY.footer}</p>
        <p id="card-practice-name" class="mt-1 text-[11px] font-semibold text-slate-600"></p>
      </div>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <div class="rounded-md border border-emerald-200 bg-emerald-50 p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-emerald-800">Do</p>
          <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm text-slate-700">
            {EVENT_RULES.do.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="rounded-md border border-rose-200 bg-rose-50 p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-rose-800">Don't</p>
          <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm text-slate-700">
            {EVENT_RULES.dont.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">4. Replying to reviews</p>
      <div class="mt-3 flex items-center justify-between gap-3">
        <p class="font-semibold text-brand-ink">The one reply, for every review</p>
        <button type="button" data-copy-target="reply-text" class="copy-button rounded-md border border-slate-300 px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50">Copy</button>
      </div>
      <p class="mt-1 text-xs text-slate-500">
        Use it for positive and negative reviews alike. Anything more specific can confirm someone is a client, which can be
        a HIPAA disclosure.
      </p>
      <p id="reply-text" class="mt-2 rounded-md bg-slate-50 p-4 text-sm text-slate-700">{REVIEW_REPLY}</p>
      <p class="mt-5 font-semibold text-brand-ink">If a review is negative</p>
      <ol class="mt-2 list-decimal space-y-1.5 pl-5 text-sm text-slate-700">
        {NEGATIVE_REVIEW_PROTOCOL.map((item) => <li>{item}</li>)}
      </ol>
    </section>

    <section class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">5. Templates for your paperwork and staff</p>
      <div class="mt-4 space-y-6">
        <div>
          <div class="flex items-center justify-between gap-3">
            <p class="font-semibold text-brand-ink">Review and social media policy (for informed consent)</p>
            <button type="button" data-copy-target="policy-text" class="copy-button rounded-md border border-slate-300 px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50">Copy</button>
          </div>
          <p class="mt-1 text-xs text-slate-500">Have your attorney approve it before it goes into your paperwork.</p>
          <pre id="policy-text" class="mt-2 whitespace-pre-wrap rounded-md bg-slate-50 p-4 font-[family-name:var(--font-body)] text-sm text-slate-700"></pre>
        </div>
        <div>
          <div class="flex items-center justify-between gap-3">
            <p class="font-semibold text-brand-ink">Front-desk script</p>
            <button type="button" data-copy-target="script-text" class="copy-button rounded-md border border-slate-300 px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50">Copy</button>
          </div>
          <p class="mt-1 text-xs text-slate-500">For the one legitimate case: a client asks, on their own, how to leave a review.</p>
          <pre id="script-text" class="mt-2 whitespace-pre-wrap rounded-md bg-slate-50 p-4 font-[family-name:var(--font-body)] text-sm text-slate-700"></pre>
        </div>
        <div>
          <p class="font-semibold text-brand-ink">Staff guidelines</p>
          <div class="mt-2 grid gap-4 sm:grid-cols-2">
            <div class="rounded-md border border-emerald-200 bg-emerald-50 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-emerald-800">Do</p>
              <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm text-slate-700">
                {STAFF_GUIDELINES.do.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="rounded-md border border-rose-200 bg-rose-50 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-rose-800">Don't</p>
              <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm text-slate-700">
                {STAFF_GUIDELINES.dont.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </div>
        <div>
          <div class="flex items-center justify-between gap-3">
            <p class="font-semibold text-brand-ink">Closing (discharge) survey</p>
            <button type="button" data-copy-target="survey-text" class="copy-button rounded-md border border-slate-300 px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50">Copy</button>
          </div>
          <p class="mt-1 text-xs text-slate-500">No review request and no Google link, on purpose. It asks how they first heard about you, which shows which marketing brings clients.</p>
          <pre id="survey-text" class="mt-2 whitespace-pre-wrap rounded-md bg-slate-50 p-4 font-[family-name:var(--font-body)] text-sm text-slate-700"></pre>
        </div>
      </div>
    </section>

    <section class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">6. Track your progress</p>
      <p class="mt-2 text-sm text-slate-600">
        The best measure is what your profile brings in: views, calls, direction requests, and website clicks, on your
        <a href={withBase('/admin/analytics/gbp')} class="font-semibold text-brand-primary underline">Google Business Profile</a> dashboard,
        and inquiries in your Lead CRM. Review count is worth logging too. Once a month, copy your count and star rating
        from your Business Profile.
      </p>
      <form id="snapshot-form" class="mt-3 flex flex-wrap items-end gap-2">
        <div>
          <label for="snapshot-date" class="block text-xs font-semibold text-slate-500">Date</label>
          <input id="snapshot-date" name="recorded_on" type="date" required class="rounded-md border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <div>
          <label for="snapshot-count" class="block text-xs font-semibold text-slate-500">Total reviews</label>
          <input id="snapshot-count" name="review_count" type="number" min="0" required class="w-28 rounded-md border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <div>
          <label for="snapshot-rating" class="block text-xs font-semibold text-slate-500">Star rating</label>
          <input id="snapshot-rating" name="average_rating" type="number" min="1" max="5" step="0.1" class="w-24 rounded-md border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <button type="submit" class="rounded-md bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90">Add</button>
        <span id="snapshot-status" class="text-sm text-red-600" role="status"></span>
      </form>
      <p id="snapshot-summary" class="mt-4 text-sm text-slate-700"></p>
      <table class="mt-2 w-full max-w-md text-left text-sm">
        <thead class="border-b border-slate-200 text-xs text-slate-500">
          <tr><th class="py-2 font-semibold">Date</th><th class="py-2 font-semibold">Reviews</th><th class="py-2 font-semibold">Change</th><th class="py-2 font-semibold">Rating</th><th></th></tr>
        </thead>
        <tbody id="snapshot-body"></tbody>
      </table>
    </section>
  </div>
</AdminLayout>

<script>
  import QRCode from 'qrcode';
  import { supabase, initAdminAuth } from '../../lib/adminAuth';
  // Static, not a dynamic import(): with Vite 8 (Astro 7), a lone dynamic
  // import of a module every other admin page imports statically made the
  // bundler put a shared helper inside this page's entry chunk, so every
  // admin page using publishFunction also ran this page's script and threw.
  import { triggerRebuild } from '../../lib/publishFunction';
  import { EVENT_CARD_COPY, dischargeSurveyTemplate, frontDeskScript, reviewPolicyTemplate } from '../../lib/reviewProgram';

  type Snapshot = { id: string; recorded_on: string; review_count: number; average_rating: number | null };

  const profileUrlInput = document.getElementById('profile-url-input') as HTMLInputElement;
  const reviewUrlInput = document.getElementById('review-url-input') as HTMLInputElement;
  const snapshotForm = document.getElementById('snapshot-form') as HTMLFormElement;
  const snapshotStatus = document.getElementById('snapshot-status')!;
  const printButton = document.getElementById('print-card-button') as HTMLButtonElement;
  const downloadButton = document.getElementById('download-qr-button') as HTMLButtonElement;
  let businessId: string | null = null;
  let practiceName = '';
  let googleFontsUrl: string | null = null;
  let reviewUrl: string | null = null;
  let qrSvg = '';
  let snapshots: Snapshot[] = [];

  // A Google "write a review" link: the g.page/r/.../review short link,
  // or a search/maps URL carrying the writereview action.
  const REVIEW_LINK_PATTERN = /\/review\b|writereview|lrd=/i;

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function formatDate(iso: string): string {
    const [y, m, d] = iso.split('-').map(Number);
    return new Date(y, m - 1, d).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function todayIso(): string {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }

  function setStatus(el: HTMLElement, text: string, tone: 'info' | 'ok' | 'warn' | 'error') {
    const color = { info: 'text-slate-600', ok: 'text-emerald-700', warn: 'text-amber-700', error: 'text-red-600' }[tone];
    el.textContent = text;
    el.className = `mt-2 text-sm ${color}`;
  }

  document.getElementById('profile-url-save')!.addEventListener('click', async () => {
    const status = document.getElementById('profile-url-status')!;
    if (!businessId) return;
    const value = profileUrlInput.value.trim() || null;
    if (value && !/^https:\/\//.test(value)) return setStatus(status, 'That should be a full link starting with https://', 'error');
    // This link goes on the public site, so it must never be the review
    // link: "Find us on Google" with no ask attached is the whole point.
    if (value && REVIEW_LINK_PATTERN.test(value)) {
      return setStatus(status, 'That looks like your review link. Use your profile link here (Share, in Google Maps).', 'error');
    }
    setStatus(status, 'Saving...', 'info');
    const { error } = await supabase.from('business').update({ google_maps_url: value }).eq('id', businessId);
    if (error) return setStatus(status, 'Could not save: ' + error.message, 'error');
    // The footer and contact page are static, so they only pick up the
    // link after a rebuild. Same best-effort rebuild as other business-info saves.
    const result = await triggerRebuild();
    if (result.ok) setStatus(status, 'Saved. Your website will update shortly.', 'ok');
    else setStatus(status, 'Saved, but the site update trigger failed. It will go live on the next rebuild.', 'warn');
  });

  // Only the admin uses this link (the event QR kit), so no rebuild.
  document.getElementById('review-url-save')!.addEventListener('click', async () => {
    const status = document.getElementById('review-url-status')!;
    if (!businessId) return;
    const value = reviewUrlInput.value.trim() || null;
    if (value && !/^https:\/\//.test(value)) return setStatus(status, 'That should be a full link starting with https://', 'error');
    setStatus(status, 'Saving...', 'info');
    const { error } = await supabase.from('business').update({ google_review_url: value }).eq('id', businessId);
    if (error) return setStatus(status, 'Could not save: ' + error.message, 'error');
    reviewUrl = value;
    await renderEventKit();
    setStatus(status, 'Saved.', 'ok');
  });

  async function renderEventKit() {
    const ready = Boolean(reviewUrl);
    document.getElementById('card-preview')!.classList.toggle('hidden', !ready);
    document.getElementById('event-kit-missing')!.classList.toggle('hidden', ready);
    printButton.disabled = !ready;
    downloadButton.disabled = !ready;
    qrSvg = ready ? await QRCode.toString(reviewUrl!, { type: 'svg', margin: 0, errorCorrectionLevel: 'M' }) : '';
    document.getElementById('card-qr')!.innerHTML = qrSvg;
  }

  // A large PNG for slide decks (Keynote, PowerPoint, Google Slides).
  downloadButton.addEventListener('click', async () => {
    if (!reviewUrl) return;
    const dataUrl = await QRCode.toDataURL(reviewUrl, { width: 1200, margin: 2, errorCorrectionLevel: 'M' });
    const link = document.createElement('a');
    link.href = dataUrl;
    link.download = 'event-review-qr.png';
    link.click();
  });

  // A self-contained, print-ready letter-size page, printed from a hidden
  // same-page iframe rather than window.open(): a popup blocker would make
  // a new window fail silently, and the admin sidebar never ends up on paper.
  printButton.addEventListener('click', () => {
    if (!qrSvg) return;
    const css = getComputedStyle(document.documentElement);
    const ink = css.getPropertyValue('--color-brand-ink').trim() || '#1c1917';
    const neutral = css.getPropertyValue('--color-brand-neutral').trim() || '#ffffff';
    const heading = css.getPropertyValue('--font-heading').trim() || 'Georgia, serif';
    const body = css.getPropertyValue('--font-body').trim() || 'system-ui, sans-serif';
    // The practice's own brand fonts (business.google_fonts_url), since
    // the admin shell doesn't load them itself.
    const fontLinks = googleFontsUrl ? `<link rel="stylesheet" href="${escapeHtml(googleFontsUrl)}">` : '';
    document.getElementById('card-print-frame')?.remove();
    const frame = document.createElement('iframe');
    frame.id = 'card-print-frame';
    frame.title = 'Event handout card (print)';
    frame.setAttribute('aria-hidden', 'true');
    frame.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;';
    frame.srcdoc = `<!doctype html><html><head><meta charset="utf-8"><title>Event handout card</title>${fontLinks}
      <style>
        @page { size: letter portrait; margin: 0.6in; }
        body { margin: 0; font-family: ${body}; color: ${ink}; }
        .card { box-sizing: border-box; min-height: 9.6in; border: 2px solid ${ink}22; border-radius: 16px; background: ${neutral};
                padding: 0.9in 0.7in; text-align: center; display: flex; flex-direction: column; justify-content: center;
                -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        h1 { font-family: ${heading}; font-size: 36pt; line-height: 1.15; margin: 0 0 0.3in; }
        p.body { font-size: 17pt; line-height: 1.45; margin: 0 auto; max-width: 5.6in; }
        .qr { width: 2.6in; height: 2.6in; margin: 0.45in auto 0.12in; }
        .qr svg { width: 100%; height: 100%; }
        p.caption { font-size: 14pt; font-weight: 600; margin: 0; }
        p.footer { font-size: 11pt; opacity: 0.75; margin: 0.5in 0 0.05in; }
        p.name { font-size: 12pt; font-weight: 600; margin: 0; }
      </style></head><body>
      <div class="card">
        <h1>${escapeHtml(EVENT_CARD_COPY.heading)}</h1>
        <p class="body">${escapeHtml(EVENT_CARD_COPY.body)}</p>
        <div class="qr">${qrSvg}</div>
        <p class="caption">${escapeHtml(EVENT_CARD_COPY.qrCaption)}</p>
        <p class="footer">${escapeHtml(EVENT_CARD_COPY.footer)}</p>
        <p class="name">${escapeHtml(practiceName)}</p>
      </div>
      </body></html>`;
    frame.addEventListener('load', () => {
      // Give the web font a moment so the heading doesn't print in the fallback.
      setTimeout(() => frame.contentWindow?.print(), 400);
    });
    document.body.appendChild(frame);
  });

  function renderSnapshots() {
    const sorted = [...snapshots].sort((a, b) => b.recorded_on.localeCompare(a.recorded_on));
    const summary = document.getElementById('snapshot-summary')!;
    if (sorted.length === 0) {
      summary.textContent = 'No entries yet. Add your current count to set your starting point.';
    } else {
      const latest = sorted[0];
      const oldest = sorted[sorted.length - 1];
      const gained = latest.review_count - oldest.review_count;
      summary.innerHTML =
        sorted.length > 1
          ? `<span class="font-semibold">${latest.review_count} reviews</span>${latest.average_rating ? `, ${latest.average_rating} stars` : ''}. ${gained >= 0 ? '+' : ''}${gained} since ${formatDate(oldest.recorded_on)}.`
          : `Starting point: <span class="font-semibold">${latest.review_count} reviews</span>${latest.average_rating ? `, ${latest.average_rating} stars` : ''}.`;
    }
    document.getElementById('snapshot-body')!.innerHTML = sorted
      .map((s, i) => {
        const prev = sorted[i + 1];
        const change = prev ? s.review_count - prev.review_count : null;
        return `<tr class="border-b border-slate-100">
          <td class="py-2">${formatDate(s.recorded_on)}</td>
          <td class="py-2 font-semibold">${s.review_count}</td>
          <td class="py-2 ${change && change > 0 ? 'text-emerald-700' : 'text-slate-500'}">${change === null ? '' : `${change > 0 ? '+' : ''}${change}`}</td>
          <td class="py-2">${s.average_rating ?? ''}</td>
          <td class="py-2 text-right"><button type="button" data-snapshot-id="${s.id}" class="delete-snapshot text-xs text-slate-400 hover:text-red-600">Remove</button></td>
        </tr>`;
      })
      .join('');
  }

  snapshotForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    snapshotStatus.textContent = '';
    const data = new FormData(snapshotForm);
    const rating = data.get('average_rating') as string;
    const row = {
      recorded_on: data.get('recorded_on') as string,
      review_count: parseInt(data.get('review_count') as string, 10),
      average_rating: rating ? parseFloat(rating) : null,
    };
    const { data: inserted, error } = await supabase.from('review_snapshots').insert(row).select().single();
    if (error) {
      snapshotStatus.textContent = 'Could not save: ' + error.message;
      return;
    }
    snapshots.push(inserted as Snapshot);
    snapshotForm.reset();
    (document.getElementById('snapshot-date') as HTMLInputElement).value = todayIso();
    renderSnapshots();
  });

  document.getElementById('snapshot-body')!.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('.delete-snapshot');
    if (!button || !window.confirm('Remove this entry?')) return;
    const { error } = await supabase.from('review_snapshots').delete().eq('id', button.dataset.snapshotId!);
    if (error) {
      window.alert('Could not remove: ' + error.message);
      return;
    }
    snapshots = snapshots.filter((s) => s.id !== button.dataset.snapshotId);
    renderSnapshots();
  });

  document.querySelectorAll<HTMLButtonElement>('.copy-button').forEach((button) => {
    button.addEventListener('click', async () => {
      const text = document.getElementById(button.dataset.copyTarget!)!.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Select and copy';
      }
      setTimeout(() => (button.textContent = 'Copy'), 2000);
    });
  });

  async function load() {
    (document.getElementById('snapshot-date') as HTMLInputElement).value = todayIso();
    const [{ data: business }, { data: rows }] = await Promise.all([
      supabase.from('business').select('id, display_name, google_maps_url, google_review_url, google_fonts_url').single(),
      supabase.from('review_snapshots').select('*'),
    ]);
    businessId = business?.id ?? null;
    practiceName = business?.display_name ?? '';
    googleFontsUrl = business?.google_fonts_url ?? null;
    reviewUrl = business?.google_review_url ?? null;
    profileUrlInput.value = business?.google_maps_url ?? '';
    reviewUrlInput.value = reviewUrl ?? '';
    document.getElementById('card-practice-name')!.textContent = practiceName;
    document.getElementById('policy-text')!.textContent = reviewPolicyTemplate(practiceName || 'Our practice');
    document.getElementById('script-text')!.textContent = frontDeskScript(practiceName || 'our practice');
    document.getElementById('survey-text')!.textContent = dischargeSurveyTemplate(practiceName || 'Our practice');
    snapshots = (rows ?? []) as Snapshot[];
    renderSnapshots();
    await renderEventKit();
  }

  initAdminAuth(load, { allowedRoles: ['owner', 'agency'] });
</script>
