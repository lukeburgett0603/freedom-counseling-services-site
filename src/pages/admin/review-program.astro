---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { withBase } from '../../lib/url';
import { ETHICS_CHECKLIST, EVENT_CARD_COPY, EVENT_RULES, REVIEW_REPLY, NEGATIVE_REVIEW_PROTOCOL, STAFF_GUIDELINES } from '../../lib/reviewProgram';
---

<!--
  "Trusted Without Asking," the ethical Google review program: the
  review half of "Get Chosen" in the Full Caseload System. Nothing here
  ever asks a current or former client for a review (ACA C.3.b, APA 5.05,
  NASW 4.07(b)). Replaced the waiting-room sign and /share-your-experience
  page on 2026-10-03 (that URL now redirects home, see astro.config.mjs).
  Sections follow the program's five pillars: remove client-directed asks,
  be findable with no ask (the "Find us on Google" link), earn reviews
  from non-clients at public events (event QR kit), HIPAA-safe replies,
  and measure more than stars. All copy is in src/lib/reviewProgram.ts.
  Redesigned in phase 3 of the admin redesign (2026-10-07): the review
  count and trend on top with a setup checklist built from real settings,
  and the program's reference material in tabs. Same ids and features.
-->
<AdminLayout title="Reviews | Admin" current="review-program">
  <p class="i-intro">
    <b class="v-name">Trusted Without Asking.</b> A strong Google reputation without ever asking a client for a review.
  </p>

  <div class="t-grid v-top">
    <section class="t-card t-s7 v-rep">
      <h2>Your Google reviews<span class="t-aside" id="v-rep-when"></span></h2>
      <div class="v-rep-head">
        <div>
          <span class="v-big a-num" id="v-count">—</span>
          <span class="v-unit">reviews</span>
        </div>
        <div class="v-rating" id="v-rating" hidden>
          <span class="v-stars" aria-hidden="true"><span class="v-stars-fill" id="v-stars-fill"></span></span>
          <b class="a-num" id="v-rating-num"></b>
        </div>
      </div>
      <p id="snapshot-summary" class="v-summary"></p>
      <div class="v-chart" id="v-chart" aria-hidden="true"></div>

      <form id="snapshot-form" class="v-log">
        <div class="i-field">
          <label for="snapshot-date">Date</label>
          <input id="snapshot-date" name="recorded_on" type="date" required />
        </div>
        <div class="i-field">
          <label for="snapshot-count">Total reviews</label>
          <input id="snapshot-count" name="review_count" type="number" min="0" required inputmode="numeric" />
        </div>
        <div class="i-field">
          <label for="snapshot-rating">Star rating</label>
          <input id="snapshot-rating" name="average_rating" type="number" min="1" max="5" step="0.1" inputmode="decimal" />
        </div>
        <button type="submit" class="a-btn a-btn-primary i-btn">Log count</button>
      </form>
      <p id="snapshot-status" class="i-hint r-err" role="status"></p>
      <p class="i-hint">Once a month, copy the count and star rating from your Business Profile.</p>

      <details class="v-history" id="v-history">
        <summary>History</summary>
        <table class="i-table v-table">
          <thead><tr><th>Date</th><th class="r-num">Reviews</th><th class="r-num">Change</th><th class="r-num">Rating</th><th><span class="sr-only">Remove</span></th></tr></thead>
          <tbody id="snapshot-body"></tbody>
        </table>
      </details>
    </section>

    <section class="t-card t-s5 v-setup">
      <h2>Program setup<span class="t-aside" id="v-setup-count"></span></h2>
      <ul class="v-steps" id="v-steps"></ul>
      <p class="v-measure">
        Stars are only part of it. What your profile brings in (views, calls, directions, website clicks) is on
        <a href={withBase('/admin/analytics/gbp')}>Google profile</a>, and the people it sends are in
        <a href={withBase('/admin/crm')}>Inquiries</a>.
      </p>
    </section>
  </div>

  <section class="t-card v-guide">
    <div class="i-seg v-tabs" role="tablist" aria-label="Review program">
      <button type="button" role="tab" data-tab="ethics" aria-selected="true">Ethics check</button>
      <button type="button" role="tab" data-tab="links" aria-selected="false">Google links</button>
      <button type="button" role="tab" data-tab="events" aria-selected="false">Event kit</button>
      <button type="button" role="tab" data-tab="replies" aria-selected="false">Replying</button>
      <button type="button" role="tab" data-tab="templates" aria-selected="false">Templates</button>
    </div>

    <div class="v-panel" data-panel="ethics" role="tabpanel">
      <p class="v-lede">
        Go through your office, paperwork, and messages once and make sure every one of these is true. A sign or a
        discharge flier is still a request aimed at clients, even when it's "passive."
      </p>
      <ul class="v-checklist">
        {ETHICS_CHECKLIST.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="v-panel" data-panel="links" role="tabpanel" hidden>
      <div class="v-link">
        <div class="i-field">
          <label for="profile-url-input">Business Profile link</label>
          <p class="v-help">
            Your listing on Google Maps (in Maps, open your practice and choose <b>Share</b>). It adds a "Find us on
            Google" link to your website's footer and contact page. No mention of reviews.
          </p>
          <div class="i-inline v-url">
            <input id="profile-url-input" type="url" placeholder="https://maps.app.goo.gl/..." />
            <button id="profile-url-save" type="button" class="a-btn a-btn-primary i-btn">Save</button>
          </div>
          <p id="profile-url-status" class="i-hint" role="status"></p>
        </div>
      </div>
      <div class="v-link">
        <div class="i-field">
          <label for="review-url-input">Review link (public events only)</label>
          <p class="v-help">
            In your Google Business Profile, choose <b>Ask for reviews</b> and copy the link. It's used only in the event
            kit. Never put it on your website or in anything clients receive.
          </p>
          <div class="i-inline v-url">
            <input id="review-url-input" type="url" placeholder="https://g.page/r/.../review" />
            <button id="review-url-save" type="button" class="a-btn a-btn-primary i-btn">Save</button>
          </div>
          <p id="review-url-status" class="i-hint" role="status"></p>
        </div>
      </div>
    </div>

    <div class="v-panel" data-panel="events" role="tabpanel" hidden>
      <div class="r-kit-row">
        <p class="v-lede">
          For workshops, talks, and trainings open to the public. Put the card on your closing slide or handout so
          attendees can review the event.
        </p>
        <div class="i-inline">
          <button id="download-qr-button" type="button" disabled class="a-btn i-btn">Download QR (PNG)</button>
          <button id="print-card-button" type="button" disabled class="a-btn a-btn-primary i-btn">Print handout card</button>
        </div>
      </div>
      <p class="v-warn">Public events only. Never in your waiting room, session rooms, client portal, reminders, or discharge papers.</p>
      <p id="event-kit-missing" class="v-help">
        Add your review link under <button type="button" class="a-link" data-goto="links">Google links</button> to generate the QR code.
      </p>
      <div class="v-event">
        <div id="card-preview" class="v-paper" hidden>
          <p class="v-paper-h">{EVENT_CARD_COPY.heading}</p>
          <p class="v-paper-b">{EVENT_CARD_COPY.body}</p>
          <div id="card-qr" class="v-paper-qr"></div>
          <p class="v-paper-cap">{EVENT_CARD_COPY.qrCaption}</p>
          <p class="v-paper-f">{EVENT_CARD_COPY.footer}</p>
          <p id="card-practice-name" class="v-paper-n"></p>
        </div>
        <div class="v-dodont">
          <div class="v-do">
            <p>Do</p>
            <ul>{EVENT_RULES.do.map((item) => <li>{item}</li>)}</ul>
          </div>
          <div class="v-dont">
            <p>Don't</p>
            <ul>{EVENT_RULES.dont.map((item) => <li>{item}</li>)}</ul>
          </div>
        </div>
      </div>
    </div>

    <div class="v-panel" data-panel="replies" role="tabpanel" hidden>
      <div class="v-block">
        <div class="v-block-head">
          <b>The one reply, for every review</b>
          <button type="button" data-copy-target="reply-text" class="copy-button a-btn i-btn">Copy</button>
        </div>
        <p class="v-help">
          Use it for positive and negative reviews alike. Anything more specific can confirm someone is a client, which can
          be a HIPAA disclosure.
        </p>
        <p id="reply-text" class="v-quote">{REVIEW_REPLY}</p>
      </div>
      <div class="v-block">
        <b>If a review is negative</b>
        <ol class="v-numbered">
          {NEGATIVE_REVIEW_PROTOCOL.map((item) => <li>{item}</li>)}
        </ol>
      </div>
    </div>

    <div class="v-panel" data-panel="templates" role="tabpanel" hidden>
      <div class="v-block">
        <div class="v-block-head">
          <b>Review and social media policy (for informed consent)</b>
          <button type="button" data-copy-target="policy-text" class="copy-button a-btn i-btn">Copy</button>
        </div>
        <p class="v-help">Have your attorney approve it before it goes into your paperwork.</p>
        <pre id="policy-text" class="v-quote"></pre>
      </div>
      <div class="v-block">
        <div class="v-block-head">
          <b>Front-desk script</b>
          <button type="button" data-copy-target="script-text" class="copy-button a-btn i-btn">Copy</button>
        </div>
        <p class="v-help">For the one legitimate case: a client asks, on their own, how to leave a review.</p>
        <pre id="script-text" class="v-quote"></pre>
      </div>
      <div class="v-block">
        <b>Staff guidelines</b>
        <div class="v-dodont v-dodont-2">
          <div class="v-do">
            <p>Do</p>
            <ul>{STAFF_GUIDELINES.do.map((item) => <li>{item}</li>)}</ul>
          </div>
          <div class="v-dont">
            <p>Don't</p>
            <ul>{STAFF_GUIDELINES.dont.map((item) => <li>{item}</li>)}</ul>
          </div>
        </div>
      </div>
      <div class="v-block">
        <div class="v-block-head">
          <b>Closing (discharge) survey</b>
          <button type="button" data-copy-target="survey-text" class="copy-button a-btn i-btn">Copy</button>
        </div>
        <p class="v-help">No review request and no Google link, on purpose. It asks how they first heard about you, which shows which marketing brings clients.</p>
        <pre id="survey-text" class="v-quote"></pre>
      </div>
    </div>
  </section>
</AdminLayout>

<script>
  import QRCode from 'qrcode';
  import { supabase, initAdminAuth } from '../../lib/adminAuth';
  // Static, not a dynamic import(): with Vite 8 (Astro 7), a lone dynamic
  // import of a module every other admin page imports statically made the
  // bundler put a shared helper inside this page's entry chunk, so every
  // admin page using publishFunction also ran this page's script and threw.
  import { triggerRebuild } from '../../lib/publishFunction';
  import { EVENT_CARD_COPY, dischargeSurveyTemplate, frontDeskScript, reviewPolicyTemplate } from '../../lib/reviewProgram';

  type Snapshot = { id: string; recorded_on: string; review_count: number; average_rating: number | null; created_at: string };

  const profileUrlInput = document.getElementById('profile-url-input') as HTMLInputElement;
  const reviewUrlInput = document.getElementById('review-url-input') as HTMLInputElement;
  const snapshotForm = document.getElementById('snapshot-form') as HTMLFormElement;
  const snapshotStatus = document.getElementById('snapshot-status')!;
  const printButton = document.getElementById('print-card-button') as HTMLButtonElement;
  const downloadButton = document.getElementById('download-qr-button') as HTMLButtonElement;
  let businessId: string | null = null;
  let practiceName = '';
  let googleFontsUrl: string | null = null;
  let reviewUrl: string | null = null;
  let qrSvg = '';
  let snapshots: Snapshot[] = [];
  let profileUrl: string | null = null;

  // A Google "write a review" link: the g.page/r/.../review short link,
  // or a search/maps URL carrying the writereview action.
  const REVIEW_LINK_PATTERN = /\/review\b|writereview|lrd=/i;

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function formatDate(iso: string): string {
    const [y, m, d] = iso.split('-').map(Number);
    return new Date(y, m - 1, d).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function todayIso(): string {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }

  function setStatus(el: HTMLElement, text: string, tone: 'info' | 'ok' | 'warn' | 'error') {
    const color = { info: '', ok: 'r-ok', warn: 'r-warn', error: 'r-err' }[tone];
    el.textContent = text;
    el.className = `i-hint ${color}`;
  }

  document.getElementById('profile-url-save')!.addEventListener('click', async () => {
    const status = document.getElementById('profile-url-status')!;
    if (!businessId) return;
    const value = profileUrlInput.value.trim() || null;
    if (value && !/^https:\/\//.test(value)) return setStatus(status, 'That should be a full link starting with https://', 'error');
    // This link goes on the public site, so it must never be the review
    // link: "Find us on Google" with no ask attached is the whole point.
    if (value && REVIEW_LINK_PATTERN.test(value)) {
      return setStatus(status, 'That looks like your review link. Use your profile link here (Share, in Google Maps).', 'error');
    }
    setStatus(status, 'Saving...', 'info');
    const { error } = await supabase.from('business').update({ google_maps_url: value }).eq('id', businessId);
    if (error) return setStatus(status, 'Could not save: ' + error.message, 'error');
    profileUrl = value;
    renderSetup();
    // The footer and contact page are static, so they only pick up the
    // link after a rebuild. Same best-effort rebuild as other business-info saves.
    const result = await triggerRebuild();
    if (result.ok) setStatus(status, 'Saved. Your website will update shortly.', 'ok');
    else setStatus(status, 'Saved, but the site update trigger failed. It will go live on the next rebuild.', 'warn');
  });

  // Only the admin uses this link (the event QR kit), so no rebuild.
  document.getElementById('review-url-save')!.addEventListener('click', async () => {
    const status = document.getElementById('review-url-status')!;
    if (!businessId) return;
    const value = reviewUrlInput.value.trim() || null;
    if (value && !/^https:\/\//.test(value)) return setStatus(status, 'That should be a full link starting with https://', 'error');
    setStatus(status, 'Saving...', 'info');
    const { error } = await supabase.from('business').update({ google_review_url: value }).eq('id', businessId);
    if (error) return setStatus(status, 'Could not save: ' + error.message, 'error');
    reviewUrl = value;
    await renderEventKit();
    renderSetup();
    setStatus(status, 'Saved.', 'ok');
  });

  async function renderEventKit() {
    const ready = Boolean(reviewUrl);
    document.getElementById('card-preview')!.hidden = !ready;
    document.getElementById('event-kit-missing')!.hidden = ready;
    printButton.disabled = !ready;
    downloadButton.disabled = !ready;
    qrSvg = ready ? await QRCode.toString(reviewUrl!, { type: 'svg', margin: 0, errorCorrectionLevel: 'M' }) : '';
    document.getElementById('card-qr')!.innerHTML = qrSvg;
  }

  // A large PNG for slide decks (Keynote, PowerPoint, Google Slides).
  downloadButton.addEventListener('click', async () => {
    if (!reviewUrl) return;
    const dataUrl = await QRCode.toDataURL(reviewUrl, { width: 1200, margin: 2, errorCorrectionLevel: 'M' });
    const link = document.createElement('a');
    link.href = dataUrl;
    link.download = 'event-review-qr.png';
    link.click();
  });

  // A self-contained, print-ready letter-size page, printed from a hidden
  // same-page iframe rather than window.open(): a popup blocker would make
  // a new window fail silently, and the admin sidebar never ends up on paper.
  printButton.addEventListener('click', () => {
    if (!qrSvg) return;
    const css = getComputedStyle(document.documentElement);
    const ink = css.getPropertyValue('--color-brand-ink').trim() || '#1c1917';
    const neutral = css.getPropertyValue('--color-brand-neutral').trim() || '#ffffff';
    const heading = css.getPropertyValue('--font-heading').trim() || 'Georgia, serif';
    const body = css.getPropertyValue('--font-body').trim() || 'system-ui, sans-serif';
    // The practice's own brand fonts (business.google_fonts_url), since
    // the admin shell doesn't load them itself.
    const fontLinks = googleFontsUrl ? `<link rel="stylesheet" href="${escapeHtml(googleFontsUrl)}">` : '';
    document.getElementById('card-print-frame')?.remove();
    const frame = document.createElement('iframe');
    frame.id = 'card-print-frame';
    frame.title = 'Event handout card (print)';
    frame.setAttribute('aria-hidden', 'true');
    frame.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;';
    frame.srcdoc = `<!doctype html><html><head><meta charset="utf-8"><title>Event handout card</title>${fontLinks}
      <style>
        @page { size: letter portrait; margin: 0.6in; }
        body { margin: 0; font-family: ${body}; color: ${ink}; }
        .card { box-sizing: border-box; min-height: 9.6in; border: 2px solid ${ink}22; border-radius: 16px; background: ${neutral};
                padding: 0.9in 0.7in; text-align: center; display: flex; flex-direction: column; justify-content: center;
                -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        h1 { font-family: ${heading}; font-size: 36pt; line-height: 1.15; margin: 0 0 0.3in; }
        p.body { font-size: 17pt; line-height: 1.45; margin: 0 auto; max-width: 5.6in; }
        .qr { width: 2.6in; height: 2.6in; margin: 0.45in auto 0.12in; }
        .qr svg { width: 100%; height: 100%; }
        p.caption { font-size: 14pt; font-weight: 600; margin: 0; }
        p.footer { font-size: 11pt; opacity: 0.75; margin: 0.5in 0 0.05in; }
        p.name { font-size: 12pt; font-weight: 600; margin: 0; }
      </style></head><body>
      <div class="card">
        <h1>${escapeHtml(EVENT_CARD_COPY.heading)}</h1>
        <p class="body">${escapeHtml(EVENT_CARD_COPY.body)}</p>
        <div class="qr">${qrSvg}</div>
        <p class="caption">${escapeHtml(EVENT_CARD_COPY.qrCaption)}</p>
        <p class="footer">${escapeHtml(EVENT_CARD_COPY.footer)}</p>
        <p class="name">${escapeHtml(practiceName)}</p>
      </div>
      </body></html>`;
    frame.addEventListener('load', () => {
      // Give the web font a moment so the heading doesn't print in the fallback.
      setTimeout(() => frame.contentWindow?.print(), 400);
    });
    document.body.appendChild(frame);
  });

  function shortDate(iso: string): string {
    const [y, m, d] = iso.split('-').map(Number);
    return new Date(y, m - 1, d).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
  }

  function sortedSnapshots(): Snapshot[] {
    // Newest first; two entries on the same day go by when they were logged.
    return [...snapshots].sort((a, b) => b.recorded_on.localeCompare(a.recorded_on) || (b.created_at ?? '').localeCompare(a.created_at ?? ''));
  }

  function renderSnapshots() {
    const sorted = sortedSnapshots();
    const latest = sorted[0];
    const oldest = sorted[sorted.length - 1];
    const summary = document.getElementById('snapshot-summary')!;
    document.getElementById('v-count')!.textContent = latest ? String(latest.review_count) : '—';
    document.getElementById('v-rep-when')!.textContent = latest ? `As of ${formatDate(latest.recorded_on)}` : '';
    // The most recent rating logged (the newest entry may skip it).
    // numeric(2,1): coerce in case it arrives as a string.
    const rated = sorted.find((s) => s.average_rating != null);
    const rating = rated ? Number(rated.average_rating) : null;
    document.getElementById('v-rating')!.hidden = rating == null;
    if (rating != null) {
      document.getElementById('v-rating-num')!.textContent = rating.toFixed(1);
      (document.getElementById('v-stars-fill') as HTMLElement).style.width = `${(rating / 5) * 100}%`;
    }
    if (!latest) {
      summary.textContent = 'No entries yet. Log your current count to set your starting point.';
    } else if (sorted.length === 1) {
      summary.textContent = 'Your starting point. Log again next month to see the trend.';
    } else {
      const gained = latest.review_count - oldest.review_count;
      const prev = sorted[1];
      const lastChange = latest.review_count - prev.review_count;
      summary.innerHTML = `<b class="${gained > 0 ? 'r-ok' : ''}">${gained >= 0 ? '+' : ''}${gained}</b> since ${formatDate(oldest.recorded_on)} · ${lastChange >= 0 ? '+' : ''}${lastChange} since ${shortDate(prev.recorded_on)}`;
    }
    // One point per day: the last entry logged that day.
    const perDay = sorted.filter((s, i) => i === 0 || s.recorded_on !== sorted[i - 1].recorded_on);
    renderChart([...perDay].reverse());
    document.getElementById('v-history')!.hidden = sorted.length === 0;
    document.getElementById('snapshot-body')!.innerHTML = sorted
      .map((s, i) => {
        const prev = sorted[i + 1];
        const change = prev ? s.review_count - prev.review_count : null;
        return `<tr>
          <td>${formatDate(s.recorded_on)}</td>
          <td class="r-num">${s.review_count}</td>
          <td class="r-num ${change && change > 0 ? 'r-ok' : 'i-muted'}">${change === null ? '' : `${change > 0 ? '+' : ''}${change}`}</td>
          <td class="r-num i-muted">${s.average_rating ?? ''}</td>
          <td class="i-right"><button type="button" data-snapshot-id="${s.id}" class="delete-snapshot a-link v-remove">Remove</button></td>
        </tr>`;
      })
      .join('');
    renderSetup();
  }

  // Review count over time: a soft area line, one dot per logged month.
  function renderChart(points: Snapshot[]) {
    const el = document.getElementById('v-chart')!;
    if (points.length < 2) {
      el.innerHTML = '';
      el.hidden = true;
      return;
    }
    el.hidden = false;
    const W = 600, H = 120, P = 8;
    const t = points.map((p) => new Date(p.recorded_on + 'T12:00').getTime());
    const t0 = t[0], t1 = t[t.length - 1] || t0 + 1;
    const counts = points.map((p) => p.review_count);
    const lo = Math.min(...counts), hi = Math.max(...counts);
    const span = Math.max(hi - lo, 1);
    const x = (i: number) => P + ((t[i] - t0) / Math.max(t1 - t0, 1)) * (W - 2 * P);
    const y = (c: number) => H - P - ((c - lo) / span) * (H - 2 * P - 14);
    const line = points.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p.review_count).toFixed(1)}`).join(' ');
    const area = `${line} L${x(points.length - 1).toFixed(1)},${H} L${x(0).toFixed(1)},${H} Z`;
    const dots = points
      .map((p, i) => `<circle cx="${x(i).toFixed(1)}" cy="${y(p.review_count).toFixed(1)}" r="${i === points.length - 1 ? 4 : 2.6}" class="${i === points.length - 1 ? 'v-dot-last' : 'v-dot'}"><title>${formatDate(p.recorded_on)}: ${p.review_count}</title></circle>`)
      .join('');
    el.innerHTML = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none">
      <defs><linearGradient id="v-area" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--a-accent)" stop-opacity="0.28"/><stop offset="1" stop-color="var(--a-accent)" stop-opacity="0"/></linearGradient></defs>
      <path d="${area}" fill="url(#v-area)"/><path d="${line}" class="v-line"/>${dots}</svg>
      <div class="v-axis"><span>${shortDate(points[0].recorded_on)}</span><span>${shortDate(points[points.length - 1].recorded_on)}</span></div>`;
  }

  // Setup steps the dashboard can actually check from saved settings.
  function renderSetup() {
    const now = new Date();
    const thisMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
    const latest = sortedSnapshots()[0];
    const steps = [
      {
        done: Boolean(profileUrl),
        title: '"Find us on Google" link on your website',
        detail: profileUrl ? 'In your footer and on your contact page.' : 'Add your Business Profile link. No mention of reviews.',
        action: 'links',
        label: 'Add link',
      },
      {
        done: Boolean(reviewUrl),
        title: 'Event kit ready',
        detail: reviewUrl ? 'QR card ready for your next public workshop or talk.' : 'Save your review link to make the QR card for public events.',
        action: reviewUrl ? 'events' : 'links',
        label: reviewUrl ? 'Open' : 'Add link',
      },
      {
        done: Boolean(latest && latest.recorded_on.startsWith(thisMonth)),
        title: "This month's count logged",
        detail: latest ? `Last logged ${formatDate(latest.recorded_on)}.` : 'Log your current count to set a starting point.',
        action: 'log',
        label: 'Log it',
      },
    ];
    const done = steps.filter((st) => st.done).length;
    document.getElementById('v-setup-count')!.textContent = `${done} of ${steps.length} done`;
    document.getElementById('v-steps')!.innerHTML = steps
      .map(
        (st) => `<li class="${st.done ? 'done' : ''}">
        <span class="v-check" aria-hidden="true"></span>
        <div><b>${escapeHtml(st.title)}</b><small>${escapeHtml(st.detail)}</small></div>
        ${st.done && st.action !== 'events' ? '' : `<button type="button" class="a-btn i-btn" data-goto="${st.action}">${st.label}</button>`}
      </li>`
      )
      .join('');
  }

  // Tabs for the program's reference material. The open tab is a per-person
  // convenience, kept in the URL hash so a link can point at one.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.v-tabs [data-tab]')];
  function showTab(name: string, focus = false) {
    if (!tabs.some((t) => t.dataset.tab === name)) name = 'ethics';
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === name)));
    document.querySelectorAll<HTMLElement>('.v-panel').forEach((p) => (p.hidden = p.dataset.panel !== name));
    if (focus) {
      history.replaceState(null, '', `#${name}`);
      document.querySelector('.v-guide')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
  tabs.forEach((t) => t.addEventListener('click', () => showTab(t.dataset.tab!, false)));
  showTab(location.hash.slice(1));
  window.addEventListener('hashchange', () => showTab(location.hash.slice(1)));

  document.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement).closest<HTMLElement>('[data-goto]');
    if (!target) return;
    if (target.dataset.goto === 'log') {
      const count = document.getElementById('snapshot-count') as HTMLInputElement;
      count.scrollIntoView({ behavior: 'smooth', block: 'center' });
      count.focus({ preventScroll: true });
      return;
    }
    showTab(target.dataset.goto!, true);
  });

  snapshotForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    snapshotStatus.textContent = '';
    const data = new FormData(snapshotForm);
    const rating = data.get('average_rating') as string;
    const row = {
      recorded_on: data.get('recorded_on') as string,
      review_count: parseInt(data.get('review_count') as string, 10),
      average_rating: rating ? parseFloat(rating) : null,
    };
    const { data: inserted, error } = await supabase.from('review_snapshots').insert(row).select().single();
    if (error) {
      snapshotStatus.textContent = 'Could not save: ' + error.message;
      return;
    }
    snapshots.push(inserted as Snapshot);
    snapshotForm.reset();
    (document.getElementById('snapshot-date') as HTMLInputElement).value = todayIso();
    renderSnapshots();
  });

  document.getElementById('snapshot-body')!.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('.delete-snapshot');
    if (!button || !window.confirm('Remove this entry?')) return;
    const { error } = await supabase.from('review_snapshots').delete().eq('id', button.dataset.snapshotId!);
    if (error) {
      window.alert('Could not remove: ' + error.message);
      return;
    }
    snapshots = snapshots.filter((s) => s.id !== button.dataset.snapshotId);
    renderSnapshots();
  });

  document.querySelectorAll<HTMLButtonElement>('.copy-button').forEach((button) => {
    button.addEventListener('click', async () => {
      const text = document.getElementById(button.dataset.copyTarget!)!.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Select and copy';
      }
      setTimeout(() => (button.textContent = 'Copy'), 2000);
    });
  });

  async function load() {
    (document.getElementById('snapshot-date') as HTMLInputElement).value = todayIso();
    const [{ data: business }, { data: rows }] = await Promise.all([
      supabase.from('business').select('id, display_name, google_maps_url, google_review_url, google_fonts_url').single(),
      supabase.from('review_snapshots').select('*'),
    ]);
    businessId = business?.id ?? null;
    practiceName = business?.display_name ?? '';
    googleFontsUrl = business?.google_fonts_url ?? null;
    reviewUrl = business?.google_review_url ?? null;
    profileUrl = business?.google_maps_url ?? null;
    profileUrlInput.value = business?.google_maps_url ?? '';
    reviewUrlInput.value = reviewUrl ?? '';
    document.getElementById('card-practice-name')!.textContent = practiceName;
    document.getElementById('policy-text')!.textContent = reviewPolicyTemplate(practiceName || 'Our practice');
    document.getElementById('script-text')!.textContent = frontDeskScript(practiceName || 'our practice');
    document.getElementById('survey-text')!.textContent = dischargeSurveyTemplate(practiceName || 'Our practice');
    snapshots = (rows ?? []) as Snapshot[];
    renderSnapshots();
    await renderEventKit();
  }

  initAdminAuth(load, { allowedRoles: ['owner', 'agency'] });
</script>
