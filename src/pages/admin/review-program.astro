---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { SIGN_COPY, STAFF_GUIDELINES } from '../../lib/reviewProgram';
---

<!--
  Ethical review program: the review-growth half of "Get Chosen" in the
  Full Caseload System. Everything here is built so the practice never
  asks a client for a review (ACA Code of Ethics C.3.b): a passive
  waiting-room sign whose QR code leads to /share-your-experience (an
  information page, then the Google link), templates that carry the same
  rule into the practice's own paperwork, and a manual review-count log
  so growth is visible without the Business Profile API. See
  0069_review_program.sql and src/lib/reviewProgram.ts.
-->
<AdminLayout title="Review program | Admin" current="review-program">
  <div class="max-w-4xl space-y-8">
    <p class="text-sm text-slate-600">
      Grow your Google reviews without ever asking a client for one. Clients who want to share their experience find a
      sign in your waiting room, read what posting means for their privacy, and decide for themselves.
    </p>

    <section class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">1. Your Google review link</p>
      <p class="mt-2 text-sm text-slate-600">
        In your Google Business Profile, choose <span class="font-semibold">Ask for reviews</span> and copy the link it
        gives you. It goes on your private "Share your experience" page, never in anything sent to a client.
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        <label for="review-url-input" class="sr-only">Google review link</label>
        <input
          id="review-url-input"
          type="url"
          placeholder="https://g.page/r/.../review"
          class="min-w-0 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm"
        />
        <button id="review-url-save" type="button" class="rounded-md bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90">Save</button>
      </div>
      <p id="review-url-status" class="mt-2 text-sm" role="status"></p>
      <p class="mt-2 text-xs text-slate-500">
        Your "Share your experience" page:
        <a id="public-page-link" href="#" target="_blank" rel="noopener" class="font-semibold text-brand-primary underline"></a>
        (not in search results or your site's menus)
      </p>
    </section>

    <section class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">2. Waiting-room sign</p>
          <p class="mt-2 text-sm text-slate-600">Print it and place it in your waiting room. Only there, never in session rooms or handed to clients.</p>
        </div>
        <button id="print-sign-button" type="button" class="rounded-md bg-brand-accent px-4 py-2 text-sm font-semibold text-white hover:opacity-90">Print sign</button>
      </div>
      <div id="sign-preview" class="mx-auto mt-5 max-w-sm rounded-lg border border-slate-200 bg-brand-neutral p-8 text-center">
        <p class="font-[family-name:var(--font-heading)] text-xl font-extrabold leading-snug text-brand-ink">{SIGN_COPY.heading}</p>
        <p class="mt-3 text-sm text-slate-700">{SIGN_COPY.body}</p>
        <div id="sign-qr" class="mx-auto mt-5 h-36 w-36"></div>
        <p class="mt-2 text-xs font-semibold text-slate-700">{SIGN_COPY.qrCaption}</p>
        <p class="mt-5 text-[11px] text-slate-500">{SIGN_COPY.footer}</p>
        <p id="sign-practice-name" class="mt-1 text-[11px] font-semibold text-slate-600"></p>
      </div>
    </section>

    <section class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">3. Track your reviews</p>
      <p class="mt-2 text-sm text-slate-600">Once a month, copy your review count and star rating from your Google Business Profile.</p>
      <form id="snapshot-form" class="mt-3 flex flex-wrap items-end gap-2">
        <div>
          <label for="snapshot-date" class="block text-xs font-semibold text-slate-500">Date</label>
          <input id="snapshot-date" name="recorded_on" type="date" required class="rounded-md border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <div>
          <label for="snapshot-count" class="block text-xs font-semibold text-slate-500">Total reviews</label>
          <input id="snapshot-count" name="review_count" type="number" min="0" required class="w-28 rounded-md border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <div>
          <label for="snapshot-rating" class="block text-xs font-semibold text-slate-500">Star rating</label>
          <input id="snapshot-rating" name="average_rating" type="number" min="1" max="5" step="0.1" class="w-24 rounded-md border border-slate-300 px-3 py-2 text-sm" />
        </div>
        <button type="submit" class="rounded-md bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:opacity-90">Add</button>
        <span id="snapshot-status" class="text-sm text-red-600" role="status"></span>
      </form>
      <p id="snapshot-summary" class="mt-4 text-sm text-slate-700"></p>
      <table class="mt-2 w-full max-w-md text-left text-sm">
        <thead class="border-b border-slate-200 text-xs text-slate-500">
          <tr><th class="py-2 font-semibold">Date</th><th class="py-2 font-semibold">Reviews</th><th class="py-2 font-semibold">Change</th><th class="py-2 font-semibold">Rating</th><th></th></tr>
        </thead>
        <tbody id="snapshot-body"></tbody>
      </table>
    </section>

    <section class="rounded-lg border border-black/5 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">4. Templates for your paperwork</p>
      <div class="mt-4 space-y-6">
        <div>
          <div class="flex items-center justify-between gap-3">
            <p class="font-semibold text-brand-ink">Online review policy (for intake paperwork)</p>
            <button type="button" data-copy-target="policy-text" class="copy-button rounded-md border border-slate-300 px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50">Copy</button>
          </div>
          <p class="mt-1 text-xs text-slate-500">Add this to your informed consent so every client knows your approach before it ever comes up.</p>
          <pre id="policy-text" class="mt-2 whitespace-pre-wrap rounded-md bg-slate-50 p-4 font-[family-name:var(--font-body)] text-sm text-slate-700"></pre>
        </div>
        <div>
          <div class="flex items-center justify-between gap-3">
            <p class="font-semibold text-brand-ink">Closing (discharge) survey</p>
            <button type="button" data-copy-target="survey-text" class="copy-button rounded-md border border-slate-300 px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-50">Copy</button>
          </div>
          <p class="mt-1 text-xs text-slate-500">No review request, on purpose. It asks how they first heard about you, which shows which marketing brings clients.</p>
          <pre id="survey-text" class="mt-2 whitespace-pre-wrap rounded-md bg-slate-50 p-4 font-[family-name:var(--font-body)] text-sm text-slate-700"></pre>
        </div>
        <div>
          <p class="font-semibold text-brand-ink">Staff guidelines</p>
          <div class="mt-2 grid gap-4 sm:grid-cols-2">
            <div class="rounded-md border border-emerald-200 bg-emerald-50 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-emerald-800">Do</p>
              <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm text-slate-700">
                {STAFF_GUIDELINES.do.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div class="rounded-md border border-rose-200 bg-rose-50 p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-rose-800">Don't</p>
              <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm text-slate-700">
                {STAFF_GUIDELINES.dont.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</AdminLayout>

<script>
  import QRCode from 'qrcode';
  import { supabase, initAdminAuth } from '../../lib/adminAuth';
  import { withBase } from '../../lib/url';
  // Static, not a dynamic import(): with Vite 8 (Astro 7), a lone dynamic
  // import of a module every other admin page imports statically made the
  // bundler put a shared helper inside this page's entry chunk, so every
  // admin page using publishFunction also ran this page's script and threw.
  import { triggerRebuild } from '../../lib/publishFunction';
  import { SIGN_COPY, dischargeSurveyTemplate, reviewPolicyTemplate } from '../../lib/reviewProgram';

  type Snapshot = { id: string; recorded_on: string; review_count: number; average_rating: number | null };

  // The QR must point at the live site, not wherever this admin page
  // happens to be open (e.g. localhost during development).
  const publicUrl = new URL(withBase('/share-your-experience'), import.meta.env.SITE).toString();

  const reviewUrlInput = document.getElementById('review-url-input') as HTMLInputElement;
  const reviewUrlStatus = document.getElementById('review-url-status')!;
  const snapshotForm = document.getElementById('snapshot-form') as HTMLFormElement;
  const snapshotStatus = document.getElementById('snapshot-status')!;
  let businessId: string | null = null;
  let practiceName = '';
  let googleFontsUrl: string | null = null;
  let qrSvg = '';
  let snapshots: Snapshot[] = [];

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function formatDate(iso: string): string {
    const [y, m, d] = iso.split('-').map(Number);
    return new Date(y, m - 1, d).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function todayIso(): string {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }

  const publicLink = document.getElementById('public-page-link') as HTMLAnchorElement;
  publicLink.href = publicUrl;
  publicLink.textContent = publicUrl;

  document.getElementById('review-url-save')!.addEventListener('click', async () => {
    if (!businessId) return;
    const value = reviewUrlInput.value.trim() || null;
    if (value && !/^https:\/\//.test(value)) {
      reviewUrlStatus.textContent = 'That should be a full link starting with https://';
      reviewUrlStatus.className = 'mt-2 text-sm text-red-600';
      return;
    }
    reviewUrlStatus.textContent = 'Saving...';
    reviewUrlStatus.className = 'mt-2 text-sm text-slate-600';
    const { error } = await supabase.from('business').update({ google_review_url: value }).eq('id', businessId);
    if (error) {
      reviewUrlStatus.textContent = 'Could not save: ' + error.message;
      reviewUrlStatus.className = 'mt-2 text-sm text-red-600';
      return;
    }
    // The public page is static, so it only picks up the new link after
    // a rebuild. Same best-effort rebuild as other business-info saves.
    const result = await triggerRebuild();
    reviewUrlStatus.textContent = result.ok
      ? 'Saved. Your "Share your experience" page will update shortly.'
      : 'Saved, but the site update trigger failed. It will go live on the next rebuild.';
    reviewUrlStatus.className = result.ok ? 'mt-2 text-sm text-emerald-700' : 'mt-2 text-sm text-amber-700';
  });

  // A self-contained, print-ready letter-size page, printed from a hidden
  // same-page iframe rather than window.open(): a popup blocker would make
  // a new window fail silently, and the admin sidebar never ends up on paper.
  document.getElementById('print-sign-button')!.addEventListener('click', () => {
    const css = getComputedStyle(document.documentElement);
    const ink = css.getPropertyValue('--color-brand-ink').trim() || '#1c1917';
    const neutral = css.getPropertyValue('--color-brand-neutral').trim() || '#ffffff';
    const heading = css.getPropertyValue('--font-heading').trim() || 'Georgia, serif';
    const body = css.getPropertyValue('--font-body').trim() || 'system-ui, sans-serif';
    // The practice's own brand fonts (business.google_fonts_url), since
    // the admin shell doesn't load them itself.
    const fontLinks = googleFontsUrl ? `<link rel="stylesheet" href="${escapeHtml(googleFontsUrl)}">` : '';
    document.getElementById('sign-print-frame')?.remove();
    const frame = document.createElement('iframe');
    frame.id = 'sign-print-frame';
    frame.title = 'Waiting-room sign (print)';
    frame.setAttribute('aria-hidden', 'true');
    frame.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;';
    frame.srcdoc = `<!doctype html><html><head><meta charset="utf-8"><title>Waiting-room sign</title>${fontLinks}
      <style>
        @page { size: letter portrait; margin: 0.6in; }
        body { margin: 0; font-family: ${body}; color: ${ink}; }
        .sign { box-sizing: border-box; min-height: 9.6in; border: 2px solid ${ink}22; border-radius: 16px; background: ${neutral};
                padding: 0.9in 0.7in; text-align: center; display: flex; flex-direction: column; justify-content: center;
                -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        h1 { font-family: ${heading}; font-size: 36pt; line-height: 1.15; margin: 0 0 0.3in; }
        p.body { font-size: 17pt; line-height: 1.45; margin: 0 auto; max-width: 5.6in; }
        .qr { width: 2.6in; height: 2.6in; margin: 0.45in auto 0.12in; }
        .qr svg { width: 100%; height: 100%; }
        p.caption { font-size: 14pt; font-weight: 600; margin: 0; }
        p.footer { font-size: 11pt; opacity: 0.75; margin: 0.5in 0 0.05in; }
        p.name { font-size: 12pt; font-weight: 600; margin: 0; }
      </style></head><body>
      <div class="sign">
        <h1>${escapeHtml(SIGN_COPY.heading)}</h1>
        <p class="body">${escapeHtml(SIGN_COPY.body)}</p>
        <div class="qr">${qrSvg}</div>
        <p class="caption">${escapeHtml(SIGN_COPY.qrCaption)}</p>
        <p class="footer">${escapeHtml(SIGN_COPY.footer)}</p>
        <p class="name">${escapeHtml(practiceName)}</p>
      </div>
      </body></html>`;
    frame.addEventListener('load', () => {
      // Give the web font a moment so the heading doesn't print in the fallback.
      setTimeout(() => frame.contentWindow?.print(), 400);
    });
    document.body.appendChild(frame);
  });

  function renderSnapshots() {
    const sorted = [...snapshots].sort((a, b) => b.recorded_on.localeCompare(a.recorded_on));
    const summary = document.getElementById('snapshot-summary')!;
    if (sorted.length === 0) {
      summary.textContent = 'No entries yet. Add your current count to set your starting point.';
    } else {
      const latest = sorted[0];
      const oldest = sorted[sorted.length - 1];
      const gained = latest.review_count - oldest.review_count;
      summary.innerHTML =
        sorted.length > 1
          ? `<span class="font-semibold">${latest.review_count} reviews</span>${latest.average_rating ? `, ${latest.average_rating} stars` : ''}. ${gained >= 0 ? '+' : ''}${gained} since ${formatDate(oldest.recorded_on)}.`
          : `Starting point: <span class="font-semibold">${latest.review_count} reviews</span>${latest.average_rating ? `, ${latest.average_rating} stars` : ''}.`;
    }
    document.getElementById('snapshot-body')!.innerHTML = sorted
      .map((s, i) => {
        const prev = sorted[i + 1];
        const change = prev ? s.review_count - prev.review_count : null;
        return `<tr class="border-b border-slate-100">
          <td class="py-2">${formatDate(s.recorded_on)}</td>
          <td class="py-2 font-semibold">${s.review_count}</td>
          <td class="py-2 ${change && change > 0 ? 'text-emerald-700' : 'text-slate-500'}">${change === null ? '' : `${change > 0 ? '+' : ''}${change}`}</td>
          <td class="py-2">${s.average_rating ?? ''}</td>
          <td class="py-2 text-right"><button type="button" data-snapshot-id="${s.id}" class="delete-snapshot text-xs text-slate-400 hover:text-red-600">Remove</button></td>
        </tr>`;
      })
      .join('');
  }

  snapshotForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    snapshotStatus.textContent = '';
    const data = new FormData(snapshotForm);
    const rating = data.get('average_rating') as string;
    const row = {
      recorded_on: data.get('recorded_on') as string,
      review_count: parseInt(data.get('review_count') as string, 10),
      average_rating: rating ? parseFloat(rating) : null,
    };
    const { data: inserted, error } = await supabase.from('review_snapshots').insert(row).select().single();
    if (error) {
      snapshotStatus.textContent = 'Could not save: ' + error.message;
      return;
    }
    snapshots.push(inserted as Snapshot);
    snapshotForm.reset();
    (document.getElementById('snapshot-date') as HTMLInputElement).value = todayIso();
    renderSnapshots();
  });

  document.getElementById('snapshot-body')!.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('.delete-snapshot');
    if (!button || !window.confirm('Remove this entry?')) return;
    const { error } = await supabase.from('review_snapshots').delete().eq('id', button.dataset.snapshotId!);
    if (error) {
      window.alert('Could not remove: ' + error.message);
      return;
    }
    snapshots = snapshots.filter((s) => s.id !== button.dataset.snapshotId);
    renderSnapshots();
  });

  document.querySelectorAll<HTMLButtonElement>('.copy-button').forEach((button) => {
    button.addEventListener('click', async () => {
      const text = document.getElementById(button.dataset.copyTarget!)!.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Select and copy';
      }
      setTimeout(() => (button.textContent = 'Copy'), 2000);
    });
  });

  async function load() {
    (document.getElementById('snapshot-date') as HTMLInputElement).value = todayIso();
    const [{ data: business }, { data: rows }] = await Promise.all([
      supabase.from('business').select('id, display_name, google_review_url, google_fonts_url').single(),
      supabase.from('review_snapshots').select('*'),
    ]);
    businessId = business?.id ?? null;
    practiceName = business?.display_name ?? '';
    googleFontsUrl = business?.google_fonts_url ?? null;
    reviewUrlInput.value = business?.google_review_url ?? '';
    document.getElementById('sign-practice-name')!.textContent = practiceName;
    document.getElementById('policy-text')!.textContent = reviewPolicyTemplate(practiceName || 'our practice');
    document.getElementById('survey-text')!.textContent = dischargeSurveyTemplate(practiceName || 'Our practice');
    snapshots = (rows ?? []) as Snapshot[];
    renderSnapshots();

    qrSvg = await QRCode.toString(publicUrl, { type: 'svg', margin: 0, errorCorrectionLevel: 'M' });
    document.getElementById('sign-qr')!.innerHTML = qrSvg;
  }

  initAdminAuth(load, { allowedRoles: ['owner', 'agency'] });
</script>
