---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Suggestions | Admin" current="suggestions">
  <!-- Admin redesign phase 3 (2026-10-08): restyled; same review logic. -->
  <p class="i-intro">Edits the practice suggested for agency-managed fields. Approve to apply, or reject with a note they'll see.</p>
  <section class="sg-sec">
    <h2 class="sg-h">Waiting for review<span class="cp-n a-num" id="sg-n"></span></h2>
    <p id="pending-empty" class="t-card t-empty">Nothing waiting. New suggestions show up here.</p>
    <div id="pending-list" class="sg-list"></div>
  </section>
  <section class="t-card sg-done">
    <h2>Reviewed</h2>
    <p id="reviewed-empty" class="i-hint">Nothing reviewed yet.</p>
    <div id="reviewed-list" class="sg-rev"></div>
  </section>
</AdminLayout>

<script>
  import { supabase, initAdminAuth, type AdminUser } from '../../lib/adminAuth';
  import { triggerRebuild } from '../../lib/publishFunction';

  type ContentSuggestion = {
    id: string;
    page_id: string;
    field_name: string;
    current_value: string | null;
    suggested_value: string;
    status: 'pending' | 'approved' | 'rejected';
    reviewer_note: string | null;
    reviewed_by: string | null;
    reviewed_at: string | null;
    submitted_by: string | null;
    created_at: string;
  };

  type PageInfo = { id: string; title: string };

  // Labels match admin/content/page-copy.astro's own FIELD_LABELS map
  // exactly — same fields, same names, just the review side instead of
  // the submit side.
  const FIELD_LABELS: Record<string, string> = {
    h1: 'Page heading (H1)',
    meta_description: 'Meta description',
    focus_keyword: 'Focus keyword',
    hero_subhead: 'Hero subheading',
    hero_headline: 'Headline (H1)',
    copy: 'Page copy',
    storybrand_problem: 'The Problem',
    storybrand_guide_empathy: 'We Understand',
    storybrand_pitch: 'The Full Picture',
    storybrand_pitch_label: '"The Full Picture" link text',
    storybrand_success: "What's Possible",
    storybrand_failure: "Why It's Worth Acting Now",
    images: 'Hero image',
  };

  // The pages column each field maps to — 'images' is intentionally
  // absent: a suggestion for it is a free-text description (see
  // admin/content/page-copy.astro's SuggestEdit usage), not a structured
  // {url, alt} value, so there's nothing to write directly. Approving an
  // image suggestion is informational only; the actual photo still gets
  // swapped via Website content. The 5 storybrand_* fields (plus the
  // label) only exist on Homepage/Service Page/Counselor Profile, but
  // that's fine here — a suggestion for one only ever gets created from
  // a page that actually has the field, and applying it is just a plain
  // column write like any other, tier-permission bypass included (see
  // the approve-button handler below: 'agency' is exempt from
  // enforce_content_permission entirely, so this write always succeeds).
  const FIELD_COLUMNS: Record<string, string> = {
    h1: 'h1',
    meta_description: 'meta_description',
    focus_keyword: 'focus_keyword',
    hero_subhead: 'hero_subhead',
    hero_headline: 'hero_headline',
    copy: 'copy',
    storybrand_problem: 'storybrand_problem',
    storybrand_guide_empathy: 'storybrand_guide_empathy',
    storybrand_pitch: 'storybrand_pitch',
    storybrand_pitch_label: 'storybrand_pitch_label',
    storybrand_success: 'storybrand_success',
    storybrand_failure: 'storybrand_failure',
  };

  const pendingList = document.getElementById('pending-list')!;
  const pendingEmpty = document.getElementById('pending-empty')!;
  const reviewedList = document.getElementById('reviewed-list')!;
  const reviewedEmpty = document.getElementById('reviewed-empty')!;

  let currentAdminUser: AdminUser | null = null;
  let pagesById = new Map<string, PageInfo>();

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function pageTitle(pageId: string): string {
    return pagesById.get(pageId)?.title ?? 'Page';
  }

  function renderPending(suggestions: ContentSuggestion[]) {
    pendingEmpty.hidden = suggestions.length > 0;
    document.getElementById('sg-n')!.textContent = suggestions.length ? String(suggestions.length) : '';
    pendingList.innerHTML = suggestions
      .map((s) => {
        const fieldLabel = FIELD_LABELS[s.field_name] ?? s.field_name;
        const canAutoApply = s.field_name in FIELD_COLUMNS;
        const date = new Date(s.created_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
        return `
      <article class="t-card sg-card" data-suggestion-id="${s.id}">
        <div class="sg-top"><b>${escapeHtml(pageTitle(s.page_id))}</b><span class="sg-field">${escapeHtml(fieldLabel)}</span><span class="sg-date">Sent ${date}</span></div>
        <div class="sg-diff">
          <div><span>Now</span><p class="sg-was">${escapeHtml(s.current_value ?? '(not set)')}</p></div>
          <div><span>Suggested${canAutoApply ? ' (you can edit before applying)' : ''}</span>${
            canAutoApply
              ? `<textarea class="apply-value-input" rows="3">${escapeHtml(s.suggested_value)}</textarea>`
              : `<p class="sg-new">${escapeHtml(s.suggested_value)}</p>`
          }</div>
        </div>
        ${!canAutoApply ? '<p class="i-hint">Image suggestions aren\'t applied automatically. Update the photo in Website pages, then approve this to close it out.</p>' : ''}
        <label class="sg-note">Note for the practice (required to reject)<textarea class="review-note-input" rows="2"></textarea></label>
        <div class="i-inline">
          <button type="button" class="approve-button a-btn a-btn-primary i-btn">Approve${canAutoApply ? ' and apply' : ''}</button>
          <button type="button" class="reject-button a-btn i-btn">Reject</button>
          <span class="review-status i-hint"></span>
        </div>
      </article>`;
      })
      .join('');
  }

  function renderReviewed(suggestions: ContentSuggestion[]) {
    reviewedEmpty.hidden = suggestions.length > 0;
    reviewedList.innerHTML = suggestions
      .map((s) => {
        const fieldLabel = FIELD_LABELS[s.field_name] ?? s.field_name;
        const pill = s.status === 'approved' ? '<span class="bp-pill bp-pill-p">Approved</span>' : '<span class="bp-pill sg-rej">Rejected</span>';
        const date = s.reviewed_at ? new Date(s.reviewed_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) : '';
        return `
      <div class="sg-row">
        <div><b>${escapeHtml(pageTitle(s.page_id))} · ${escapeHtml(fieldLabel)}</b><small>"${escapeHtml(s.suggested_value)}"</small>${s.reviewer_note ? `<small class="sg-rn">Note: ${escapeHtml(s.reviewer_note)}</small>` : ''}</div>
        ${pill}
        <span class="sg-date">${date}</span>
      </div>`;
      })
      .join('');
  }

  async function loadSuggestions() {
    const { data, error } = await supabase.from('content_suggestions').select('*').order('created_at', { ascending: false });
    if (error) {
      pendingList.innerHTML = `<p class="i-hint r-err">Could not load suggestions: ${escapeHtml(error.message)}</p>`;
      return;
    }
    const suggestions = (data ?? []) as ContentSuggestion[];

    const pageIds = [...new Set(suggestions.map((s) => s.page_id))];
    if (pageIds.length > 0) {
      const { data: pagesData } = await supabase.from('pages').select('id, title').in('id', pageIds);
      pagesById = new Map((pagesData ?? []).map((p) => [p.id, p as PageInfo]));
    }

    renderPending(suggestions.filter((s) => s.status === 'pending'));
    renderReviewed(suggestions.filter((s) => s.status !== 'pending'));
  }

  pendingList.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const card = target.closest<HTMLElement>('[data-suggestion-id]');
    if (!card) return;
    const suggestionId = card.dataset.suggestionId!;
    const noteInput = card.querySelector('.review-note-input') as HTMLTextAreaElement;
    const statusEl = card.querySelector('.review-status') as HTMLElement;
    const applyInput = card.querySelector('.apply-value-input') as HTMLTextAreaElement | null;

    if (target.classList.contains('approve-button')) {
      statusEl.textContent = 'Applying...';
      statusEl.className = 'review-status i-hint';

      // Look up the suggestion's own field_name/page_id fresh, rather than
      // re-deriving it from the DOM — the card's data attribute only
      // carries the id.
      const { data: suggestion } = await supabase
        .from('content_suggestions')
        .select('page_id, field_name')
        .eq('id', suggestionId)
        .single();
      if (!suggestion) {
        statusEl.textContent = 'Could not find this suggestion.';
        statusEl.className = 'review-status i-hint r-err';
        return;
      }

      const column = FIELD_COLUMNS[suggestion.field_name];
      if (column && applyInput) {
        const { error: pageError } = await supabase
          .from('pages')
          .update({ [column]: applyInput.value.trim() || null })
          .eq('id', suggestion.page_id);
        if (pageError) {
          statusEl.textContent = 'Could not apply: ' + pageError.message;
          statusEl.className = 'review-status i-hint r-err';
          return;
        }
      }

      const { error } = await supabase
        .from('content_suggestions')
        .update({
          status: 'approved',
          reviewer_note: noteInput.value.trim() || null,
          reviewed_by: currentAdminUser?.id,
          reviewed_at: new Date().toISOString(),
        })
        .eq('id', suggestionId);
      if (error) {
        statusEl.textContent = 'Could not save review: ' + error.message;
        statusEl.className = 'review-status i-hint r-err';
        return;
      }

      if (column) {
        statusEl.textContent = 'Applied — updating your site...';
        const result = await triggerRebuild();
        if (!result.ok) {
          statusEl.textContent = 'Applied, but the update trigger failed — it will go live on the next rebuild.';
        }
      }
      await loadSuggestions();
      return;
    }

    if (target.classList.contains('reject-button')) {
      if (!noteInput.value.trim()) {
        statusEl.textContent = 'A note is required when rejecting.';
        statusEl.className = 'review-status i-hint r-err';
        return;
      }
      statusEl.textContent = 'Saving...';
      statusEl.className = 'review-status i-hint';
      const { error } = await supabase
        .from('content_suggestions')
        .update({
          status: 'rejected',
          reviewer_note: noteInput.value.trim(),
          reviewed_by: currentAdminUser?.id,
          reviewed_at: new Date().toISOString(),
        })
        .eq('id', suggestionId);
      if (error) {
        statusEl.textContent = 'Could not save review: ' + error.message;
        statusEl.className = 'review-status i-hint r-err';
        return;
      }
      await loadSuggestions();
    }
  });

  async function onAuthed(adminUser: AdminUser) {
    currentAdminUser = adminUser;
    await loadSuggestions();
  }

  initAdminAuth(onAuthed, { allowedRoles: ['agency'] });
</script>
