---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { MODALITY_OPTIONS } from '../../lib/modalities';
---

<AdminLayout title="Counselor settings | Admin" current="counselor-settings">
  <div class="max-w-lg space-y-6">
    <section>
      <p class="mb-4 text-sm text-slate-600">
        Shown on your counselor page — your availability pill, telehealth badge, license number, and
        training/modalities tags. Update any of these any time.
      </p>

      <div id="picker-wrap" class="hidden mb-4">
        <label class="mb-1 block text-sm font-semibold text-slate-700">Counselor</label>
        <select id="counselor-page-select" class="w-full rounded-md border border-slate-300 px-4 py-2"></select>
        <p class="mt-1 text-xs text-slate-500">Owner/agency view — pick which counselor's settings to edit.</p>
      </div>

      <div id="not-linked-notice" class="hidden rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        Your login isn't linked to a counselor page yet — ask the site owner to link one from the Team page.
      </div>

      <div id="settings-form" class="hidden space-y-6">
        <p id="settings-page-name" class="font-semibold text-brand-ink"></p>

        <div class="space-y-2">
          <label class="mb-1 block text-sm font-semibold text-slate-700">Availability</label>
          <label class="flex items-center gap-2 rounded-md border border-slate-200 px-4 py-2.5">
            <input type="radio" name="availability-status" value="accepting" class="availability-radio" />
            <span class="text-sm font-medium">Accepting New Clients</span>
          </label>
          <label class="flex items-center gap-2 rounded-md border border-slate-200 px-4 py-2.5">
            <input type="radio" name="availability-status" value="almost_full" class="availability-radio" />
            <span class="text-sm font-medium">Almost Full</span>
          </label>
          <label class="flex items-center gap-2 rounded-md border border-slate-200 px-4 py-2.5">
            <input type="radio" name="availability-status" value="not_accepting" class="availability-radio" />
            <span class="text-sm font-medium">Not Accepting New Clients</span>
          </label>
        </div>

        <label class="flex items-center gap-2 rounded-md border border-slate-200 px-4 py-2.5">
          <input type="checkbox" id="telehealth-checkbox" />
          <span class="text-sm font-medium">Telehealth available</span>
        </label>

        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">License number</label>
          <input
            id="license-input"
            type="text"
            placeholder="e.g. LPCA 12345"
            class="w-full rounded-md border border-slate-300 px-4 py-2"
          />
          <p class="mt-1 text-xs text-slate-500">Optional — shown next to your credentials on your page. Leave blank to hide it.</p>
        </div>

        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Professional title</label>
          <input
            id="professional-title-input"
            type="text"
            placeholder="e.g. Licensed Professional Counselor Associate"
            class="w-full rounded-md border border-slate-300 px-4 py-2"
          />
          <p class="mt-1 text-xs text-slate-500">Optional — the spelled-out form of your credentials, shown near your name. Leave blank to hide it.</p>
        </div>

        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Education</label>
          <input
            id="education-input"
            type="text"
            placeholder="e.g. M.A. Clinical Mental Health Counseling, Colorado Christian University"
            class="w-full rounded-md border border-slate-300 px-4 py-2"
          />
          <p class="mt-1 text-xs text-slate-500">Optional — your degree and school, shown near your credentials. Leave blank to hide it.</p>
        </div>

        <div>
          <label class="mb-1 block text-sm font-semibold text-slate-700">Training &amp; modalities</label>
          <input
            id="modality-search"
            type="text"
            placeholder="Search modalities..."
            class="mb-2 w-full rounded-md border border-slate-300 px-4 py-2 text-sm"
          />
          <div id="modality-options" class="grid max-h-64 grid-cols-1 gap-0.5 overflow-y-auto rounded-md border border-slate-200 p-2 sm:grid-cols-2">
            {MODALITY_OPTIONS.map((option) => (
              <label class="modality-option flex items-center gap-2 rounded px-2 py-1.5 text-sm hover:bg-slate-50" data-modality={option.toLowerCase()}>
                <input type="checkbox" class="modality-checkbox" value={option} />
                <span>{option}</span>
              </label>
            ))}
          </div>
          <p id="modality-no-results" class="hidden px-1 py-2 text-xs text-slate-500">No modalities match your search.</p>

          <div class="mt-3">
            <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-slate-500">Not listed? Add your own</p>
            <div id="custom-modality-chips" class="mb-2 flex flex-wrap gap-2 empty:mb-0"></div>
            <div class="flex gap-2">
              <input
                id="custom-modality-input"
                type="text"
                placeholder="Type a modality and press Add"
                class="flex-1 rounded-md border border-slate-300 px-4 py-2 text-sm"
              />
              <button
                type="button"
                id="add-custom-modality-button"
                class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
              >
                Add
              </button>
            </div>
          </div>
        </div>

        <button
          id="settings-save-button"
          type="button"
          class="rounded-md bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
        >
          Save
        </button>
        <p id="settings-status-msg" class="text-sm" role="status"></p>

        <!--
          Caseload lives in its own table (counselor_caseload), not on
          `pages`, so it has its own Save: it's private, never on the
          public site, and saving it needs no site rebuild. See
          0066_caseload_tracking.sql.
        -->
        <div class="space-y-4 border-t border-slate-200 pt-6">
          <div>
            <p class="font-semibold text-brand-ink">Caseload</p>
            <p class="mt-1 text-xs text-slate-500">Private. Never shown on your website. Feeds the practice's Caseload dashboard.</p>
          </div>

          <div>
            <label for="weekly-target-input" class="mb-1 block text-sm font-semibold text-slate-700">Clients you want to see per week</label>
            <input
              id="weekly-target-input"
              type="number"
              min="1"
              max="60"
              inputmode="numeric"
              placeholder="e.g. 20"
              class="w-32 rounded-md border border-slate-300 px-4 py-2"
            />
            <p id="weekly-target-guidance" class="mt-1 text-xs text-slate-500"></p>
          </div>

          <div id="target-caseload-box" class="hidden rounded-md border border-slate-200 bg-white px-4 py-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Your full caseload</p>
            <p class="mt-0.5 text-sm text-slate-700">
              <span id="target-caseload-value" class="font-[family-name:var(--font-heading)] text-2xl font-extrabold text-brand-ink"></span>
              clients
            </p>
            <p id="target-caseload-explainer" class="mt-1 text-xs text-slate-500"></p>
          </div>

          <div>
            <label for="current-clients-input" class="mb-1 block text-sm font-semibold text-slate-700">Current active clients</label>
            <input
              id="current-clients-input"
              type="number"
              min="0"
              max="200"
              inputmode="numeric"
              placeholder="e.g. 14"
              class="w-32 rounded-md border border-slate-300 px-4 py-2"
            />
            <p class="mt-1 text-xs text-slate-500">Everyone you're currently seeing, however often. Update it whenever it changes.</p>
          </div>

          <div id="caseload-meter" class="hidden">
            <div class="mb-1 flex items-baseline justify-between text-sm">
              <span id="caseload-meter-label" class="font-semibold text-brand-ink"></span>
              <span id="caseload-meter-open" class="text-slate-600"></span>
            </div>
            <div class="h-3 rounded-full bg-slate-100">
              <div id="caseload-meter-bar" class="h-3 rounded-full" style="width: 0%"></div>
            </div>
            <p id="caseload-availability-hint" class="mt-2 hidden rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800"></p>
          </div>

          <button
            id="caseload-save-button"
            type="button"
            class="rounded-md bg-brand-primary px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
          >
            Save caseload
          </button>
          <p id="caseload-status-msg" class="text-sm" role="status"></p>
        </div>
      </div>
    </section>
  </div>
</AdminLayout>

<script>
  import { supabase, initAdminAuth, type AdminUser } from '../../lib/adminAuth';
  import { triggerRebuild } from '../../lib/publishFunction';
  import { MODALITY_OPTIONS } from '../../lib/modalities';
  import {
    ALMOST_FULL_THRESHOLD,
    CASELOAD_MULTIPLIER,
    WEEKLY_TARGET_GUIDANCE,
    caseloadBarClass,
    percentFull,
    targetCaseload,
    type CounselorCaseload,
  } from '../../lib/caseload';

  type CounselorPage = {
    id: string;
    title: string;
    availability_status: 'accepting' | 'almost_full' | 'not_accepting' | null;
    telehealth_available: boolean;
    license_number: string | null;
    professional_title: string | null;
    education: string | null;
    modalities: string[];
  };

  const pickerWrap = document.getElementById('picker-wrap')!;
  const pageSelect = document.getElementById('counselor-page-select') as HTMLSelectElement;
  const notLinkedNotice = document.getElementById('not-linked-notice')!;
  const settingsForm = document.getElementById('settings-form')!;
  const settingsPageName = document.getElementById('settings-page-name')!;
  const telehealthCheckbox = document.getElementById('telehealth-checkbox') as HTMLInputElement;
  const licenseInput = document.getElementById('license-input') as HTMLInputElement;
  const professionalTitleInput = document.getElementById('professional-title-input') as HTMLInputElement;
  const educationInput = document.getElementById('education-input') as HTMLInputElement;
  const modalitySearch = document.getElementById('modality-search') as HTMLInputElement;
  const modalityNoResults = document.getElementById('modality-no-results')!;
  const customModalityChips = document.getElementById('custom-modality-chips')!;
  const customModalityInput = document.getElementById('custom-modality-input') as HTMLInputElement;
  const addCustomModalityButton = document.getElementById('add-custom-modality-button')!;
  const saveButton = document.getElementById('settings-save-button')!;
  const statusMsg = document.getElementById('settings-status-msg')!;
  const radios = document.querySelectorAll<HTMLInputElement>('.availability-radio');
  const modalityCheckboxes = document.querySelectorAll<HTMLInputElement>('.modality-checkbox');
  const modalityOptionLabels = document.querySelectorAll<HTMLLabelElement>('.modality-option');

  const weeklyTargetInput = document.getElementById('weekly-target-input') as HTMLInputElement;
  const currentClientsInput = document.getElementById('current-clients-input') as HTMLInputElement;
  const targetCaseloadBox = document.getElementById('target-caseload-box')!;
  const targetCaseloadValue = document.getElementById('target-caseload-value')!;
  const caseloadMeter = document.getElementById('caseload-meter')!;
  const caseloadMeterLabel = document.getElementById('caseload-meter-label')!;
  const caseloadMeterOpen = document.getElementById('caseload-meter-open')!;
  const caseloadMeterBar = document.getElementById('caseload-meter-bar')!;
  const caseloadAvailabilityHint = document.getElementById('caseload-availability-hint')!;
  const caseloadSaveButton = document.getElementById('caseload-save-button')!;
  const caseloadStatusMsg = document.getElementById('caseload-status-msg')!;

  document.getElementById('weekly-target-guidance')!.textContent = WEEKLY_TARGET_GUIDANCE;
  document.getElementById('target-caseload-explainer')!.textContent =
    `Clients per week x ${CASELOAD_MULTIPLIER}. Your caseload is bigger than your weekly sessions because some clients come every other week or monthly.`;

  const KNOWN_MODALITIES = new Set(MODALITY_OPTIONS.map((m) => m.toLowerCase()));

  // Keyed by counselor page id. Missing key = this counselor hasn't set a
  // caseload yet (no row), which is a normal state, not an error.
  let caseloads = new Map<string, CounselorCaseload>();

  function readIntInput(input: HTMLInputElement): number | null {
    const n = parseInt(input.value, 10);
    return Number.isFinite(n) ? n : null;
  }

  // Recomputed live on every keystroke so the counselor sees their full
  // caseload number the moment they type a weekly target.
  function renderCaseloadPreview() {
    const target = targetCaseload(readIntInput(weeklyTargetInput));
    const current = readIntInput(currentClientsInput);

    targetCaseloadBox.classList.toggle('hidden', target === null);
    if (target !== null) targetCaseloadValue.textContent = String(target);

    if (target === null || current === null) {
      caseloadMeter.classList.add('hidden');
      return;
    }
    caseloadMeter.classList.remove('hidden');
    const open = target - current;
    caseloadMeterLabel.textContent = `${current} of ${target} clients (${Math.round((current / target) * 100)}% full)`;
    caseloadMeterOpen.textContent =
      open > 0 ? `${open} open spot${open === 1 ? '' : 's'}` : open === 0 ? 'Full' : `${-open} over full`;
    caseloadMeterBar.style.width = `${percentFull(current, target)}%`;
    caseloadMeterBar.className = `h-3 rounded-full ${caseloadBarClass(current, target)}`;

    // Only a nudge, never an automatic change: the public availability
    // pill stays the counselor's own call.
    const status = document.querySelector<HTMLInputElement>('.availability-radio:checked')?.value;
    const showHint = current / target >= ALMOST_FULL_THRESHOLD && status === 'accepting';
    caseloadAvailabilityHint.classList.toggle('hidden', !showHint);
    if (showHint) {
      caseloadAvailabilityHint.textContent =
        'You\'re close to full, but your page still says "Accepting New Clients." Consider switching to "Almost Full" above.';
    }
  }

  weeklyTargetInput.addEventListener('input', renderCaseloadPreview);
  currentClientsInput.addEventListener('input', renderCaseloadPreview);
  radios.forEach((r) => r.addEventListener('change', renderCaseloadPreview));

  caseloadSaveButton.addEventListener('click', async () => {
    if (!selectedPage) return;
    const weekly = readIntInput(weeklyTargetInput);
    const current = readIntInput(currentClientsInput);
    if (weekly !== null && (weekly < 1 || weekly > 60)) {
      caseloadStatusMsg.textContent = 'Clients per week should be between 1 and 60.';
      caseloadStatusMsg.className = 'text-sm text-red-600';
      return;
    }
    if (current !== null && (current < 0 || current > 200)) {
      caseloadStatusMsg.textContent = 'Current active clients should be between 0 and 200.';
      caseloadStatusMsg.className = 'text-sm text-red-600';
      return;
    }
    caseloadStatusMsg.textContent = 'Saving...';
    caseloadStatusMsg.className = 'text-sm text-slate-600';
    const row = {
      counselor_page_id: selectedPage.id,
      weekly_client_target: weekly,
      current_active_clients: current,
      updated_at: new Date().toISOString(),
    };
    const { error } = await supabase.from('counselor_caseload').upsert(row);
    if (error) {
      caseloadStatusMsg.textContent = 'Could not save: ' + error.message;
      caseloadStatusMsg.className = 'text-sm text-red-600';
      return;
    }
    caseloads.set(selectedPage.id, row);
    caseloadStatusMsg.textContent = 'Caseload saved.';
    caseloadStatusMsg.className = 'text-sm text-emerald-700';
  });

  function loadCaseloadForm() {
    const row = selectedPage ? caseloads.get(selectedPage.id) : undefined;
    weeklyTargetInput.value = row?.weekly_client_target != null ? String(row.weekly_client_target) : '';
    currentClientsInput.value = row?.current_active_clients != null ? String(row.current_active_clients) : '';
    caseloadStatusMsg.textContent = '';
    renderCaseloadPreview();
  }

  async function loadCaseloads(pageIds: string[]) {
    if (pageIds.length === 0) return;
    const { data } = await supabase.from('counselor_caseload').select('*').in('counselor_page_id', pageIds);
    caseloads = new Map(((data ?? []) as CounselorCaseload[]).map((c) => [c.counselor_page_id, c]));
  }

  let counselorPages: CounselorPage[] = [];
  let selectedPage: CounselorPage | null = null;
  // Free-text "Other" entries for the page currently loaded in the form —
  // anything in selectedPage.modalities that doesn't exact-match (case-
  // insensitive) a MODALITY_OPTIONS entry. Kept as separate UI state from
  // the checkboxes so a custom entry survives re-rendering the chip list.
  let customModalities: string[] = [];

  function escapeHtml(value: string): string {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  function renderCustomChips() {
    customModalityChips.innerHTML = customModalities
      .map(
        (m) => `
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-tint/40 px-3 py-1 text-sm font-medium text-brand-ink">
        ${escapeHtml(m)}
        <button type="button" class="remove-custom-modality text-brand-ink/60 hover:text-brand-ink" data-value="${escapeHtml(m)}" aria-label="Remove ${escapeHtml(m)}">&times;</button>
      </span>`
      )
      .join('');
  }

  customModalityChips.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (!target.classList.contains('remove-custom-modality')) return;
    const value = target.dataset.value!;
    customModalities = customModalities.filter((m) => m !== value);
    renderCustomChips();
  });

  function addCustomModality() {
    const value = customModalityInput.value.trim();
    if (!value) return;
    const normalized = value.toLowerCase();
    if (KNOWN_MODALITIES.has(normalized)) {
      // Already in the picker list above — check that box instead of
      // creating a duplicate "custom" entry for the same modality.
      modalityCheckboxes.forEach((cb) => {
        if (cb.value.toLowerCase() === normalized) cb.checked = true;
      });
    } else if (!customModalities.some((m) => m.toLowerCase() === normalized)) {
      customModalities = [...customModalities, value];
      renderCustomChips();
    }
    customModalityInput.value = '';
    customModalityInput.focus();
  }

  addCustomModalityButton.addEventListener('click', addCustomModality);
  customModalityInput.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      addCustomModality();
    }
  });

  modalitySearch.addEventListener('input', () => {
    const query = modalitySearch.value.trim().toLowerCase();
    let visibleCount = 0;
    modalityOptionLabels.forEach((label) => {
      const matches = !query || (label.dataset.modality ?? '').includes(query);
      label.classList.toggle('hidden', !matches);
      if (matches) visibleCount += 1;
    });
    modalityNoResults.classList.toggle('hidden', visibleCount > 0);
  });

  function loadForm() {
    if (!selectedPage) {
      settingsForm.classList.add('hidden');
      return;
    }
    settingsForm.classList.remove('hidden');
    settingsPageName.textContent = selectedPage.title;
    radios.forEach((r) => {
      r.checked = r.value === selectedPage!.availability_status;
    });
    telehealthCheckbox.checked = selectedPage.telehealth_available;
    licenseInput.value = selectedPage.license_number ?? '';
    professionalTitleInput.value = selectedPage.professional_title ?? '';
    educationInput.value = selectedPage.education ?? '';

    const stored = selectedPage.modalities ?? [];
    modalityCheckboxes.forEach((cb) => {
      cb.checked = stored.some((m) => m.toLowerCase() === cb.value.toLowerCase());
    });
    customModalities = stored.filter((m) => !KNOWN_MODALITIES.has(m.toLowerCase()));
    renderCustomChips();
    modalitySearch.value = '';
    modalityOptionLabels.forEach((label) => label.classList.remove('hidden'));
    modalityNoResults.classList.add('hidden');

    statusMsg.textContent = '';
    loadCaseloadForm();
  }

  pageSelect.addEventListener('change', () => {
    selectedPage = counselorPages.find((p) => p.id === pageSelect.value) ?? null;
    loadForm();
  });

  saveButton.addEventListener('click', async () => {
    if (!selectedPage) return;
    const checked = document.querySelector<HTMLInputElement>('.availability-radio:checked');
    const pickedModalities = Array.from(modalityCheckboxes)
      .filter((cb) => cb.checked)
      .map((cb) => cb.value);
    const modalities = [...pickedModalities, ...customModalities];
    statusMsg.textContent = 'Saving...';
    statusMsg.className = 'text-sm text-slate-600';
    const payload = {
      availability_status: checked?.value ?? null,
      telehealth_available: telehealthCheckbox.checked,
      license_number: licenseInput.value.trim() || null,
      professional_title: professionalTitleInput.value.trim() || null,
      education: educationInput.value.trim() || null,
      modalities,
    };
    const { error } = await supabase.from('pages').update(payload).eq('id', selectedPage.id);
    if (error) {
      statusMsg.textContent = 'Could not save: ' + error.message;
      statusMsg.className = 'text-sm text-red-600';
      return;
    }
    Object.assign(selectedPage, payload);
    statusMsg.textContent = 'Saving your site...';
    const result = await triggerRebuild();
    statusMsg.textContent = result.ok
      ? 'Saved! Your site will update shortly.'
      : 'Saved, but the update trigger failed — it will go live on the next rebuild.';
    statusMsg.className = result.ok ? 'text-sm text-emerald-700' : 'text-sm text-amber-700';
  });

  async function onAuthed(adminUser: AdminUser) {
    if (adminUser.role === 'owner' || adminUser.role === 'agency') {
      const { data } = await supabase
        .from('pages')
        .select('id, title, availability_status, telehealth_available, license_number, professional_title, education, modalities')
        .eq('page_type', 'Counselor Profile')
        .order('title');
      counselorPages = (data ?? []) as CounselorPage[];
      pickerWrap.classList.remove('hidden');
      pageSelect.innerHTML = counselorPages.map((p) => `<option value="${p.id}">${escapeHtml(p.title)}</option>`).join('');
      selectedPage = counselorPages[0] ?? null;
      await loadCaseloads(counselorPages.map((p) => p.id));
      loadForm();
      return;
    }

    // staff: only their own linked page, no picker, and RLS backs this up
    // regardless — see the "linked counselor can update own page" policy.
    if (!adminUser.linked_counselor_page_id) {
      notLinkedNotice.classList.remove('hidden');
      return;
    }
    const { data } = await supabase
      .from('pages')
      .select('id, title, availability_status, telehealth_available, license_number, professional_title, education, modalities')
      .eq('id', adminUser.linked_counselor_page_id)
      .maybeSingle();
    if (!data) {
      notLinkedNotice.classList.remove('hidden');
      return;
    }
    counselorPages = [data as CounselorPage];
    selectedPage = counselorPages[0];
    await loadCaseloads([selectedPage.id]);
    loadForm();
  }

  initAdminAuth(onAuthed, { allowedRoles: ['owner', 'agency', 'staff'] });
</script>
