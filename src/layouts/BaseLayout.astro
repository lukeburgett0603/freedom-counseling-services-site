---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCTABar from '../components/MobileCTABar.astro';
import PageHead from '../components/PageHead.astro';
import AdAttributionCapture from '../components/AdAttributionCapture.astro';
import { STATIC_EXPORT } from '../lib/exportMode';
import type { Page, Business } from '../lib/pages';
import '../styles/global.css';

interface Props {
  page: Page;
  allPages: Page[];
  business: Business;
}

const { page, allPages, business } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <PageHead page={page} allPages={allPages} business={business} />
  </head>
  <body class="pb-14 md:pb-0">
    <Header
      navPages={allPages}
      businessName={business.display_name}
      telephone={business.telephone}
      logoUrl={business.logo_in_header ? business.logo_url : null}
    />
    <main>
      <slot />
    </main>
    <Footer navPages={allPages} business={business} />
    <MobileCTABar telephone={business.telephone} ctaText={page.cta_button_text ?? undefined} />
    {!STATIC_EXPORT && <AdAttributionCapture />}
  </body>
</html>
